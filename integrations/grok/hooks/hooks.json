{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "start"],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "working"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "tool-start"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "tool-end"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "tool-end"],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "blocked"],
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "blocked"],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "done"],
            "timeout": 5
          }
        ]
      }
    ],
    "StopCancelled": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "done"],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${GROK_PLUGIN_ROOT}/scripts/phux-hook.sh", "clear"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
