{
  "name": "@phux/chief",
  "version": "0.1.0",
  "private": true,
  "description": "The phux chief of staff: one durable Pi agent per mesh that drives phux panes on your behalf",
  "type": "module",
  "license": "Apache-2.0",
  "bin": { "phux-chief": "./dist/src/main.js" },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:test": "npm run clean && tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gates": "npm run typecheck && npm test && npm run build && node ../../scripts/npm-audit-gate.mjs --audit-level=high --omit=dev"
  },
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@phux/integration-runtime": "file:../runtime",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "engines": { "node": ">=24" }
}
