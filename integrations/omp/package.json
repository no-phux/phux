{
  "name": "@phux/omp",
  "version": "0.1.0",
  "private": true,
  "description": "Native Oh My Pi extension for CLI-backed persistent terminal control",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/no-phux/phux.git",
    "directory": "integrations/omp"
  },
  "files": ["dist", "skills"],
  "exports": {".": "./dist/index.js"},
  "omp": {"extensions": ["./dist/index.js"]},
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test",
    "smoke:load": "bun scripts/smoke-load.ts",
    "smoke:lifecycle": "bun scripts/smoke-lifecycle.ts",
    "prepack": "bun run build",
    "gates": "bun run typecheck && bun run test && bun run build && bun run smoke:load"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.8.6",
    "@oh-my-pi/pi-ai": "18.8.6",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  },
  "engines": {"bun": ">=1.3.14"}
}
