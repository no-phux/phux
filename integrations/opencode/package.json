{
  "name": "@phux/opencode",
  "version": "0.2.0",
  "description": "OpenCode V2 tools and fleet context for shared phux terminals",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/no-phux/phux.git",
    "directory": "integrations/opencode"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsup src/index.ts --format esm --platform node --dts --external @opencode-ai/plugin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "gates": "npm run typecheck && npm run build && npm test && npm run pack:check && npm audit --audit-level=high",
    "smoke:opencode": "node scripts/smoke-opencode.mjs",
    "smoke:real": "node scripts/smoke-real.mjs",
    "pack:check": "node scripts/test-pack.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-next-17430"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "tsup": "8.5.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
