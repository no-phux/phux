{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "typeRoots": ["./opencode/node_modules/@types"],
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false
  },
  "include": ["opencode/src/**/*.ts", "runtime/src/**/*.ts"]
}
