{
  "name": "@phux/opencode-v2",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode V2 plugin: phux owns the terminals, OpenCode owns the session",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/no-phux/phux.git",
    "directory": "integrations/opencode-v2"
  },
  "files": [
    "index.d.ts",
    "index.js",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outfile index.js --target bun --format esm --external @opencode/plugin",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "gates": "bun run typecheck && bun run build && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.18"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
