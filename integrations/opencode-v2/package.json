{
  "name": "@phux/opencode",
  "version": "0.8.0",
  "description": "phux integration for OpenCode: terminal tools, agent status, and live panes in OpenCode Desktop.",
  "homepage": "https://docs.phux.sh/",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/no-phux/phux.git",
    "directory": "integrations/opencode-v2"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "phux",
    "terminal"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "tui.js",
    "dist/gui-experimental.cjs",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./tui": "./tui.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "scripts": {
    "compile": "bun scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.gui.json --noEmit",
    "test": "bun test",
    "gates": "bun run typecheck && bun run compile && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "devDependencies": {
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/bun": "1.4.4",
    "effect": "4.1.1",
    "solid-js": "1.9.18",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15"
  },
  "peerDependencies": {
    "solid-js": "1.9.18",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1"
  },
  "overrides": {
    "effect": "4.1.1",
    "seroval": "1.7.6",
    "seroval-plugins": "1.7.6"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
