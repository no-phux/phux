{
  "name": "@phux/opencode",
  "version": "0.6.0",
  "description": "OpenCode V2 plugin: phux owns the terminals, OpenCode owns the session",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/no-phux/phux.git",
    "directory": "integrations/opencode-v2"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "phux",
    "terminal"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "tui.js",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./tui": "./tui.js"
  },
  "scripts": {
    "compile": "bun scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "gates": "bun run typecheck && bun run compile && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.32"
  },
  "devDependencies": {
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "1.4.2",
    "solid-js": "1.9.12",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "solid-js": "1.9.12",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
