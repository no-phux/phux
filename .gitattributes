# Generated, tool-written, or vendored files. Also exempts them from the
# pre-commit file-size gate (scripts/check-file-tokens.sh).
.beads/*.jsonl linguist-generated=true
CHANGELOG.md linguist-generated=true
docs/spec/CHANGELOG.md -linguist-generated
docs/reference/cli.md linguist-generated=true
docs/reference/config.md linguist-generated=true
docs/assets/*.cast linguist-generated=true
integrations/runtime/dist/** linguist-generated=true
integrations/opencode-v2/index.js linguist-generated=true
integrations/opencode-v2/tui.js linguist-generated=true
crates/phux-record/assets/*.bdf linguist-vendored=true
docs/spec/wire-schema.json linguist-generated=true

# Canonical producer-owned runtime catalog, checked against brand.lock.json.
clients/desktop/packaging/brand-profiles.json linguist-generated=true text eol=lf

# GPUI patch digests authenticate the exact LF bytes on Windows too.
clients/desktop/toolchain/patches/*.patch text eol=lf
