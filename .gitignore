target/
# Alternate cargo target dirs (e.g. `cargo doc --target-dir target-doc`), kept
# out of `target/` to avoid clobbering a build. Same regenerable artifacts,
# same reason to ignore them -- one had grown to 1.3G untracked.
target-*/
# Packaging output (pack-release.sh, desktop-package).
dist/
# The OpenCode plugin's desktop bundle ships checked in, like its index.js.
!integrations/opencode-v2/dist/
# Local checkout of the no-phux/skills publish mirror.
.skills-mirror/
result
result-*
.direnv/
.envrc.local
*.swp
.DS_Store
perf.data*
flamegraph.svg

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
# Local gate lock. `bd gate` creates it and does not always release it: one
# was found empty and orphaned 11 days after the run that made it, with no
# gates open. Machine-local either way, never shared.
.beads.gate.lock
# Local import-cache stamp (source size + mtime), never meant to be tracked.
.beads/.auto-import-issues.jsonl

# bv (beads viewer) local config and caches
.bv/
.claude/worktrees/
# Regenerable Pi Fabric session state, never product inputs or shared config.
/.pi/fabric/

# dhat heap profiler output (emitted when built with --features dhat-heap)
dhat-heap.json
**/dhat-heap.json

# `just scaffold-config` writes a throwaway config here for local testing.
.phux-xdg/

# Generated local analysis; never a source of truth.
graphify-out/

# Gastown city runtime and packs. Maintainer-local, not product source.
.gc/
.ghui/

# Generated by Amp when it exposes orb services through portals.
.amp/portals/

# Python bytecode
__pycache__/
*.pyc

# Plugin-local archives and integration records are user data, not source.
/plugins/*/state/
/examples/plugins/*/state/
