# GUARD ts-shipping-geometry-cache
# Rebuilding compiled chrome on every GPU frame adds layout allocations to idle painting.
test: shipping unchanged GPU frames reuse compiled terminal geometry
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/native_extension.zig b/src/native_extension.zig
--- a/src/native_extension.zig
+++ b/src/native_extension.zig
@@ -571 +571 @@
-    if (workspace.shipping_terminal_space != null and std.meta.eql(workspace.shipping_terminal_size, size)) return;
+    if (workspace.shipping_terminal_space != null and std.meta.eql(workspace.shipping_terminal_size, size) and false) return;
