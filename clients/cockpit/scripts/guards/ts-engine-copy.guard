# GUARD ts-engine-copy
#
# Describe the defect this test exists to catch, and what removing the
# fix below puts back. Prose here is preserved across re-runs.
test: select all and cmd+C put the scrollback on the clipboard through the seam
red: 2026-09-07 at 2f8fa21
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
index f47d8461..a24e12ed 100644
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -915,7 +915,7 @@ pub const Engine = struct {
     }
 
     fn terminalShortcut(event: canvas.WidgetKeyboardEvent) ?protocol.NativeCommand {
-        if (keyIs(event.key, "c")) return .copy;
+        if (keyIs(event.key, "c")) return null;
         if (keyIs(event.key, "v")) return .paste;
         if (event.modifiers.alt or event.modifiers.control) return null;
         if (keyIs(event.key, "g")) return if (event.modifiers.shift) .find_previous else .find_next;
