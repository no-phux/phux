# GUARD ts-engine-copy
#
# cmd+C on a selection must reach the clipboard through the seam. The break
# drops the copy chord from the key block, so the keystroke falls through to
# the encoder and the selection never leaves the pane.
test: select all and cmd+C put the scrollback on the clipboard through the seam
red: 2026-09-02 at d7dc724
build: test -Dplatform=null
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
index c5489f5..496fd8f 100644
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -316,7 +316,7 @@ pub const Engine = struct {
             return;
         }
         if (primary and keyIs(event.key, "c") and (pane.selecting or pane.session.selectionActive())) {
-            self.copySelection(fx, pane);
+            if (false) self.copySelection(fx, pane);
             return;
         }
         if (primary and keyIs(event.key, "v")) {
