# GUARD ts-pending-grid
#
# Bypassing Model.remotePresentation reveals a provider grid before attachment
# identity is accepted. The break restores that bypass in the extracted painter.
test: pending attachment hides the published grid of a reused remote identity
red: 2026-09-07 at 1a61643
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/native/terminal_painter.zig b/src/cockpit/native/terminal_painter.zig
index 7234e5c5..5d3c16db 100644
--- a/src/cockpit/native/terminal_painter.zig
+++ b/src/cockpit/native/terminal_painter.zig
@@ -288,7 +288,7 @@ fn paintPane(model: *const Model, builder: *canvas.Builder, pane: layout.Pane, i
     } else {
         const remote = model.phuxConst() orelse return false;
         @import("remote_color_policy.zig").sync(remote, options.tokens, model.config.cursor_color);
-        const presentation = model.remotePresentation(pane.terminal) orelse return false;
+        const presentation = remote.presentation(pane.terminal) orelse return false;
         options.running = presentation.phase == .live;
         options.selecting = if (model.remoteUiConst(pane.terminal)) |state| state.selecting else false;
         try grid.paintTerminalGrid(presentation.grid, builder, options);
