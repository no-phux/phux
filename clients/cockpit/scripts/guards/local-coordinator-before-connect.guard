# GUARD local-coordinator-before-connect
#
# Previously the Unix worker connected immediately: a first launch without a
# local coordinator failed instead of starting Phux. Removing the ensure call
# restores that order. The test's explicit helper blocks before exit while its
# disposable selected socket is absent; the worker must neither connect nor
# post a disconnect until the helper succeeds. No real coordinator is launched.
test: Unix worker ensures selected coordinator before attempting its socket
red: 2026-09-07 at 7b6fa6b
build: test -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/providers/phux/extension.zig b/src/providers/phux/extension.zig
index 6e229905..1b4224ec 100644
--- a/src/providers/phux/extension.zig
+++ b/src/providers/phux/extension.zig
@@ -127,10 +127,6 @@ pub const Worker = struct {
     }
 
     fn run(worker: *Worker) void {
-        worker.ensureCoordinator() catch {
-            worker.disconnected(.socket_lost);
-            return;
-        };
         const fd = connect(worker) catch {
             worker.disconnected(.socket_lost);
             return;
