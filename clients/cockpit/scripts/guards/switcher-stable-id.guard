# GUARD switcher-stable-id
#
# Retained native switcher guard: rebuilding the catalog must not redirect
# Enter to the new occupant of the highlighted row. Shipping TS navigation
# has separate ts-navigation-* guards.
test: keyboard session activation keeps the highlighted id across catalog rebuilds
red: 2026-09-02 at 67e1439
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/update.zig b/src/cockpit/update.zig
index 47e3ba4..f488637 100644
--- a/src/cockpit/update.zig
+++ b/src/cockpit/update.zig
@@ -1913,7 +1913,7 @@ fn handleKey(model: *Model, fx: *Fx, event: canvas.WidgetKeyboardEvent) void {
             // The identity was fenced when this row became highlighted. A
             // provider catalog rebuild between paint and Enter must not make
             // this cursor select whatever moved into the old numeric slot.
-            const destination = model.ws().palette.highlighted orelse {
+            const destination = projection.paletteEntryAtCursorIn(model, model.ws()) orelse {
                 updateModel(model, .palette_close, fx);
                 return;
             };
