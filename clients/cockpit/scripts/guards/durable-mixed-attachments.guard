# GUARD durable-mixed-attachments
#
# v4 discarded an entire tab whenever any leaf was remote, losing local
# siblings and the arranged remote placements. This break reinstates that
# whole-tab filter in the refactored window encoder. The mixed round-trip
# test must retain both tabs, their full remote references, and one local shell.
test: v5 mixed attachments round trip without allocating remote shells
red: 2026-09-07 at 959a273
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/model.zig b/src/cockpit/model.zig
index abc9558c..784c90a4 100644
--- a/src/cockpit/model.zig
+++ b/src/cockpit/model.zig
@@ -1637,7 +1637,12 @@ pub fn applyRestoredWorkingDirectories(model: *Model, snapshot: *const TopologyS
 fn encodeWindow(model: *const Model, workspace: *const Workspace, snapshot: *TopologySnapshot, written: *u8) !topology.SnapshotWindow {
     var selected: ?u8 = null;
     const first = written.*;
-    for (workspace.tabs[0..workspace.tab_count], 0..) |current, index| {
+    tabs: for (workspace.tabs[0..workspace.tab_count], 0..) |current, index| {
+        for (current.nodes) |node| {
+            if (node.terminal) |ref| {
+                if (provider_contract.localId(ref) == null) continue :tabs;
+            }
+        }
         if (written.* >= topology.max_snapshot_tabs) return error.InvalidTopology;
         snapshot.tabs[written.*] = try encodeTab(model, current, &snapshot.references);
         if (!workspace.web_selected and index == workspace.selected_tab) selected = written.* - first;
