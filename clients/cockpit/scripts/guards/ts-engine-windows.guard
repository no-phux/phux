# GUARD ts-engine-windows
#
# A new-window intent must open a second workspace with its own shell and
# a close must retire it whole, or the core declares platform windows the
# engine does not back. The break drops the workspace open so every
# new-window intent is refused as if the window table were full.
test: a new window opens a second workspace with its own shell and closes whole through the seam
red: 2026-09-02 at d7dc724
build: test -Dplatform=null
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
index b2ac6ba..d0bf9a9 100644
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -233,7 +233,7 @@ pub const Engine = struct {
             model.window_limit_refused = true;
             return false;
         };
-        const workspace = model.openWindow(index) orelse {
+        const workspace = model.openWindow(if (true) 99 else index) orelse {
             model.window_limit_refused = true;
             return false;
         };
