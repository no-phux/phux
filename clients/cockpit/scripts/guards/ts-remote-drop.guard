# GUARD ts-remote-drop
#
# Finder drops previously required a local provider pane. Removing the remote
# paste hook restores that rejection despite an attached, ready remote owner.
test: shipping remote file drop quotes paths and refuses unavailable owners
red: 2026-09-07 at 16701fc
build: test -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -1163 +1162,0 @@
-        if (!provider_contract.isLocal(terminal)) return shipping_pointer.pasteDrop(model, terminal, text);
