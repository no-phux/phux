# GUARD ts-remote-wheel
#
# Scrolling the provider replica did not mark its native presentation dirty.
# Removing that publication leaves the displayed row unchanged after a wheel.
test: shipping remote wheel scrolls history and emits bounded mouse reports
red: 2026-09-07 at 4b17d82
build: test -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/providers/phux/host.zig b/src/providers/phux/host.zig
--- a/src/providers/phux/host.zig
+++ b/src/providers/phux/host.zig
@@ -607,3 +607,2 @@
         try resultError(c.phux_client_scroll_viewport(host.client, &id, kind, scroll.value));
-        if (host.findTerminal(owner_value.terminal_ref)) |terminal| terminal.dirty = true;
         try host.capturePublishStage();
