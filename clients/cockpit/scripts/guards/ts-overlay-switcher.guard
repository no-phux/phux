# GUARD ts-overlay-switcher
#
# Catalog filtering now executes in the native read-only page service. Ignoring
# its query restores the original unfiltered-list defect: typing 3 still leaves
# three rows and Enter would activate the first terminal rather than tab 3.
test: the switcher filters the engine's tabs by position or title and selects through the seam
red: 2026-09-07 at 624093d
build: test -Dphux-enabled=true
diff --git a/src/cockpit/native/ts_navigation.zig b/src/cockpit/native/ts_navigation.zig
index 80f69594..c25877a7 100644
--- a/src/cockpit/native/ts_navigation.zig
+++ b/src/cockpit/native/ts_navigation.zig
@@ -123,7 +123,7 @@ pub fn encode(model: *const Model, revision: u64, request: []const u8, out: []u8
     try validateRequest(revision, request);
     const query_len = request[12];
     var workspace: model_module.Workspace = .{};
-    workspace.palette.query_len = query_len;
+    workspace.palette.query_len = 0;
     @memcpy(workspace.palette.query[0..query_len], request[13..]);
     const total = projection.paletteEntryCountIn(model, &workspace);
     if (total > std.math.maxInt(u16)) return error.CatalogTooLarge;
