+++ b/src/core.ts
@@ -913,6 +913,7 @@ export function update(model: Model, msg: Msg): Model | [Model, Cmd<Msg>] {
       const next = {
         ...model,
         engineSequence: event.sequence,
+        engineRevision: event.revision,
         engineConnected: false,
         status: asciiBytes("SYNCING"),
         paletteRows: NO_ROWS,
