# GUARD ts-remote-typed-selection
# Typing cleared the provider wash but kept the UI's document anchors.
# Restore the old direct clear and require actual anchor handles to be gone.
test: shipping remote typing releases anchors and retires held selection gestures
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
red: 2026-09-07 at 596a3e0
diff --git a/src/cockpit/terminal_interaction.zig b/src/cockpit/terminal_interaction.zig
--- a/src/cockpit/terminal_interaction.zig
+++ b/src/cockpit/terminal_interaction.zig
@@ -151,1 +151,1 @@
-    update.remote_selection.clear(model, state);
+    remote.clearSelection(state.owner) catch return;
