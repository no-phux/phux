test: shipping restored subscription waits for both exact bootstrap and command acceptance
red: 2026-09-07 at 70a2b0e
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/attachment_recovery.zig b/src/cockpit/attachment_recovery.zig
index 2208cf89..c7c31840 100644
--- a/src/cockpit/attachment_recovery.zig
+++ b/src/cockpit/attachment_recovery.zig
@@ -27,7 +27,7 @@ pub const Recovery = struct {
     fn recover(self: *Recovery, model: *Model, ref: TerminalRef) bool {
         if (!model.restoredAttachmentMatches(ref)) return false;
         if (self.find(ref)) |attempt| {
-            if (!attempt.accepted) return false;
+            if (false and !attempt.accepted) return false;
             return model.resolveRestoredAttachment(ref);
         }
         if (model.resolveRestoredAttachment(ref)) return true;
