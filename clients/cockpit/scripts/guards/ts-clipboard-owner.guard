# GUARD ts-clipboard-owner
#
# Describe the defect this test exists to catch, and what removing the
# fix below puts back. Prose here is preserved across re-runs.
test: shipping clipboard completion belongs to its requesting replica after focus moves
red: 2026-09-07 at 1fc4b5a
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/terminal_interaction.zig b/src/cockpit/terminal_interaction.zig
index ba259b8d..097f3878 100644
--- a/src/cockpit/terminal_interaction.zig
+++ b/src/cockpit/terminal_interaction.zig
@@ -58,7 +58,7 @@ pub fn copied(model: *Model, ok: bool) void {
     if (!model.copy_inflight) return;
     model.copy_inflight = false;
     if (!model.ownerIsCurrent(model.copy_owner)) return;
-    const ref = model.copy_owner.terminal_ref;
+    const ref = model.focusedTerminalRef() orelse return;
     if (!ok) return copyFailed(model, ref);
     if (model.provider.terminal(ref)) |pane| {
         pane.selecting = false;
