# GUARD ts-remote-empty-gesture
# A null Ghostty drag snapshot kept the old provider highlight. Remove the
# range clear on that result; returning to the origin must leave stale ink.
test: shipping remote drag back to origin clears the range without ending capture
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
red: 2026-09-07 at 88c0864
root: repository
rebuild: cargo build --locked --profile ffi-dev -p phux-client-ffi --target-dir target
diff --git a/crates/phux-client-ffi/src/pointer.rs b/crates/phux-client-ffi/src/pointer.rs
--- a/crates/phux-client-ffi/src/pointer.rs
+++ b/crates/phux-client-ffi/src/pointer.rs
@@ -177,5 +177,4 @@
         let Some(selected) = selected else {
             // The gesture is temporarily removed from the map while applying
             // an event, so this clears the range without ending the gesture.
-            self.clear_selection(id)?;
             return Ok(result);
