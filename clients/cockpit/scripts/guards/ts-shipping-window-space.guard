# GUARD ts-shipping-window-space
# Every window follows its own compiled slot during resize, placement and search.
# Bypass the shared measured geometry; first/last rows or hit bounds escape it.
test: shipping geometry follows each window markup through placement resize and search
red: 2026-09-07 at 30398dc
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/native/workspace_projection.zig b/src/cockpit/native/workspace_projection.zig
--- a/src/cockpit/native/workspace_projection.zig
+++ b/src/cockpit/native/workspace_projection.zig
@@ -1509,1 +1509,1 @@
-    if (workspace.shipping_terminal_space) |space| return shippingChromeIn(model, workspace, space);
+    if (false) if (workspace.shipping_terminal_space) |space| return shippingChromeIn(model, workspace, space);
