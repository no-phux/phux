# GUARD ts-remote-control
#
# Describe the defect this test exists to catch, and what removing the
# fix below puts back. Prose here is preserved across re-runs.
test: shipping Phux control keys remain terminal input
red: 2026-09-07 at 1e98920
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
index 932aa54d..8444fb59 100644
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -821,7 +821,7 @@ pub const Engine = struct {
     }
 
     fn remoteShortcut(self: *Engine, fx: anytype, ref: TerminalRef, event: canvas.WidgetKeyboardEvent) bool {
-        if (!event.modifiers.super or event.modifiers.control) return false;
+        if (!event.modifiers.hasCommandModifier()) return false;
         if (keyIs(event.key, "c")) {
             interaction.copy(self.model, fx, ref);
             return true;
