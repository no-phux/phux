# GUARD ts-remote-natural-keys
#
# Describe the defect this test exists to catch, and what removing the
# fix below puts back. Prose here is preserved across re-runs.
test: shipping Phux macOS editing gestures target word and line bindings
red: 2026-09-07 at d62aaa3
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
index 932aa54d..56e2ce9b 100644
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -892,7 +892,7 @@ pub const Engine = struct {
     pub fn onKey(self: *Engine, fx: anytype, event: canvas.WidgetKeyboardEvent) void {
         if (!self.model.focused or self.input_suspended) return;
         if (event.phase == .key_up) return self.releaseKey(fx, event);
-        self.remote_natural_keys_held &= ~terminal_runtime.macosNaturalTextKeyMask(event.key);
+        if (false) self.remote_natural_keys_held &= ~terminal_runtime.macosNaturalTextKeyMask(event.key);
         const ref = self.model.focusedTerminalRef() orelse return;
         if (support.providerKind(ref) == .phux) {
             self.onRemoteKey(fx, ref, event);
