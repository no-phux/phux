# GUARD ts-navigation-snapshot-budget
#
# Original 128-byte title/CWD allowances overflow the 4096-byte host completion
# with 32 terminals across two windows. Restoring those allowances fails in
# encodeTabs with BufferTooSmall; the complete inventory must remain reachable.
test: navigation snapshots preserve full window inventory within the host payload limit
red: 2026-09-07 at 0d39e66
build: test -Dphux-enabled=true
diff --git a/src/cockpit/native/ts_snapshot.zig b/src/cockpit/native/ts_snapshot.zig
index bbff06af..c4514c0c 100644
--- a/src/cockpit/native/ts_snapshot.zig
+++ b/src/cockpit/native/ts_snapshot.zig
@@ -112,10 +112,10 @@ fn encodeTabs(model: *const Model, workspace: *const model_module.Workspace, out
         const terminal = workspace.tabTerminal(index) orelse continue;
         var title_buffer: [512]u8 = undefined;
         const title = projection.terminalTitleInto(model, terminal, &title_buffer);
-        var title_display: [max_title_bytes]u8 = undefined;
+        var title_display: [128]u8 = undefined;
         const bounded = navigation.displayText(title, &title_display);
         const cwd_all = if (model.provider.terminalConst(terminal)) |pane| pane.pwd() else "";
-        var cwd_display: [max_cwd_bytes]u8 = undefined;
+        var cwd_display: [128]u8 = undefined;
         const cwd = navigation.displayText(cwd_all, &cwd_display);
         const needed = 7 + bounded.len + cwd.len;
         if (written + needed > out.len) return error.BufferTooSmall;
