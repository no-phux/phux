# GUARD ts-secondary-snapshot-primary
#
# The fixed snapshot header is the main-window section even while a secondary
# window owns focus. Selecting wsConst() pairs that secondary tab count with
# runs[0], making unequal main/secondary runs unparsable.
test: a focused secondary snapshot keeps main and secondary projections distinct
build: test -Dtypescript-spike=true -Dplatform=null
red: 2026-09-04 at 78d857e
diff --git a/src/cockpit/native/ts_snapshot.zig b/src/cockpit/native/ts_snapshot.zig
--- a/src/cockpit/native/ts_snapshot.zig
+++ b/src/cockpit/native/ts_snapshot.zig
@@ -54,1 +54,1 @@
-    const workspace = &model.primary;
+    const workspace = model.wsConst();
