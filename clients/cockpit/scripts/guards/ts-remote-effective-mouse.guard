# GUARD ts-remote-effective-mouse
# Independent DEC bits are not Ghostty's exclusive effective mouse state.
# Restore the old bit-priority getter; conflicting sets/resets must misroute.
test: shipping mouse routing follows Ghostty effective mode after conflicting DEC sets
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
red: 2026-09-07 at 88c0864
root: repository
rebuild: cargo build --locked --profile ffi-dev -p phux-client-ffi --target-dir target
diff --git a/crates/phux-client-ffi/src/pointer.rs b/crates/phux-client-ffi/src/pointer.rs
--- a/crates/phux-client-ffi/src/pointer.rs
+++ b/crates/phux-client-ffi/src/pointer.rs
@@ -231,1 +231,1 @@
-    use libghostty_vt::mouse::{EncoderOptions, TrackingMode};
+    use libghostty_vt::terminal::Mode;
@@ -236,11 +236,9 @@
-        *out = match EncoderOptions::from_terminal(terminal)
-            .map_err(BridgeError::ghostty)?
-            .tracking_mode
-        {
-            TrackingMode::None => 0,
-            TrackingMode::X10 => 1,
-            TrackingMode::Normal => 2,
-            TrackingMode::Button => 3,
-            TrackingMode::Any => 4,
-            _ => return Err(BridgeError::state("unsupported mouse tracking mode")),
-        };
+        *out = [
+            (Mode::ANY_MOUSE, 4),
+            (Mode::BUTTON_MOUSE, 3),
+            (Mode::NORMAL_MOUSE, 2),
+            (Mode::X10_MOUSE, 1),
+        ]
+        .into_iter()
+        .find_map(|(mode, value)| terminal.mode(mode).unwrap_or(false).then_some(value))
+        .unwrap_or(0);
