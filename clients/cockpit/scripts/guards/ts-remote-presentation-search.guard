# GUARD ts-remote-presentation-search
#
# Cmd+F is mapped to a native menu command before remote key routing. Requiring
# a local focusedPane there refused every remote Find command. Removing the
# provider-qualified dispatch restores that shipping failure through the real
# chord/core/native seam; the test also checks needle, navigation, copy and paint.
test: remote presentation search owns shipping chord text navigation clipboard and paint
red: 2026-09-07 at 8da00ad
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
index 4d510256..ad8f7e5a 100644
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -734,8 +734,6 @@ pub const Engine = struct {
     }
 
     fn localPresentationCommand(self: *Engine, command: protocol.NativeCommand, fx: anytype) bool {
-        const ref = self.model.focusedTerminalRef() orelse return false;
-        if (support.providerKind(ref) == .phux) return remote_commands.command(self.model, ref, command);
         const pane = self.focusedPane() orelse return false;
         return localPaneCommand(pane, command, fx);
     }
