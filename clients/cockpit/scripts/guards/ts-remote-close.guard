# GUARD ts-remote-close
#
# Describe the defect this test exists to catch, and what removing the
# fix below puts back. Prose here is preserved across re-runs.
test: shipping close detaches a Phux pane without destroying a local terminal
red: 2026-09-07 at 42c89a4
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/workspace_lifecycle.zig b/src/cockpit/workspace_lifecycle.zig
index 85581115..cd89de13 100644
--- a/src/cockpit/workspace_lifecycle.zig
+++ b/src/cockpit/workspace_lifecycle.zig
@@ -8,6 +8,7 @@ const scene = @import("native/scene.zig");
 const Model = model_module.Model;
 
 pub fn closePane(model: *Model, fx: anytype, ref: support.TerminalRef, kill: bool) bool {
+    if (model.provider.terminal(ref) == null) return false;
     const where = model.locateTerminal(ref) orelse return false;
     const workspace = model.wsAt(where.window) orelse return false;
     const tree = &workspace.tabs[where.tab];
