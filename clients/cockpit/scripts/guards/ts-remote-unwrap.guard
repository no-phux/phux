root: repository
rebuild: cargo build --locked --profile ffi-dev -p phux-client-ffi --target-dir target
diff --git a/crates/phux-client-core/src/engine/ghostty.rs b/crates/phux-client-core/src/engine/ghostty.rs
--- a/crates/phux-client-core/src/engine/ghostty.rs
