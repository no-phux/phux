# GUARD ts-remote-unwrap
# The document formatter left soft-wrap newlines in clipboard text. Restore
# that formatter option while exercising a real Ghostty-selected Unicode word.
test: shipping remote copy unwraps provider selected Unicode words
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
