# GUARD ts-remote-presentation-owner
#
# A retained presentation survives disconnect, but its frozen replica must not
# accept Find or reopen a search field. Removing the current-owner fence makes
# the shipping command path incorrectly accept Find after remote.stop().
test: remote presentation search consumes controls and rejects stale clipboard owners
red: 2026-09-07 at a0d9fea
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/native/remote_presentation_commands.zig b/src/cockpit/native/remote_presentation_commands.zig
index ff9d0d43..d67841cd 100644
--- a/src/cockpit/native/remote_presentation_commands.zig
+++ b/src/cockpit/native/remote_presentation_commands.zig
@@ -34,7 +34,6 @@ pub const Search = struct {
 pub fn command(model: *Model, ref: contract.TerminalRef, value: Command) bool {
     if (comptime !support.phux_enabled) return false;
     const state = model.remoteUi(ref) orelse return false;
-    if (!model.ownerIsCurrent(state.owner)) return false;
     switch (value) {
         .find => return open(model, ref, state),
         .select_all => return selectAll(model, ref, state),
