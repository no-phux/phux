# GUARD ts-remote-find-rebootstrap
#
# Find's search band resizes the viewport. Before this fix (276cb62e), the
# resulting owner replacement reset the entire RemoteUiState and closed Find.
# Restore that exact reset: the staged shipping BEGIN/CHUNK/READY regression
# must lose its open field, rather than retain its needle and rerun the query.
test: remote Find survives staged resize rebootstrap and reruns only on READY
red: 2026-09-07 at a0d9fea
build: test -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/model.zig b/src/cockpit/model.zig
index 686bc20c..96335b76 100644
--- a/src/cockpit/model.zig
+++ b/src/cockpit/model.zig
@@ -1061,7 +1061,7 @@ pub const Model = struct {
         for (&model.remote_ui) |*state| {
             if (state.terminal_ref) |known| {
                 if (!known.eql(terminal_ref)) continue;
-                if (!state.owner.eql(current_owner)) state.replaceOwner(current_owner, model.attachment_context);
+                if (!state.owner.eql(current_owner)) state.* = .{ .terminal_ref = terminal_ref, .owner = current_owner };
                 return state;
             }
             if (vacant == null) vacant = state;
