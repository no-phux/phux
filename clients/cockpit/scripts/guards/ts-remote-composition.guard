# GUARD ts-remote-composition
#
# Describe the defect this test exists to catch, and what removing the
# fix below puts back. Prose here is preserved across re-runs.
test: shipping Phux committed text consumes composition modifiers
red: 2026-09-07 at 424cc47
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/terminal_interaction.zig b/src/cockpit/terminal_interaction.zig
index 5e8dc582..db6a1e50 100644
--- a/src/cockpit/terminal_interaction.zig
+++ b/src/cockpit/terminal_interaction.zig
@@ -154,7 +154,7 @@ pub fn remoteText(model: *Model, ref: TerminalRef, event: Event) void {
         .text = event.text,
         // The text is already committed by the host's layout/IME. Applying
         // Option or Shift again would turn composed text into another chord.
-        .modifiers = .{},
+        .modifiers = modifiers(event),
     }) catch {};
 }
 
