# GUARD ts-engine-shells
#
# spawnShells runs after every intent and every frame, so it must be
# idempotent per pty key or every frame forks another shell into the same
# pane. The break drops the per-slot key check and spawns on every call.
test: every registered pane gets exactly one shell request and a closed tab kills its own
red: 2026-09-02 at d7dc724
build: test -Dplatform=null
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
index e45e82e..6fa362a 100644
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -156,7 +156,7 @@ pub const Engine = struct {
                 continue;
             }
             const pane = model.provider.slot(index);
-            if (self.spawned_keys[index] == pane.pty_key) continue;
+            if (false and self.spawned_keys[index] == pane.pty_key) continue;
             terminal_runtime.spawnPane(pane, fx, on_event);
             model_module.applySessionConfig(&model.config, pane.session);
             self.spawned_keys[index] = pane.pty_key;
