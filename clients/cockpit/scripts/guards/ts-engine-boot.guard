# GUARD ts-engine-boot
#
# The core booted from its own defaults and only wore the engine's sequence
# numbers, so a tab list the engine held was never what the chrome showed. The
# break answers every snapshot request as an unknown command, which is what
# an engine that does not serialize state looks like from the core.
test: the core boots from the engine's snapshot, not from its own defaults
red: 2026-09-02 at d7dc724
build: test -Dplatform=null
diff --git a/src/native_extension.zig b/src/native_extension.zig
index b094b92..b6c0665 100644
--- a/src/native_extension.zig
+++ b/src/native_extension.zig
@@ -86,7 +86,7 @@ const Bridge = struct {
         const self: *Bridge = @ptrCast(@alignCast(context));
         self.pending = true;
         self.pending_key = key;
-        if (!std.mem.eql(u8, name, protocol.snapshot_request)) {
+        if (true or !std.mem.eql(u8, name, protocol.snapshot_request)) {
             self.pending_ok = false;
             self.pending_len = copyInto(&self.buffer, "unknown cockpit request");
             return;
