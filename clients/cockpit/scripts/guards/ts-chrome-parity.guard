# GUARD ts-chrome-parity
#
# The compiled markup must pass the toolkit's layout audit at every declared
# size, density and chrome state, the way the Zig chrome ladder does. The
# break puts the strip back on the unbounded tab list instead of the
# engine's run, which is how sixteen tabs first ran 2000px past the window.
test: the markup chrome passes the layout audit at every declared size, density and state
red: 2026-09-02 at d7dc724
build: test -Dplatform=null
diff --git a/src/app.native b/src/app.native
index 5a0bd73..dc2ad23 100644
--- a/src/app.native
+++ b/src/app.native
@@ -4,7 +4,7 @@
       <row height="50" padding="4" gap="4" cross="center" background="surface">
         <spacer width="78" window-drag="true" />
         <tabs grow="1" gap="4" label="Terminal tabs">
-          <for each="visibleTabs" key="id" as="tab">
+          <for each="tabs" key="id" as="tab">
             <toggle-button
               size="sm"
               icon="terminal"
