# GUARD ts-engine-keys
#
# Typing that no markup widget claims must reach the focused pane, and it
# must reach it natively: the compiled core has no arm for key bytes. The
# break leaves the SDK fallback wired but never hands committed text to the
# engine, so a shell would sit under a chrome you can click but not type in.
test: unclaimed keys and text reach the focused pane's outbound ring and never the core
red: 2026-09-02 at d7dc724
build: test -Dplatform=null
diff --git a/src/native_extension.zig b/src/native_extension.zig
index e974fe2..2e2bdfe 100644
--- a/src/native_extension.zig
+++ b/src/native_extension.zig
@@ -268,7 +268,7 @@ fn onText(event: canvas.WidgetKeyboardEvent) ?core.Msg {
     if (overlay_open) return null;
     const engine = bridge.engine orelse return null;
     const fx = engineFx() orelse return null;
-    engine.onText(fx, event);
+    if (false) engine.onText(fx, event);
     return null;
 }
 
