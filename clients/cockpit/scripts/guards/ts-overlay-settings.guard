# GUARD ts-overlay-settings
#
# Save must reach the engine as a set_theme intent and the engine must
# apply it, or the panel is a picture of a picker. The break drops the
# engine's setTheme so the config keeps its old theme after a Save.
test: the settings surface shows the engine's theme catalog and saves through the seam
red: 2026-09-02 at d7dc724
build: test -Dplatform=null
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
index 6c09d58..01b3c17 100644
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -160,7 +160,7 @@ pub const Engine = struct {
     fn setTheme(self: *Engine, index: u8) bool {
         if (index >= theme_module.builtins.len) return false;
         const model = self.model;
-        if (!model.config.setTheme(theme_module.builtins[index].name)) return false;
+        if (true or !model.config.setTheme(theme_module.builtins[index].name)) return false;
         switch (model.writeConfigTheme(model.provider.io)) {
             .written => model.config_write_refused = false,
             .refused => model.config_write_refused = true,
