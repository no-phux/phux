# GUARD ts-remote-bell
# Remote Ghostty bells must reach the native notification effect.
test: shipping remote bell uses native notifications and owner fenced attention
build: test -j2 -Dplatform=null -Dphux-enabled=true -Dphux-client-ffi-profile=ffi-dev
diff --git a/src/cockpit/native/ts_engine.zig b/src/cockpit/native/ts_engine.zig
--- a/src/cockpit/native/ts_engine.zig
+++ b/src/cockpit/native/ts_engine.zig
@@ -292,3 +292,3 @@
             changed = true;
-            self.notifyRemoteBell(fx, owner.terminal_ref);
+            if (self.model.focused) self.notifyRemoteBell(fx, owner.terminal_ref);
         }
