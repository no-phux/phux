.zig-cache/
zig-out/
zig-pkg/
node_modules/
.native/

# The worktree's own Zig global cache, created by scripts/zig-build.sh so a
# stuck build runner in another worktree cannot hold this one's cache lock.
# Its `p/` is a symlink to the machine-wide package cache, so this directory is
# ~45 MB, not a copy of the pinned SDK.
.zig-global-cache/
*.png

# Local product references captured from X and other public sources. The
# capture/review tooling is tracked; downloaded media and working notes are not.
.references/

# The dev run's own home: config, workspace layout and automation dropbox for
# ./scripts/dev-run.sh. Deliberately NOT under zig-out, so a clean build cannot
# throw away the profile you have been tuning.
.dev-run/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
