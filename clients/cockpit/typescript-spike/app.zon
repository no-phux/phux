.{
    .id = "dev.phux.cockpit.typescript-spike",
    .name = "phux-cockpit-typescript-spike",
    .display_name = "Phux Cockpit TS",
    .description = "The TypeScript + Native markup Cockpit migration artifact.",
    .version = "0.1.0",
    .theme = "geist",
    .theme_accent = "#bef264",
    .platforms = .{"macos"},
    .permissions = .{ "view", "command" },
    .capabilities = .{ "native_views", "gpu_surfaces", "menus", "shortcuts", "file_drops" },
    .menus = .{
        .{ .title = "Shell", .items = .{
            .{ .label = "New Window", .command = "window.new", .key = "n", .modifiers = .{"primary"} },
            .{ .label = "New Tab", .command = "terminal.new", .key = "t", .modifiers = .{"primary"} },
            .{ .label = "Split Right", .command = "pane.split-right", .key = "d", .modifiers = .{"primary"} },
            .{ .label = "Split Down", .command = "pane.split-down", .key = "d", .modifiers = .{ "primary", "shift" } },
            .{ .separator = true },
            .{ .label = "Close", .command = "terminal.close", .key = "w", .modifiers = .{"primary"} },
        } },
        .{ .title = "Edit", .items = .{
            .{ .label = "Copy", .command = "terminal.copy", .key = "c", .modifiers = .{"primary"} },
            .{ .label = "Paste", .command = "terminal.paste", .key = "v", .modifiers = .{"primary"} },
            .{ .separator = true },
            .{ .label = "Select All", .command = "terminal.select-all", .key = "a", .modifiers = .{"primary"} },
            .{ .label = "Clear", .command = "terminal.clear", .key = "k", .modifiers = .{"primary"} },
            .{ .separator = true },
            .{ .label = "Find", .command = "terminal.find", .key = "f", .modifiers = .{"primary"} },
            .{ .label = "Find Next", .command = "terminal.find-next", .key = "g", .modifiers = .{"primary"} },
            .{ .label = "Find Previous", .command = "terminal.find-previous", .key = "g", .modifiers = .{ "primary", "shift" } },
        } },
        .{ .title = "View", .items = .{
            .{ .label = "Settings…", .command = "settings.open", .key = ",", .modifiers = .{"primary"} },
            .{ .separator = true },
            .{ .label = "Enter Full Screen", .command = "window.fullscreen", .key = "f", .modifiers = .{ "primary", "control" } },
            .{ .separator = true },
            .{ .label = "Increase Font Size", .command = "view.font-larger", .key = "=", .modifiers = .{"primary"} },
            .{ .label = "Decrease Font Size", .command = "view.font-smaller", .key = "-", .modifiers = .{"primary"} },
            .{ .label = "Reset Font Size", .command = "view.font-reset", .key = "0", .modifiers = .{"primary"} },
            .{ .separator = true },
            .{ .label = "Toggle Tab Placement", .command = "tabs.toggle-placement" },
        } },
        .{ .title = "Window", .items = .{
            .{ .label = "Minimize", .command = "window.minimize", .key = "m", .modifiers = .{"primary"} },
            .{ .separator = true },
            .{ .label = "Go to Terminal…", .command = "tabs.palette", .key = "p", .modifiers = .{ "primary", "shift" } },
            .{ .separator = true },
            .{ .label = "Previous Tab", .command = "tab.previous", .key = "[", .modifiers = .{ "primary", "shift" } },
            .{ .label = "Next Tab", .command = "tab.next", .key = "]", .modifiers = .{ "primary", "shift" } },
            .{ .separator = true },
            .{ .label = "Move Tab Left", .command = "tab.move-left", .key = "arrowleft", .modifiers = .{ "primary", "shift" } },
            .{ .label = "Move Tab Right", .command = "tab.move-right", .key = "arrowright", .modifiers = .{ "primary", "shift" } },
            .{ .separator = true },
            .{ .label = "Previous Pane", .command = "pane.previous", .key = "[", .modifiers = .{"primary"} },
            .{ .label = "Next Pane", .command = "pane.next", .key = "]", .modifiers = .{"primary"} },
        } },
    },
    .shortcuts = .{
        .{ .id = "surface.1", .key = "1", .modifiers = .{"primary"} },
        .{ .id = "surface.2", .key = "2", .modifiers = .{"primary"} },
        .{ .id = "surface.3", .key = "3", .modifiers = .{"primary"} },
        .{ .id = "surface.4", .key = "4", .modifiers = .{"primary"} },
        .{ .id = "surface.5", .key = "5", .modifiers = .{"primary"} },
        .{ .id = "tabs.palette", .key = "p", .modifiers = .{ "primary", "shift" } },
        .{ .id = "settings.open", .key = ",", .modifiers = .{"primary"} },
        .{ .id = "tab.previous", .key = "[", .modifiers = .{ "primary", "shift" } },
        .{ .id = "tab.next", .key = "]", .modifiers = .{ "primary", "shift" } },
        .{ .id = "terminal.new", .key = "t", .modifiers = .{"primary"} },
        .{ .id = "window.new", .key = "n", .modifiers = .{"primary"} },
        .{ .id = "terminal.close", .key = "w", .modifiers = .{"primary"} },
        .{ .id = "window.fullscreen", .key = "f", .modifiers = .{ "primary", "control" } },
        .{ .id = "window.minimize", .key = "m", .modifiers = .{"primary"} },
        .{ .id = "pane.split-right", .key = "d", .modifiers = .{"primary"} },
        .{ .id = "pane.split-down", .key = "d", .modifiers = .{ "primary", "shift" } },
        .{ .id = "pane.previous", .key = "[", .modifiers = .{"primary"} },
        .{ .id = "pane.next", .key = "]", .modifiers = .{"primary"} },
        .{ .id = "tab.move-left", .key = "arrowleft", .modifiers = .{ "primary", "shift" } },
        .{ .id = "tab.move-right", .key = "arrowright", .modifiers = .{ "primary", "shift" } },
        .{ .id = "terminal.select-all", .key = "a", .modifiers = .{"primary"} },
        .{ .id = "terminal.copy", .key = "c", .modifiers = .{"primary"} },
        .{ .id = "terminal.paste", .key = "v", .modifiers = .{"primary"} },
        .{ .id = "terminal.clear", .key = "k", .modifiers = .{"primary"} },
        .{ .id = "terminal.find", .key = "f", .modifiers = .{"primary"} },
        .{ .id = "terminal.find-next", .key = "g", .modifiers = .{"primary"} },
        .{ .id = "terminal.find-previous", .key = "g", .modifiers = .{ "primary", "shift" } },
        .{ .id = "view.font-larger", .key = "=", .modifiers = .{"primary"} },
        .{ .id = "view.font-smaller", .key = "-", .modifiers = .{"primary"} },
        .{ .id = "view.font-reset", .key = "0", .modifiers = .{"primary"} },
        .{ .id = "pane.focus-left", .key = "arrowleft", .modifiers = .{ "primary", "option" } },
        .{ .id = "pane.focus-right", .key = "arrowright", .modifiers = .{ "primary", "option" } },
        .{ .id = "pane.focus-up", .key = "arrowup", .modifiers = .{ "primary", "option" } },
        .{ .id = "pane.focus-down", .key = "arrowdown", .modifiers = .{ "primary", "option" } },
    },
    .shell = .{
        .windows = .{.{
            .label = "main",
            .title = "Phux Cockpit TS",
            .width = 1100,
            .height = 640,
            .min_width = 900,
            .min_height = 420,
            .restore_state = false,
            .restore_policy = "center_on_primary",
            .titlebar = "hidden_inset_tall",
            .views = .{.{
                .label = "phux-cockpit-canvas",
                .kind = "gpu_surface",
                .fill = true,
                .role = "Phux Cockpit canvas",
                .accessibility_label = "Phux Cockpit",
                .gpu_backend = "metal",
                .gpu_pixel_format = "bgra8_unorm",
                .gpu_present_mode = "timer",
                .gpu_alpha_mode = "opaque",
                .gpu_color_space = "srgb",
                .gpu_vsync = true,
            }},
        }},
    },
}
