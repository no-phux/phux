<stack>
  <if test="{tabPlacement == 'top'}">
    <column>
      <row height="50" padding="4" gap="4" cross="center" background="surface">
        <spacer width="78" window-drag="true" />
        <tabs grow="1" gap="4" label="Terminal tabs">
          <for each="visibleTabs" key="id" as="tab">
            <toggle-button
              size="sm"
              icon="terminal"
              width="{tabWidth}"
              role="tab"
              selected="{tab.selected}"
              on-toggle="select_tab:{tab.index}"
            >{tab.title}</toggle-button>
          </for>
          <if test="{hasOverflow}">
            <text width="32" label="Tabs not shown">{overflowLabel}</text>
          </if>
        </tabs>
        <button size="sm" variant="ghost" icon="search" label="Command palette" on-press="palette_open" />
        <button size="sm" variant="ghost" icon="plus" label="New terminal" on-press="new_terminal" />
        <button size="sm" variant="ghost" icon="external-link" label="New window" on-press="new_window" />
        <button size="sm" variant="ghost" icon="settings" label="Settings" on-press="settings_open" />
      </row>
      <spacer grow="1" />
      <status-bar>{status}</status-bar>
    </column>
  </if>
  <else>
    <row>
      <column width="184" padding="4" gap="8" background="surface" label="Terminal tabs">
        <row height="40" cross="center">
          <text grow="1">Cockpit</text>
          <button size="sm" variant="ghost" icon="plus" label="New terminal" on-press="new_terminal" />
        </row>
        <list grow="1" gap="4">
          <for each="visibleTabs" key="id" as="tab">
            <list-item
              icon="terminal"
              selected="{tab.selected}"
              on-press="select_tab:{tab.index}"
            >{tab.title}</list-item>
          </for>
          <if test="{hasOverflow}">
            <text label="Tabs not shown">{overflowLabel}</text>
          </if>
        </list>
        <button size="sm" variant="ghost" icon="search" on-press="palette_open">Commands</button>
        <button size="sm" variant="ghost" icon="settings" on-press="settings_open">Settings</button>
        <status-bar>{status}</status-bar>
      </column>
      <spacer width="8" />
      <spacer grow="1" />
    </row>
  </else>

  <if test="{mainPaletteOpen}">
    <row main="center" cross="start" padding="24">
      <panel width="520" padding="16">
        <column gap="12">
          <row cross="center" gap="8">
            <icon name="search" width="16" height="16" />
            <text grow="1">Switch terminal</text>
            <button size="sm" variant="ghost" icon="x" label="Close switcher" on-press="palette_close" />
          </row>
          <input
            text="{paletteQuery}"
            placeholder="Terminal number, title, or directory"
            autofocus="true"
            on-input="palette_edit"
            on-submit="palette_submit"
            label="Find terminal"
          />
          <list gap="2" label="Terminals">
            <for each="paletteRows" key="id" as="row">
              <list-item
                icon="terminal"
                selected="{row.highlighted}"
                on-press="palette_pick:{row.index}"
              >{row.label}</list-item>
            </for>
          </list>
        </column>
      </panel>
    </row>
  </if>

  <if test="{mainSettingsOpen}">
    <row main="end">
      <panel width="400" padding="12">
        <column gap="8">
          <row cross="center">
            <text grow="1">Settings</text>
            <button size="sm" variant="ghost" icon="x" label="Close settings" on-press="settings_close" />
          </row>
          <text foreground="text_muted">Theme</text>
          <list gap="0" label="Themes">
            <for each="themes" key="index" as="theme">
              <list-item
                height="24"
                selected="{theme.highlighted}"
                on-press="settings_pick:{theme.index}"
              >{theme.label}</list-item>
            </for>
          </list>
          <row cross="center" gap="8">
            <text grow="1" foreground="text_muted">Configuration</text>
            <if test="{configExists}">
              <button size="sm" variant="ghost" on-press="settings_reveal">Show in Finder</button>
            </if>
          </row>
          <text wrap="true" foreground="text_muted">{configNotice}</text>
          <row gap="8" cross="center">
            <button size="sm" variant="ghost" on-press="toggle_tab_placement">Move tab strip</button>
            <spacer grow="1" />
            <button size="sm" variant="ghost" on-press="settings_close">Cancel</button>
            <button size="sm" on-press="settings_commit">Save</button>
          </row>
        </column>
      </panel>
    </row>
  </if>
</stack>
