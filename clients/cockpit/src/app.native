<import src="windows/components/cockpit-window.native" />
<use template="cockpit-window" tabs="{visibleTabs}" rail="{railRows}" width="{tabWidth}" more="{hasOverflow}" cue="{overflowLabel}" paletteopen="{mainPaletteOpen}" palettequery="{paletteQuery}" paletterows="{paletteRows}" paletteprevious="{palettePrevious}" palettenext="{paletteNext}" palettenotice="{paletteNotice}" status="{connectionStatus}" reconnect="{canReconnect}" commandnotice="{commandNotice}">
  <use template="cockpit-settings" settingsopen="{mainSettingsOpen}" themes="{themes}" configexists="{configExists}" confignotice="{configNotice}" />
  <use template="cockpit-host" hostopen="{mainHostOpen}" />
  <use template="cockpit-directory" diropen="{mainDirOpen}" />
  <use template="cockpit-rename" renameopen="{mainRenameOpen}" />
  <use template="cockpit-empty" emptyopen="{mainEmptyOpen}" />
  <use template="cockpit-agents" open="{mainAgentsOpen}" rows="{paletteRows}" notice="{paletteNotice}" previous="{palettePrevious}" next="{paletteNext}" status="{connectionStatus}" />
</use>
