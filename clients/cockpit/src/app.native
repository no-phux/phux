<import src="windows/components/cockpit-window.native" />
<stack>
  <use template="cockpit-window" tabs="{visibleTabs}" rail="{railRows}" width="{tabWidth}" more="{hasOverflow}" cue="{overflowLabel}" menuopen="{mainHeaderMenuOpen}" status="{connectionStatus}" title="{mainContext.title}" detail="{mainContext.detail}" location="{mainContext.location}" emptyopen="{mainEmptyOpen}" emptyname="{mainContext.emptyName}" emptydetail="{mainContext.emptyDetail}" emptypicked="{mainContext.emptyPicked}" pasteopen="{mainPasteOpen}" />
  <use template="cockpit-navigator" paletteopen="{mainPaletteOpen}" palettequery="{paletteQuery}" paletterows="{paletteRows}" paletteprevious="{palettePrevious}" palettenext="{paletteNext}" palettenotice="{paletteNotice}" title="{mainContext.title}" />
  <use template="cockpit-settings" settingsopen="{mainSettingsOpen}" themes="{themes}" configexists="{configExists}" confignotice="{configNotice}" />
  <use template="cockpit-host" hostopen="{mainHostOpen}" />
  <use template="cockpit-directory" diropen="{mainDirOpen}" />
  <use template="cockpit-rename" renameopen="{mainRenameOpen}" />
  <use template="cockpit-agents" open="{mainAgentsOpen}" rows="{paletteRows}" notice="{paletteNotice}" previous="{palettePrevious}" next="{paletteNext}" status="{connectionStatus}" />
</stack>
