<import src="components/cockpit-window.native"/>
<use template="cockpit-window" tabs="{window1Tabs}" width="{window1TabWidth}" more="{window1HasOverflow}" cue="{window1OverflowLabel}" paletteopen="{window1PaletteOpen}" palettequery="{paletteQuery}" paletterows="{paletteRows}" paletteprevious="{palettePrevious}" palettenext="{paletteNext}" palettenotice="{paletteNotice}" status="{connectionStatus}" reconnect="{canReconnect}" settingsopen="{window1SettingsOpen}" themes="{themes}" configexists="{configExists}" confignotice="{configNotice}" />
