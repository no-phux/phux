<import src="components/cockpit-window.native"/>
<stack>
  <use template="cockpit-window" tabs="{window3Tabs}" rail="{window3RailRows}" width="{window3TabWidth}" cue="{window3OverflowLabel}" status="{window3Status}" title="{window3Context.title}" detail="{window3Context.detail}" emptyopen="{window3EmptyOpen}" emptyname="{window3Context.emptyName}" emptydetail="{window3Context.emptyDetail}" emptypicked="{window3Context.emptyPicked}" />
  <use template="cockpit-navigator" paletteopen="{window3PaletteOpen}" palettequery="{paletteQuery}" paletterows="{paletteRows}" paletteprevious="{palettePrevious}" palettenext="{paletteNext}" palettenotice="{paletteNotice}" />
  <use template="cockpit-settings" settingsopen="{window3SettingsOpen}" themes="{themes}" configexists="{configExists}" confignotice="{configNotice}" />
  <use template="cockpit-host" hostopen="{window3HostOpen}" />
  <use template="cockpit-directory" diropen="{window3DirOpen}" />
  <use template="cockpit-rename" renameopen="{window3RenameOpen}" />
  <use template="cockpit-agents" open="{window3AgentsOpen}" rows="{paletteRows}" notice="{paletteNotice}" previous="{palettePrevious}" next="{paletteNext}" status="{window3Status}" />
</stack>
