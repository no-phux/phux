<import src="components/cockpit-window.native"/>
<use template="cockpit-window" tabs="{window3Tabs}" rail="{window3RailRows}" width="{window3TabWidth}" more="{window3HasOverflow}" cue="{window3OverflowLabel}" paletteopen="{window3PaletteOpen}" palettequery="{paletteQuery}" paletterows="{paletteRows}" paletteprevious="{palettePrevious}" palettenext="{paletteNext}" palettenotice="{paletteNotice}" status="{window3Status}" title="{window3Context.title}" detail="{window3Context.detail}">
  <use template="cockpit-settings" settingsopen="{window3SettingsOpen}" themes="{themes}" configexists="{configExists}" confignotice="{configNotice}" />
  <use template="cockpit-host" hostopen="{window3HostOpen}" />
  <use template="cockpit-directory" diropen="{window3DirOpen}" />
  <use template="cockpit-rename" renameopen="{window3RenameOpen}" />
  <use template="cockpit-empty" emptyopen="{window3EmptyOpen}" name="{window3Context.emptyName}" detail="{window3Context.emptyDetail}" picked="{window3Context.emptyPicked}" />
</use>
