<import src="components/cockpit-window.native"/>
<stack>
  <use template="cockpit-window" tabs="{window2Tabs}" rail="{window2RailRows}" width="{window2TabWidth}" more="{window2HasOverflow}" cue="{window2OverflowLabel}" menuopen="{window2HeaderMenuOpen}" status="{window2Status}" title="{window2Context.title}" detail="{window2Context.detail}" location="{window2Context.location}" emptyopen="{window2EmptyOpen}" emptyname="{window2Context.emptyName}" emptydetail="{window2Context.emptyDetail}" emptypicked="{window2Context.emptyPicked}" />
  <use template="cockpit-navigator" paletteopen="{window2PaletteOpen}" palettequery="{paletteQuery}" paletterows="{paletteRows}" paletteprevious="{palettePrevious}" palettenext="{paletteNext}" palettenotice="{paletteNotice}" title="{window2Context.title}" />
  <use template="cockpit-settings" settingsopen="{window2SettingsOpen}" themes="{themes}" configexists="{configExists}" confignotice="{configNotice}" />
  <use template="cockpit-host" hostopen="{window2HostOpen}" />
  <use template="cockpit-directory" diropen="{window2DirOpen}" />
  <use template="cockpit-rename" renameopen="{window2RenameOpen}" />
  <use template="cockpit-agents" open="{window2AgentsOpen}" rows="{paletteRows}" notice="{paletteNotice}" previous="{palettePrevious}" next="{paletteNext}" status="{window2Status}" />
</stack>
