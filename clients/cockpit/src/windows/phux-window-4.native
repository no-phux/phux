<import src="components/cockpit-window.native"/>
<use template="cockpit-window" tabs="{window4Tabs}" width="{window4TabWidth}" more="{window4HasOverflow}" cue="{window4OverflowLabel}" paletteopen="{window4PaletteOpen}" palettequery="{paletteQuery}" paletterows="{paletteRows}" paletteprevious="{palettePrevious}" palettenext="{paletteNext}" palettenotice="{paletteNotice}" status="{window4Status}" reconnect="{canReconnect}">
  <use template="cockpit-settings" settingsopen="{window4SettingsOpen}" themes="{themes}" configexists="{configExists}" confignotice="{configNotice}" />
</use>
