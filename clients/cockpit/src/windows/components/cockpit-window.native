<import src="cockpit-settings.native" />
<import src="cockpit-navigator.native" />
<import src="cockpit-host.native" />
<import src="cockpit-directory.native" />
<import src="cockpit-rename.native" />
<import src="cockpit-agents.native" />
<template name="cockpit-window" args="tabs rail width more cue status title detail emptyopen emptyname emptydetail emptypicked">
  <column grow="1">
    <row height="50" padding="4" gap="8" cross="center" background="surface">
      <spacer width="78" window-drag="true" />
      <list-item height="40" width="176" label="Sessions" on-press="sessions_open">
        <column gap="0">
          <text overflow="ellipsis">{title}</text>
          <text foreground="text_muted" overflow="ellipsis">{detail}</text>
        </column>
      </list-item>
      <button size="sm" variant="ghost" icon="terminal" label="Inspect agents" on-press="agents_open" />

      <if test="{tabPlacement == 'top'}">
        <tabs grow="1" gap="4" label="Terminal tabs">
          <for each="tabs" key="id" as="tab">
            <column width="{width}" gap="4">
              <row gap="4" cross="center">
                <toggle-button size="sm" role="tab" selected="{tab.selected}" accent="surface_pressed" accent-foreground="text" on-toggle="select_target:{tab.target}" grow="1">{tab.title}</toggle-button>
                <if test="{tab.attention}"><text label="{tab.attentionLabel}">●</text></if>
              </row>
              <if test="{tab.selected}"><spacer height="2" background="accent" /></if>
              <else><spacer height="2" /></else>
            </column>
          </for>
          <if test="{more}"><button size="sm" width="32" variant="ghost" label="Tabs not shown" on-press="palette_open">{cue}</button></if>
        </tabs>
      </if>
      <else><spacer grow="1" /></else>
      <button size="sm" variant="ghost" icon="external-link" label="Machines" on-press="machines_open">Machines</button>
      <button size="sm" variant="ghost" icon="plus" label="New Tab" on-press="new_terminal" />
      <button size="sm" variant="ghost" icon="panel-left" label="Move tabs to top or side" on-press="toggle_tab_placement" />
      <button size="sm" variant="ghost" icon="settings" label="Settings" on-press="settings_open" />
    </row>
    <row grow="1">
      <if test="{tabPlacement == 'side'}">
        <column width="224" padding="12" gap="12" background="surface">
          <row height="32" cross="center" gap="8">
            <text grow="1" foreground="text_muted">TABS</text>
            <button size="sm" variant="ghost" icon="search" label="Find work" on-press="palette_open" />
          </row>
          <scroll grow="1">
            <column gap="4">
              <for each="rail" key="id" as="row">
                <if test="{row.agent}">
                  <row gap="8" padding="4" cross="center">
                    <spacer width="16" />
                    <text grow="1" foreground="text_muted" overflow="ellipsis">{row.label}</text>
                    <text foreground="text_muted">{row.state}</text>
                    <text foreground="warning" label="{row.attentionLabel}">{row.mark}</text>
                  </row>
                </if>
                <else>
                  <row gap="4" cross="center">
                    <if test="{row.selected}"><spacer width="2" height="24" background="accent" /></if>
                    <else><spacer width="2" height="24" /></else>
                    <list-item grow="1" icon="terminal" role="tab" selected="{row.selected}" accent="surface_pressed" accent-foreground="text" on-press="select_target:{row.target}">{row.label}</list-item>
                    <if test="{row.mark}"><text label="{row.attentionLabel}">{row.mark}</text></if>
                  </row>
                </else>
              </for>
            </column>
          </scroll>
          <separator />
          <button size="sm" variant="ghost" icon="folder" on-press="sessions_open">Sessions</button>
          <button size="sm" variant="ghost" icon="search" on-press="commands_open">Commands</button>
          <button size="sm" variant="ghost" icon="external-link" on-press="new_window">New window</button>
        </column>
      </if>
      <column grow="1">
        <stack grow="1" label="phux-terminal-space">
          <if test="{emptyopen}">
            <scroll grow="1">
              <column gap="8" padding="16">
                <row cross="center" gap="8">
                  <icon name="terminal" width="16" height="16" />
                  <text grow="1" overflow="ellipsis">{emptyname}</text>
                  <if test="{emptypicked}"><button size="sm" variant="ghost" icon="x" label="Dismiss empty session" on-press="empty_dismiss" /></if>
                </row>
                <text foreground="text_muted" overflow="ellipsis">{emptydetail}</text>
                <text size="heading">Empty session</text>
                <text wrap="true">Open a new tab to start a terminal.</text>
                <if test="{emptyNotice}"><text wrap="true" foreground="text_muted">{emptyNotice}</text></if>
                <row gap="8" cross="center">
                  <spacer grow="1" />
                  <button size="sm" disabled="{emptyBusy}" on-press="empty_new_tab">New Tab</button>
                </row>
              </column>
            </scroll>
          </if>
          <else>
            <spacer grow="1" />
          </else>
        </stack>
        <if test="{commandNotice}"><status-bar>{commandNotice}</status-bar></if>
        <else>
          <if test="{canReconnect}">
            <row height="40" gap="8" padding="4" cross="center" background="surface">
              <icon name="alert" width="16" height="16" foreground="warning" />
              <text grow="1">{status}</text>
              <button size="sm" variant="ghost" on-press="reconnect">Reconnect</button>
            </row>
          </if>
          <else>
            <if test="{status != 'Local terminals'}">
              <if test="{status != 'Phux connected'}"><status-bar height="24">{status}</status-bar></if>
            </if>
          </else>
        </else>
      </column>
    </row>
  </column>
</template>
