<import src="cockpit-settings.native" />
<template name="cockpit-window" args="tabs rail width more cue menuopen paletteopen palettequery paletterows paletteprevious palettenext palettenotice status title detail">
  <stack>
    <column>
      <!-- Hidden-inset chrome: this header row is the window-drag surface.
            Press-claiming children (tabs and buttons) stay
           buttons; empty chrome, gaps, and the traffic-light reserve move
           the window. Do not park window-drag on the 78pt spacer alone —
           that reserve sits under the lights and is not a usable grab. -->
      <row height="50" padding="4" gap="8" cross="center" window-drag="true">
        <spacer width="78" />
        <if test="{tabPlacement == 'top'}">
          <tabs height="32" grow="1" gap="4" cross="center" label="Terminal tabs">
            <for each="tabs" key="id" as="tab">
              <!-- Direct buttons become native tab triggers: sibling arrow,
                   Home/End focus and the selected underline belong to the SDK.
                   Fixed attention/close slots keep all titles equal in width. -->
              <button width="0" grow="1" height="32" size="sm" variant="ghost" role="tab" label="{tab.title}" selected="{tab.selected}" accent="accent" on-press="select_target:{tab.target}">{tab.title}
                <context-menu>
                  <menu-item disabled="{tab.movePreviousDisabled}" on-press="move_tab_previous_target:{tab.target}">Move Left</menu-item>
                  <menu-item disabled="{tab.moveNextDisabled}" on-press="move_tab_next_target:{tab.target}">Move Right</menu-item>
                  <separator />
                  <menu-item on-press="close_tab_target:{tab.target}">Close Tab</menu-item>
                </context-menu>
              </button>
              <if test="{tab.attention}"><text width="16" foreground="warning" label="{tab.attentionLabel}">●</text></if>
              <else><spacer width="16" /></else>
              <!-- Wrapping only the close control keeps it out of tab traversal. -->
              <stack width="32" height="32">
                <button size="sm" variant="ghost" icon="x" label="{tab.closeLabel}" on-press="close_tab_target:{tab.target}" />
                <if test="{tab.selected}"><tooltip anchor="below">Close {tab.title}</tooltip></if>
              </stack>
            </for>
            <if test="{more}"><stack width="32"><button size="sm" width="32" variant="ghost" label="Tabs not shown" on-press="palette_open">{cue}</button><tooltip anchor="below">Show hidden tabs</tooltip></stack></if>
          </tabs>
        </if>
        <else><text grow="1" foreground="text_muted" overflow="ellipsis">{title}</text></else>
        <stack width="32">
          <button size="sm" variant="ghost" icon="plus" label="New Tab" on-press="new_terminal" />
          <tooltip anchor="below">New tab</tooltip>
        </stack>
        <stack width="32">
          <button size="sm" variant="ghost" icon="chevron-down" label="Workspace actions" selected="{menuopen}" on-press="header_menu_toggle" />
          <tooltip anchor="below">Workspace actions</tooltip>
          <if test="{menuopen}">
            <dropdown-menu width="280" anchor="below" anchor-alignment="end" anchor-offset="8" on-dismiss="header_menu_close" label="Workspace actions">
              <column padding="8" gap="4">
                <text overflow="ellipsis">{title}</text>
                <text foreground="text_muted" overflow="ellipsis">{detail}</text>
              </column>
              <separator />
              <menu-item icon="folder" autofocus="true" on-press="header_sessions">Sessions</menu-item>
              <menu-item icon="external-link" on-press="header_machines">Machines</menu-item>
              <menu-item icon="terminal" on-press="header_agents">Inspect agents</menu-item>
              <separator />
              <menu-item icon="external-link" on-press="header_new_window">New window</menu-item>
              <if test="{tabPlacement == 'top'}"><menu-item icon="panel-left" on-press="header_tab_placement">Move tabs to side</menu-item></if>
              <else><menu-item icon="panel-left" on-press="header_tab_placement">Move tabs to top</menu-item></else>
              <separator />
              <menu-item icon="search" label="All commands" on-press="header_commands">All commands…</menu-item>
              <menu-item icon="settings" on-press="header_settings">Settings…</menu-item>
            </dropdown-menu>
          </if>
        </stack>
      </row>
      <row grow="1">
        <if test="{tabPlacement == 'side'}">
          <column width="224" padding="12" gap="12">
            <row height="32" cross="center" gap="8">
              <text grow="1" foreground="text_muted">TABS</text>
              <stack width="32">
                <button size="sm" variant="ghost" icon="search" label="Find work" on-press="palette_open" />
                <tooltip anchor="below">Find work</tooltip>
              </stack>
            </row>
            <scroll grow="1">
              <column gap="4">
                <for each="rail" key="id" as="row">
                  <if test="{row.agent}">
                    <row gap="8" padding="4" cross="center">
                      <spacer width="16" />
                      <text grow="1" foreground="text_muted" overflow="ellipsis">{row.label}</text>
                      <text foreground="text_muted">{row.state}</text>
                      <text foreground="warning" label="{row.attentionLabel}">{row.mark}</text>
                    </row>
                  </if>
                  <else>
                    <row gap="4" cross="center">
                      <if test="{row.selected}"><spacer width="2" height="24" background="accent" /></if>
                      <else><spacer width="2" height="24" /></else>
                      <list-item grow="1" icon="terminal" role="tab" label="{row.label}" selected="{row.selected}" accent="surface_pressed" accent-foreground="text" on-press="select_target:{row.target}">
                        <text overflow="ellipsis">{row.label}</text>
                        <context-menu>
                          <menu-item disabled="{row.movePreviousDisabled}" on-press="move_tab_previous_target:{row.target}">Move Up</menu-item>
                          <menu-item disabled="{row.moveNextDisabled}" on-press="move_tab_next_target:{row.target}">Move Down</menu-item>
                          <separator />
                          <menu-item on-press="close_tab_target:{row.target}">Close Tab</menu-item>
                        </context-menu>
                      </list-item>
                      <if test="{row.mark}"><text width="16" foreground="warning" label="{row.attentionLabel}">{row.mark}</text></if>
                      <else><spacer width="16" /></else>
                      <stack width="32" height="32">
                        <button size="sm" variant="ghost" icon="x" label="{row.closeLabel}" on-press="close_tab_target:{row.target}" />
                        <if test="{row.selected}"><tooltip anchor="below">Close {row.label}</tooltip></if>
                      </stack>
                    </row>
                  </else>
                </for>
              </column>
            </scroll>
          </column>
        </if>
        <column grow="1">
          <spacer grow="1" label="phux-terminal-space" />
          <if test="{canReconnect}">
            <row height="40" gap="8" padding="4" cross="center" background="surface">
              <icon name="alert" width="16" height="16" foreground="warning" />
              <text grow="1">{status}</text>
              <button size="sm" variant="ghost" on-press="reconnect">Reconnect</button>
            </row>
          </if>
          <else>
            <if test="{commandNotice}"><status-bar>{commandNotice}</status-bar></if>
            <else>
              <if test="{status != 'Local terminals'}">
                <if test="{status != 'Phux connected'}"><status-bar height="24">{status}</status-bar></if>
              </if>
            </else>
          </else>
        </column>
      </row>
    </column>
    <if test="{paletteopen}">
        <!-- The SDK owns modal placement and the token-driven frosted scrim.
             The preferred picker envelope clamps to the viewport; results scroll. -->
        <dialog width="640" height="640" padding="16" on-dismiss="palette_close" label="Navigator">
          <column grow="1" gap="8">
            <row cross="center" gap="8">
              <icon name="folder-open" width="16" height="16" />
              <text grow="1" size="heading">{navigatorTitle}</text>
              <button size="sm" variant="ghost" on-press="agents_open">Agents</button>
              <button size="sm" variant="ghost" icon="x" label="Close navigator" on-press="palette_close" />

            </row>
            <if test="{navigatorView == 4}"><text foreground="text_muted" overflow="ellipsis">{title}</text></if>
            <tabs gap="4" label="Navigator views">
              <button size="sm" variant="ghost" selected="{navigatorView == 0}" on-press="palette_open">All work</button>
              <button size="sm" variant="ghost" selected="{navigatorView == 1}" on-press="sessions_open">Sessions</button>
              <button size="sm" variant="ghost" selected="{navigatorView == 2}" on-press="machines_open">Machines</button>
              <button size="sm" variant="ghost" selected="{navigatorView == 3}" on-press="windows_open">Windows</button>
              <spacer grow="1" />
              <button size="sm" variant="ghost" selected="{navigatorView == 4}" on-press="commands_open">Commands</button>
            </tabs>
            <if test="{navigatorView == 4}"><input text="{palettequery}" placeholder="Type a command" autofocus="true" on-input="palette_edit" on-submit="palette_submit" label="Search commands" /></if>
            <else><input text="{palettequery}" placeholder="Search by name, machine or directory" autofocus="true" on-input="palette_edit" on-submit="palette_submit" label="Search navigator" /></else>
            <if test="{navigatorView == 2}">
              <if test="{machines.failed}"><text wrap="true" foreground="warning">Check the machine registry, then refresh.</text></if>
              <else><if test="{machines.total == 1}"><text wrap="true" foreground="text_muted">No remote machines added</text></if></else>
            </if>
            <scroll grow="1" value="{navigatorScroll}" on-scroll="navigator_scrolled">
            <if test="{navigatorView == 4}">
              <list gap="4" label="Commands">
                <for each="actionRows" key="index" as="action">
                  <list-item height="40" label="{action.label}" selected="{action.highlighted}" disabled="{action.disabled}" accent="surface_pressed" accent-foreground="text" on-press="commands_pick:{action.index}">
                    <row grow="1" gap="8" cross="center">
                      <if test="{action.highlighted}"><spacer width="2" height="24" background="accent" /></if>
                      <else><spacer width="2" height="24" /></else>
                      <column grow="1" gap="0">
                        <text overflow="ellipsis">{action.label}</text>
                        <if test="{action.detail}"><text foreground="text_muted" overflow="ellipsis">{action.detail}</text></if>
                      </column>
                      <text foreground="text_muted">{action.shortcut}</text>
                    </row>
                  </list-item>
                </for>
              </list>
            </if>
            <else>
            <if test="{navigatorView == 2}">
              <column gap="8">
                <list gap="4" label="Saved machines">
                  <for each="machineRows" key="target" as="machine">
                    <list-item height="{machine.height}" label="{machine.name}" selected="{machine.highlighted}" accent="surface_pressed" accent-foreground="text" on-press="machine_pick:{machine.target}">
                      <row grow="1" gap="8" cross="center">
                        <if test="{machine.highlighted}"><spacer width="2" height="24" background="accent" /></if>
                        <else><spacer width="2" height="24" /></else>
                        <column grow="1" gap="4">
                          <row gap="8" cross="center">
                            <text grow="1" overflow="ellipsis">{machine.name}</text>
                            <text foreground="text_muted">{machine.status}</text>
                          </row>
                          <text foreground="text_muted" overflow="ellipsis">{machine.endpoint}</text>
                          <if test="{machine.message}"><text wrap="true" foreground="warning">{machine.message}</text></if>
                          <row gap="8" cross="center">
                            <text foreground="text_muted">{machine.action}</text>
                            <spacer grow="1" />
                            <if test="{machine.canDisconnect}"><button size="sm" variant="ghost" on-press="machine_disconnect:{machine.target}">Disconnect</button></if>
                            <if test="{machine.canForget}"><button size="sm" variant="ghost" on-press="machine_forget:{machine.target}">Forget…</button></if>
                          </row>
                        </column>
                      </row>
                    </list-item>
                  </for>
                </list>
                <if test="{machines.hasMore}"><button size="sm" variant="ghost" on-press="machines_more">Load more machines</button></if>
              </column>
            </if>
            <else>
            <list gap="0" label="Terminals and sessions">
              <for each="paletterows" key="target" as="row">
                <list-item height="40" label="{row.label}" selected="{row.highlighted}" disabled="{row.disabled}" accent="surface_pressed" accent-foreground="text" on-press="palette_pick:{row.target}">
                  <row grow="1" gap="8" cross="center">
                    <if test="{row.highlighted}"><spacer width="2" height="24" background="accent" /></if>
                    <else><spacer width="2" height="24" /></else>
                    <column grow="1" gap="0">
                      <text overflow="ellipsis">{row.label}</text>
                      <if test="{row.detail}"><text foreground="text_muted" overflow="ellipsis">{row.detail}</text></if>
                    </column>
                    <if test="{row.current}"><text foreground="accent">Current</text></if>
                  </row>
                  <!-- A session row's own actions: Rename goes to the coordinator
                       that listed the row, by the row's captured target. -->
                  <context-menu>
                    <if test="{row.renamable}">
                      <menu-item on-press="rename_row:{row.target}">Rename Session…</menu-item>
                    </if>
                  </context-menu>
                </list-item>
              </for>
            </list>
            </else>
            </else>
            </scroll>
            <if test="{navigatorView == 2}">
              <if test="{toolQueued}">
                <row gap="8" cross="center">
                  <text grow="1" wrap="true">Finish authentication in the setup terminal, then recheck your saved machines.</text>
                  <button size="sm" on-press="tool_recheck">Recheck</button>
                </row>
              </if>
              <text wrap="true" foreground="text_muted">{machines.notice}</text>
              <if test="{machines.forgetTarget}">
                <panel padding="12">
                  <column gap="8">
                    <text wrap="true">Forget saved machine {machines.forgetName}?</text>
                    <text wrap="true" foreground="text_muted">This removes the saved entry. Running work on the machine is retained.</text>
                    <row gap="8" main="end">
                      <button size="sm" variant="ghost" on-press="machine_forget_cancel">Cancel</button>
                      <button size="sm" on-press="machine_forget_confirm">Forget Machine</button>
                    </row>
                  </column>
                </panel>
              </if>
            </if>
            <text foreground="text_muted">{palettenotice}</text>
            <row gap="8" cross="center">
              <if test="{paletteprevious}"><button size="sm" variant="ghost" on-press="palette_previous">Previous</button></if>
              <spacer grow="1" />
              <if test="{navigatorView == 1}"><button size="sm" icon="plus" on-press="new_session_open">New Session…</button></if>
              <if test="{navigatorView == 2}"><button size="sm" variant="ghost" icon="plus" on-press="add_machine_open">Add Machine…</button></if>
              <if test="{navigatorView != 4}"><button size="sm" variant="ghost" on-press="palette_retry">Refresh</button></if>
              <if test="{palettenext}"><button size="sm" variant="ghost" on-press="palette_next">Next</button></if>
            </row>
          </column>
        </dialog>
    </if>
    <slot />
  </stack>
</template>

<!-- Connect to Host, presented by whichever window invoked it. A template of
     its own rather than an argument of cockpit-window: the live markup
     interpreter spends one scope entry per template argument and allows 16,
     and cockpit-window's tab loop already sits at that bound. -->
<template name="cockpit-host" args="hostopen">
  <stack>
    <if test="{hostopen}">
      <row main="center" cross="start" padding="16">
        <panel grow="1" max-width="640" padding="16">
          <column gap="8">
            <row cross="center" gap="8">
              <icon name="external-link" width="16" height="16" />
              <if test="{toolPurpose == 1}"><text grow="1" size="heading">Add Machine</text></if>
              <else><if test="{toolPurpose == 2}"><text grow="1" size="heading">Edit Configuration</text></if>
              <else><text grow="1">Connect to Host</text></else></else>
              <button size="sm" variant="ghost" icon="x" label="Close Connect to Host" on-press="host_close" />
            </row>
            <if test="{toolPurpose != 2}">
              <input text="{hostQuery}" placeholder="Hostname or SSH destination" autofocus="true" on-input="host_edit" on-submit="host_submit" label="Machine destination" />
            </if>
            <if test="{toolPurpose == 1}">
              <input text="{hostFriendlyName}" placeholder="Friendly name" on-input="host_name_edit" on-submit="tool_submit" label="Machine name" />
              <text wrap="true" foreground="text_muted">Set up authentication in a dedicated terminal on This Mac. When setup finishes, return to Machines and choose Recheck.</text>
            </if>
            <if test="{toolPurpose == 2}">
              <text wrap="true">{toolTarget}</text>
              <text wrap="true" foreground="text_muted">The configuration editor opens in a new local Phux terminal.</text>
            </if>
            <text wrap="true" foreground="text_muted">{hostNotice}</text>
            <row gap="8" cross="center">
              <if test="{toolPurpose == 0}">
                <button size="sm" variant="ghost" on-press="host_local">Use this Mac</button>
                <button size="sm" variant="ghost" on-press="host_disconnect">Disconnect</button>
                <button size="sm" variant="ghost" on-press="host_disconnect_all">Disconnect All</button>
              </if>
              <spacer grow="1" />
              <button size="sm" variant="ghost" on-press="host_close">Cancel</button>
              <if test="{toolPurpose == 1}"><button size="sm" disabled="{hostBusy}" on-press="tool_submit">Open Setup Terminal</button></if>
              <else><if test="{toolPurpose == 2}"><button size="sm" variant="ghost" on-press="settings_open">Choose Editor in Settings</button></if>
              <else><button size="sm" on-press="host_submit">Connect</button></else></else>
            </row>
          </column>
        </panel>
      </row>
    </if>
  </stack>
</template>
<template name="cockpit-agents" args="open rows notice previous next status">
  <stack>
    <if test="{open}">
      <!-- Geist sm/md insets; detail viewport = four default 40pt bands. -->
      <row main="center" cross="start" padding="8">
        <panel width="520" padding="12">
          <column gap="8">
            <row cross="center" gap="8">
              <text grow="1" size="heading">Agents</text>
              <button size="sm" variant="ghost" icon="x" label="Close agent inspector" on-press="palette_close" />
            </row>
            <scroll height="160" label="Agent inspection details">
              <column gap="8">
                <text wrap="true" foreground="text_muted">{notice}</text>
                <text wrap="true" foreground="text_muted">{status}</text>
                <for each="rows" key="id" as="agent">
                  <column gap="4">
                    <text wrap="true">{agent.label}</text>
                    <if test="{agent.kind == 1}">
                      <text foreground="text_muted">Detected terminal identity</text>
                      <text foreground="text_muted">Terminal</text>
                      <text wrap="true" label="{agent.resource}">{agent.resource}</text>
                      <text foreground="text_muted">Native session ID</text>
                      <if test="{agent.nativeId}"><text wrap="true" label="{agent.nativeId}">{agent.nativeId}</text></if>
                      <else><text foreground="text_muted">Not reported</text></else>
                      <text wrap="true" foreground="text_muted" label="{agent.evidence}">{agent.evidence}</text>
                    </if>
                    <else>
                      <text foreground="text_muted">AgentSession resource</text>
                      <text foreground="text_muted">Resource</text>
                      <text wrap="true" label="{agent.resource}">{agent.resource}</text>
                      <text foreground="text_muted">Parent</text>
                      <text wrap="true" label="{agent.parent}">{agent.parent}</text>
                      <text foreground="text_muted">Native ID</text>
                      <text wrap="true" label="{agent.nativeId}">{agent.nativeId}</text>
                      <text wrap="true" foreground="text_muted" label="{agent.evidence}">{agent.evidence}</text>
                    </else>
                  </column>
                </for>
              </column>
            </scroll>
            <for each="rows" key="id" as="agent">
              <if test="{agent.index != 65535}"><button size="sm" autofocus="true" on-press="palette_submit">Jump to parent</button></if>
              <else><text foreground="text_muted">Parent unavailable</text></else>
            </for>
            <row gap="8" cross="center">
              <if test="{previous}"><button size="sm" variant="ghost" on-press="palette_previous">Previous agent</button></if>
              <spacer grow="1" />
              <button size="sm" variant="ghost" on-press="palette_retry">Refresh</button>
              <if test="{next}"><button size="sm" variant="ghost" on-press="palette_next">Next agent</button></if>
            </row>
          </column>
        </panel>
      </row>
    </if>
  </stack>
</template>


<!-- Rename Session, presented by whichever window invoked it. The engine
     names the session on screen and the coordinator that owns it; the new
     name is written there and nowhere else. -->
<template name="cockpit-rename" args="renameopen">
  <stack>
    <if test="{renameopen}">
      <row main="center" cross="start" padding="16">
        <panel grow="1" max-width="640" padding="16">
          <column gap="8">
            <row cross="center" gap="8">
              <text grow="1" overflow="ellipsis">{renameTitle}</text>
              <button size="sm" variant="ghost" icon="x" label="Close Rename Session" on-press="rename_close" />
            </row>
            <input text="{renameQuery}" placeholder="New session name" autofocus="true" on-input="rename_edit" on-submit="rename_submit" label="New session name" />
            <text wrap="true" foreground="text_muted">{renameNotice}</text>
            <row gap="8" cross="center">
              <spacer grow="1" />
              <button size="sm" variant="ghost" on-press="rename_close">Cancel</button>
              <if test="{creatingSession}"><button size="sm" disabled="{renameBusy}" on-press="rename_submit">Create Session</button></if>
              <else><button size="sm" disabled="{renameBusy}" on-press="rename_submit">Rename</button></else>
            </row>
          </column>
        </panel>
      </row>
    </if>
  </stack>
</template>

<!-- The Empty session state (ADR-0105): a keep-empty session with no
     windows, offered with New Tab instead of treated as broken, in the
     window the snapshot names. A peer's session picked in the switcher can be
     dismissed; nothing attaches it until New Tab. -->
<template name="cockpit-empty" args="emptyopen name detail picked">
  <stack>
    <if test="{emptyopen}">
      <column>
        <!-- Match the header and side rail; an empty session leaves both usable. -->
        <spacer height="50" />
        <row cross="start">
          <if test="{tabPlacement == 'side'}"><spacer width="224" /></if>
          <row grow="1" main="center" cross="start" padding="16">
            <!-- Chrome ink must retain its own surface over arbitrary VT themes. -->
            <column grow="1" max-width="640" padding="16" gap="8" background="surface">
              <row cross="center" gap="8">
                <icon name="terminal" width="16" height="16" />
                <text grow="1" size="heading" overflow="ellipsis">{name}</text>
                <if test="{picked}"><button size="sm" variant="ghost" icon="x" label="Dismiss empty session" on-press="empty_dismiss" /></if>
              </row>
              <text foreground="text_muted" overflow="ellipsis">{detail}</text>
              <if test="{emptyBusy}">
                <row><button size="sm" disabled="true" on-press="empty_new_tab">Opening…</button></row>
              </if>
              <else>
                <if test="{emptyNotice}"><text wrap="true" foreground="warning">{emptyNotice}</text></if>
                <row><button size="sm" on-press="empty_new_tab">New Tab</button></row>
              </else>
            </column>
          </row>
        </row>
      </column>
    </if>
  </stack>
</template>

<!-- Go to Directory, presented by whichever window invoked it. The listing
     is the connected coordinator's, so a remote host lists its own
     directories. Rows name listing indices; the engine composes paths. -->
<template name="cockpit-directory" args="diropen">
  <stack>
    <if test="{diropen}">
      <row main="center" cross="start" padding="16">
        <panel grow="1" max-width="640" padding="16">
          <column gap="8">
            <row cross="center" gap="8">
              <icon name="folder" width="16" height="16" />
              <text grow="1" overflow="ellipsis">{dirTitle}</text>
              <button size="sm" variant="ghost" icon="x" label="Close Go to Directory" on-press="dir_close" />
            </row>
            <text foreground="text_muted" overflow="ellipsis">{dirPath}</text>
            <input text="{dirQuery}" placeholder="Filter directories" autofocus="true" on-input="dir_edit" on-submit="dir_submit" label="Filter directories" />
            <list gap="0" label="Directories">
              <for each="dirRows" key="id" as="row">
                <list-item height="40" label="{row.label}" selected="{row.highlighted}" accent="surface_pressed" accent-foreground="text" on-press="dir_pick:{row.index}">
                  <row grow="1" gap="8" cross="center">
                    <if test="{row.highlighted}"><spacer width="2" height="24" background="accent" /></if>
                    <else><spacer width="2" height="24" /></else>
                    <text grow="1" overflow="ellipsis">{row.label}</text>
                  </row>
                </list-item>
              </for>
            </list>
            <text foreground="text_muted">{dirNotice}</text>
            <row gap="8" cross="center">
              <if test="{dirPrevious}"><button size="sm" variant="ghost" on-press="dir_previous">Previous</button></if>
              <if test="{dirNext}"><button size="sm" variant="ghost" on-press="dir_next">Next</button></if>
              <spacer grow="1" />
              <button size="sm" variant="ghost" on-press="dir_close">Cancel</button>
              <button size="sm" on-press="dir_here">Open Here</button>
            </row>
          </column>
        </panel>
      </row>
    </if>
  </stack>
</template>
