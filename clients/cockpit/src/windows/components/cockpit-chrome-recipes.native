<template name="cockpit-tab-control" args="target label selected">
  <toggle-button size="sm" variant="ghost" role="tab" selected="{selected}" on-toggle="select_target:{target}" grow="1">{label}</toggle-button>
</template>

<template name="cockpit-highlighted-row" args="highlighted">
  <row gap="8" cross="center">
    <if test="{highlighted}"><spacer width="2" height="24" background="accent" /></if>
    <else><spacer width="2" height="24" /></else>
    <slot/>
  </row>
</template>
