<template name="cockpit-connected-hosts" args="menuopen title detail location status">
  <!-- The header's "where am I": this window's session and machine, always
       visible, at a fixed width; core.ts elides the text to that width, so
       a long session name never moves the chrome or clips.
       It opens the host menu, which holds connection state, the connected
       machines, Connect to Host and Machines. -->
  <stack width="216">
    <if test="{canReconnect or commandNotice != ''}">
      <button width="216" size="sm" variant="ghost" icon="alert" foreground="warning" label="Session and machine" selected="{menuopen and headerHosts}" on-press="header_hosts_toggle">{location}</button>
    </if>
    <else>
      <button width="216" size="sm" variant="ghost" icon="chevron-down" icon-placement="trailing" label="Session and machine" selected="{menuopen and headerHosts}" on-press="header_hosts_toggle">{location}</button>
    </else>
    <if test="{commandNotice != '' and canReconnect == false}"><tooltip anchor="below">{commandNotice}</tooltip></if>
    <else><tooltip anchor="below">{status}</tooltip></else>
    <if test="{menuopen and headerHosts}">
      <dropdown-menu width="280" anchor="below" anchor-alignment="end" anchor-offset="8" on-dismiss="header_menu_close" label="Connected hosts">
        <column padding="8" gap="4">
          <text overflow="ellipsis">{title}</text>
          <text foreground="text_muted" overflow="ellipsis">{detail}</text>
          <text foreground="text_muted" overflow="ellipsis">{status}</text>
          <if test="{commandNotice}"><text foreground="warning" overflow="ellipsis">{commandNotice}</text></if>
        </column>
        <separator />
        <if test="{canReconnect}"><menu-item on-press="header_reconnect">Reconnect</menu-item></if>
        <if test="{paletteLoading}">
          <column padding="8"><text foreground="text_muted">Updating hosts…</text></column>
        </if>
        <else>
          <if test="{paletteTotal > 0}">
            <scroll height="128">
              <column>
                <for each="paletteRows" key="id" as="host">
                  <menu-item selected="{host.current}" disabled="{host.disabled}" autofocus="{host.id == 0}" on-press="header_host_pick:{host.target}">{host.label}</menu-item>
                  <text padding="8" foreground="text_muted" overflow="ellipsis">{host.detail}</text>
                </for>
              </column>
            </scroll>
            <if test="{paletteNext}"><menu-item on-press="header_hosts_more">Show more hosts</menu-item></if>
          </if>
          <if test="{paletteNotice}"><column padding="8"><text wrap="true" foreground="text_muted">{paletteNotice}</text></column></if>
        </else>
        <separator />
        <menu-item icon="plus" on-press="header_host_connect">Connect to Host…</menu-item>
        <menu-item icon="external-link" on-press="header_machines">Machines…</menu-item>
        <menu-item icon="folder" on-press="header_sessions">Sessions…</menu-item>
        <menu-item icon="refresh-cw" disabled="{paletteLoading}" on-press="header_hosts_refresh">Refresh hosts</menu-item>
      </dropdown-menu>
    </if>
  </stack>
</template>
