<template name="cockpit-settings" args="settingsopen themes configexists confignotice">
  <stack>
    <if test="{settingsopen}">
      <sheet width="640" padding="16" on-dismiss="settings_close">
          <column gap="16" grow="1">
            <row cross="center" gap="8">
              <text grow="1" size="heading">Settings</text>
              <button size="sm" variant="ghost" icon="x" label="Cancel settings" disabled="{appearanceClosing}" on-press="settings_close" />
            </row>
            <input text="{settingsQuery}" placeholder="Search settings" autofocus="true" on-input="settings_query" label="Search settings" />
            <toggle-group label="Settings groups">
              <for each="settingsSections" key="index" as="section">
                <toggle-button size="sm" selected="{settingsSection == section.index}" on-toggle="settings_section:{section.index}">{section.label}</toggle-button>
              </for>
            </toggle-group>
            <if test="{configEditorConfirm}">
              <panel padding="16">
                <column gap="8">
                  <text wrap="true">Save your preview before editing the configuration file?</text>
                  <row gap="8">
                    <button size="sm" disabled="{appearanceBusy}" on-press="settings_save_edit">Save and Edit</button>
                    <button size="sm" variant="outline" disabled="{appearanceBusy}" on-press="settings_discard_edit">Discard and Edit</button>
                    <button size="sm" variant="ghost" on-press="settings_cancel_edit">Cancel</button>
                  </row>
                </column>
              </panel>
            </if>
            <scroll grow="1">
              <column gap="16">
                <if test="{settingsSection == 2}">
                  <column gap="16">
                    <text wrap="true" foreground="text_muted">Use chords such as super+shift+p. Enter none to remove a shortcut.</text>
                    <if test="{noBindingRows}"><text foreground="text_muted">No matching keyboard shortcuts</text></if>
                    <for each="bindingRows" key="index" as="binding">
                      <column gap="8">
                        <row gap="8" cross="center">
                          <column grow="1" gap="4">
                            <text>{binding.label}</text>
                            <text foreground="text_muted">{binding.binding}</text>
                          </column>
                          <button size="sm" variant="outline" disabled="{appearanceBusy}" on-press="binding_select:{binding.index}">Edit</button>
                          <button size="sm" variant="ghost" disabled="{appearanceBusy}" on-press="binding_reset:{binding.index}">Reset</button>
                        </row>
                        <accordion text="Details" selected="{bindingDetailIndex == binding.index}" on-toggle="binding_detail:{binding.index}">
                          <column gap="8">
                            <text foreground="text_muted">Default: {binding.defaultBinding}</text>
                          </column>
                        </accordion>
                        <if test="{bindingEditIndex == binding.index}">
                          <row gap="8">
                            <input grow="1" text="{bindingEditValue}" label="Keyboard shortcut" on-input="binding_edit" on-submit="binding_apply" />
                            <button size="sm" disabled="{appearanceBusy}" on-press="binding_apply">Preview</button>
                          </row>
                        </if>
                        <separator />
                      </column>
                    </for>
                  </column>
                </if>
                <else><if test="{noSettingRows}"><text foreground="text_muted">No matching settings in this group</text></if></else>
                <for each="settingRows" key="id" as="setting">
                  <column gap="8">
                    <row gap="8" cross="center">
                      <column grow="1" gap="4">
                        <text>{setting.label}</text>
                        <text wrap="true">{setting.effectiveValue}</text>
                        <text foreground="text_muted">{setting.timing}</text>
                      </column>
                      <if test="{setting.editable}">
                        <button size="sm" variant="outline" disabled="{appearanceBusy}" on-press="settings_select:{setting.id}">Edit</button>
                        <button size="sm" variant="ghost" disabled="{appearanceBusy}" on-press="settings_reset:{setting.id}">Reset</button>
                      </if>
                    </row>
                    <accordion text="Details" selected="{settingsDetailId == setting.id}" on-toggle="settings_detail:{setting.id}">
                      <column gap="8">
                        <row gap="8"><text foreground="text_muted">Default</text><text wrap="true">{setting.defaultLabel}</text></row>
                        <text wrap="true" foreground="text_muted">{setting.applicability}</text>
                        <text foreground="text_muted">{setting.timing}</text>
                        <row gap="8"><text foreground="text_muted">Configured</text><text wrap="true">{setting.value}</text></row>
                      </column>
                    </accordion>
                    <if test="{settingEditId == setting.id}">
                      <text wrap="true" foreground="text_muted">{setting.applicability}</text>
                      <row gap="8" cross="center">
                        <input grow="1" text="{settingEditValue}" label="Setting value" on-input="settings_value" on-submit="settings_apply" />
                        <button size="sm" disabled="{appearanceBusy}" on-press="settings_apply">Preview</button>
                      </row>
                    </if>
                    <separator />
                  </column>
                </for>
                <if test="{settingsSection == 0}">
                  <text>Theme presets</text>
                  <grid columns="2" gap="8">
                    <for each="themes" key="index" as="theme">
                      <button size="sm" variant="outline" selected="{theme.highlighted}" disabled="{appearanceBusy}" on-press="settings_pick:{theme.index}">{theme.label}</button>
                    </for>
                  </grid>
                  <if test="{appearance.overrides}"><text wrap="true" foreground="warning">Explicit foreground or background overrides this theme. Edit Configuration to change those keys.</text></if>
                </if>
                <if test="{settingsSection == 4}">
                  <text>Current connection</text>
                  <accordion text="Connection details" selected="{settingsDetailId == 12}" on-toggle="settings_detail:12">
                    <column gap="8">
                      <text wrap="true">{workspaceLabel}</text>
                      <text wrap="true" foreground="text_muted">{coordinatorEndpoint}</text>
                      <text wrap="true" foreground="text_muted">{connectionDetail}</text>
                    </column>
                  </accordion>
                </if>
                <if test="{settingsSection == 5}">
                  <text>Phux Cockpit</text>
                  <row gap="8"><text foreground="text_muted">Installed</text><text>{updateCurrent}</text></row>
                  <row gap="8"><text foreground="text_muted">Latest</text><text>{updateLatest}</text></row>
                  <text wrap="true">{updateStatus}</text>
                  <if test="{updateRemedy}"><text wrap="true" foreground="text_muted">{updateRemedy}</text></if>
                  <row gap="8">
                    <button size="sm" variant="outline" disabled="{updateBusy}" on-press="update_check">Check for Updates</button>
                    <if test="{updateCanInstall}"><button size="sm" disabled="{updateBusy}" on-press="update_install">Install</button></if>
                  </row>
                </if>
                <text wrap="true" foreground="text_muted">{confignotice}</text>
                <row gap="8">
                  <button size="sm" variant="outline" on-press="settings_edit_configuration">Edit Configuration</button>
                  <button size="sm" variant="ghost" disabled="{appearanceBusy}" on-press="settings_reload">Reload Configuration</button>
                </row>
              </column>
            </scroll>
            <if test="{appearance.notice}"><text wrap="true" foreground="warning">{appearance.notice}</text></if>
            <if test="{settingsNotice}"><text wrap="true" foreground="warning">{settingsNotice}</text></if>
            <separator />
            <row gap="8" cross="center">
              <if test="{appearance.dirty}"><text foreground="text_muted">Unsaved preview</text></if>
              <else><text foreground="text_muted">{appearance.contrastLabel}</text></else>
              <spacer grow="1" />
              <button size="sm" variant="ghost" disabled="{appearanceClosing}" on-press="settings_close">Cancel</button>
              <button size="sm" disabled="{appearanceBusy}" on-press="settings_commit">Save changes</button>
            </row>
          </column>
      </sheet>
    </if>
  </stack>
</template>
