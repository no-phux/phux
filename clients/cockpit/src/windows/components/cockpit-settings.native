<template name="cockpit-settings" args="settingsopen themes configexists confignotice">
  <stack>
    <if test="{settingsopen}">
      <row main="end" padding="16" background="scrim">
        <panel grow="1" max-width="640" padding="16">
          <column gap="16">
            <row cross="center" gap="8">
              <text grow="1" size="heading">Settings</text>
              <button size="sm" variant="ghost" icon="x" label="Cancel settings" on-press="settings_close" />
            </row>
            <search-field text="{settingsQuery}" placeholder="Search settings" on-input="settings_query" label="Search settings" />
            <tabs gap="8" label="Settings groups">
              <for each="settingsSections" key="index" as="section">
                <button size="sm" variant="ghost" selected="{settingsSection == section.index}" on-press="settings_section:{section.index}">{section.label}</button>
              </for>
            </tabs>
            <if test="{configEditorConfirm}">
              <panel padding="16">
                <column gap="8">
                  <text wrap="true">Save your preview before editing the configuration file?</text>
                  <row gap="8">
                    <button size="sm" disabled="{appearanceBusy}" on-press="settings_save_edit">Save and Edit</button>
                    <button size="sm" variant="outline" disabled="{appearanceBusy}" on-press="settings_discard_edit">Discard and Edit</button>
                    <button size="sm" variant="ghost" on-press="settings_cancel_edit">Cancel</button>
                  </row>
                </column>
              </panel>
            </if>
            <scroll grow="1">
              <column gap="16">
                <if test="{settingsSection == 2}">
                  <column gap="16">
                    <text wrap="true" foreground="text_muted">Use chords such as super+shift+p. Enter none to remove a shortcut.</text>
                    <if test="{noBindingRows}"><text foreground="text_muted">No matching keyboard shortcuts</text></if>
                    <for each="bindingRows" key="index" as="binding">
                      <column gap="8">
                        <row gap="8" cross="center">
                          <text grow="1">{binding.label}</text>
                          <text foreground="text_muted">{binding.binding}</text>
                          <button size="sm" variant="outline" disabled="{appearanceBusy}" on-press="binding_select:{binding.index}">Edit</button>
                          <button size="sm" variant="ghost" disabled="{appearanceBusy}" on-press="binding_reset:{binding.index}">Reset</button>
                        </row>
                        <text foreground="text_muted">Default: {binding.defaultBinding}</text>
                        <if test="{bindingEditIndex == binding.index}">
                          <row gap="8">
                            <input grow="1" text="{bindingEditValue}" label="Keyboard shortcut" on-input="binding_edit" on-submit="binding_apply" />
                            <button size="sm" disabled="{appearanceBusy}" on-press="binding_apply">Preview</button>
                          </row>
                        </if>
                        <separator />
                      </column>
                    </for>
                  </column>
                </if>
                <else><if test="{noSettingRows}"><text foreground="text_muted">No matching settings in this group</text></if></else>
                <for each="settingRows" key="id" as="setting">
                  <if test="{setting.editable}">
                    <column gap="8">
                      <row gap="8" cross="center">
                        <text grow="1">{setting.label}</text>
                        <if test="{setting.control == 0}"><button size="sm" variant="outline" disabled="{appearanceBusy or setting.available == false}" on-press="settings_select:{setting.id}">Edit</button></if>
                        <button size="sm" variant="ghost" disabled="{appearanceBusy or setting.available == false}" on-press="settings_reset:{setting.id}">Reset</button>
                      </row>
                      <if test="{setting.control == 1}">
                        <!-- Explicit values keep native replies authoritative; switch reconciliation is tracked in phux-3gpg.3. -->
                        <if test="{setting.available}">
                          <radio-group gap="8" label="{setting.label}">
                            <radio checked="{setting.checked}" disabled="{appearanceBusy}" on-change="settings_enable:{setting.id}">On</radio>
                            <radio checked="{setting.unchecked}" disabled="{appearanceBusy}" on-change="settings_disable:{setting.id}">Off</radio>
                          </radio-group>
                        </if>
                        <else><text foreground="text_muted">Current value unavailable</text></else>
                      </if>
                      <if test="{setting.control == 2}">
                        <if test="{setting.available}">
                        <radio-group gap="8" label="Font family">
                          <for each="fontChoices" key="index" as="choice"><radio checked="{choice.selected}" disabled="{appearanceBusy}" on-change="settings_font_family:{choice.index}">{choice.label}</radio></for>
                        </radio-group>
                        <text wrap="true" foreground="text_muted">{setting.effectiveValue}</text>
                        </if>
                        <else><text foreground="text_muted">Current font family unavailable</text></else>
                      </if>
                      <if test="{setting.control == 3}">
                        <radio-group gap="8" label="Cursor style">
                          <for each="cursorChoices" key="index" as="choice"><radio checked="{choice.selected}" disabled="{appearanceBusy or setting.available == false}" on-change="settings_cursor:{choice.index}">{choice.label}</radio></for>
                        </radio-group>
                      </if>
                      <if test="{setting.control == 4}">
                        <radio-group gap="8" label="Tab placement">
                          <for each="placementChoices" key="index" as="choice"><radio checked="{choice.selected}" disabled="{appearanceBusy or setting.available == false}" on-change="settings_placement:{choice.index}">{choice.label}</radio></for>
                        </radio-group>
                      </if>
                      <if test="{setting.control == 5}">
                        <row gap="8" cross="center">
                          <button size="sm" variant="outline" disabled="{appearanceBusy or setting.available == false}" on-press="settings_font:{fontDecrease}" label="Decrease font size">−</button>
                          <text>{appearance.fontLabel}</text>
                          <button size="sm" variant="outline" disabled="{appearanceBusy or setting.available == false}" on-press="settings_font:{fontIncrease}" label="Increase font size">+</button>
                        </row>
                      </if>
                      <if test="{setting.control == 0}"><if test="{settingEditId == setting.id}">
                        <row gap="8" cross="center">
                          <input grow="1" text="{settingEditValue}" disabled="{appearanceBusy or setting.available == false}" label="Setting value" on-input="settings_value" on-submit="settings_apply" />
                          <button size="sm" disabled="{appearanceBusy or setting.available == false}" on-press="settings_apply">Preview</button>
                        </row>
                      </if><else><text wrap="true" foreground="text_muted">{setting.effectiveValue}</text></else></if>
                      <text wrap="true" foreground="text_muted">{setting.applicability} · {setting.timing}</text>
                      <separator />
                    </column>
                  </if>
                </for>
                <if test="{settingsSection == 0}">
                  <text>Theme presets</text>
                  <grid columns="2" gap="8">
                    <for each="themes" key="index" as="theme">
                      <button size="sm" variant="outline" selected="{theme.highlighted}" disabled="{appearanceBusy}" on-press="settings_pick:{theme.index}">{theme.label}</button>
                    </for>
                  </grid>
                  <if test="{appearance.overrides}"><text wrap="true" foreground="warning">Explicit foreground or background overrides this theme. Edit Configuration to change those keys.</text></if>
                  <text wrap="true" foreground="text_muted">{confignotice}</text>
                  <row gap="8">
                    <button size="sm" variant="outline" on-press="settings_edit_configuration">Edit Configuration</button>
                    <button size="sm" variant="ghost" disabled="{appearanceBusy}" on-press="settings_reload">Reload Configuration</button>
                  </row>
                </if>
                <if test="{settingsSection == 4}">
                  <text wrap="true">{workspaceLabel}</text>
                  <if test="{coordinatorEndpoint}"><text wrap="true" foreground="text_muted">{coordinatorEndpoint}</text></if>
                  <if test="{connectionDetail}"><text wrap="true" foreground="text_muted">{connectionDetail}</text></if>
                  <button size="sm" on-press="sessions_open">Sessions</button>
                  <text wrap="true" foreground="text_muted">Shell and history for phux panes live on the serving machine. Change them with phux config or TUI Settings there.</text>
                </if>
                <if test="{settingsSection == 5}">
                  <text>phux Cockpit</text>
                  <row gap="8"><text foreground="text_muted">Installed</text><text>{updateCurrent}</text></row>
                  <row gap="8"><text foreground="text_muted">Latest</text><text>{updateLatest}</text></row>
                  <text wrap="true">{updateStatus}</text>
                  <if test="{updateRemedy}"><text wrap="true" foreground="text_muted">{updateRemedy}</text></if>
                  <row gap="8">
                    <button size="sm" variant="outline" disabled="{updateBusy}" on-press="update_check">Check for Updates</button>
                    <if test="{updateCanInstall}"><button size="sm" disabled="{updateBusy}" on-press="update_install">Install</button></if>
                  </row>
                </if>
              </column>
            </scroll>
            <if test="{appearance.notice}"><text wrap="true" foreground="warning">{appearance.notice}</text></if>
            <if test="{settingsNotice}"><text wrap="true" foreground="warning">{settingsNotice}</text></if>
            <separator />
            <row gap="8" cross="center">
              <if test="{settingsFooterSave}">
                <if test="{appearance.dirty}"><text foreground="text_muted">Unsaved preview</text></if>
                <else><text foreground="text_muted">{appearance.contrastLabel}</text></else>
                <spacer grow="1" />
                <button size="sm" variant="ghost" on-press="settings_close">Cancel</button>
                <button size="sm" disabled="{appearanceBusy}" on-press="settings_commit">Save changes</button>
              </if>
              <else>
                <spacer grow="1" />
                <button size="sm" variant="ghost" on-press="settings_close">Done</button>
              </else>
            </row>
          </column>
        </panel>
      </row>
    </if>
  </stack>
</template>
