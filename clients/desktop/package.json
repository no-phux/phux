{
  "name": "@phux/desktop",
  "version": "0.27.2",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c oxlint.config.ts --type-aware --deny-warnings --report-unused-disable-directives-severity error --ignore-pattern 'tests/tooling/negative/**' --ignore-pattern 'native/**' .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:tooling": "bun test tests/tooling/tooling.test.ts tests/tooling/qualification.test.ts tests/framework/process.test.ts tests/desktop-demo.test.ts",
    "test:rules": "node tools/oxlint/anti-slop/rules/no-chained-type-assertions.test.ts && node tools/oxlint/anti-slop/rules/no-module-mocking.test.ts && node tools/oxlint/anti-slop/rules/require-safety-comment-for-type-assertion.test.ts",
    "check:tooling": "bun run format:check && bun run typecheck && bun run lint && bun run test:rules && bun run test:tooling"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "1.4.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2"
  },
  "engines": {
    "bun": "1.4.2",
    "node": "24.x"
  },
  "packageManager": "bun@1.4.2"
}
