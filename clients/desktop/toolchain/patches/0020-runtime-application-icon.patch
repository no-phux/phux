+    fn set_app_icon(&self, png: &[u8]) -> Result<()> {
+        // SAFETY: App calls this on its UI thread. NSData copies the bytes;
+        // NSImage is owned until AppKit retains it as applicationIconImage.
+        unsafe {
+            use cocoa::foundation::NSData;
+            let data = NSData::dataWithBytes_length_(nil, png.as_ptr().cast(), png.len() as u64);
+            let image: id = msg_send![class!(NSImage), alloc];
+            let image: id = msg_send![image, initWithData: data];
+            anyhow::ensure!(image != nil, "Invalid application icon PNG");
+            let app: id = msg_send![APP_CLASS, sharedApplication];
+            let _: () = msg_send![app, setApplicationIconImage: image];
+            let _: () = msg_send![image, release];
+        }
+        Ok(())
+    }
