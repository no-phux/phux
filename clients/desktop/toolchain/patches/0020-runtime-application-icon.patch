+fn set_window_icon(hwnd: HWND, icon: HICON) {
+    // SAFETY: platform-owned windows are updated on their UI thread. The caller
+    // retains the HICON until both small and large icons have been replaced.
+    unsafe {
+        for size in [ICON_SMALL, ICON_BIG] {
+            SendMessageW(
+                hwnd,
+                WM_SETICON,
+                Some(WPARAM(size as usize)),
+                Some(LPARAM(icon.0 as isize)),
+            );
+        }
+    }
