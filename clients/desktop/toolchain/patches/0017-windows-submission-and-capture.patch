+#[cfg(test)]
+mod evidence_tests {
+    use super::{
+        DXGI_ERROR_DEVICE_REMOVED, DXGI_STATUS_OCCLUDED, S_OK, report_submission, straight_rgba,
+    };
+
+    #[test]
+    fn successful_presents_have_unique_submission_only_receipts() {
+        let (sender, receiver) = std::sync::mpsc::channel();
+        let first = report_submission(
+            S_OK,
+            Some(Box::new(move |id, confirmed| {
+                sender.send((id, confirmed)).unwrap();
+            })),
+        )
+        .unwrap()
+        .unwrap();
+        assert_eq!(receiver.recv().unwrap(), (first, false));
+        assert!(receiver.recv().is_err(), "callback runs exactly once");
+        let second = report_submission(S_OK, None).unwrap().unwrap();
+        assert_ne!(first, second);
+    }
+
+    #[test]
+    fn occlusion_and_failed_presents_never_report_a_drawable() {
+        for status in [DXGI_STATUS_OCCLUDED, DXGI_ERROR_DEVICE_REMOVED] {
+            let (sender, receiver) = std::sync::mpsc::channel();
+            let receipt = report_submission(
+                status,
+                Some(Box::new(move |id, confirmed| {
+                    sender.send((id, confirmed)).unwrap();
+                })),
+            );
+            if status == DXGI_STATUS_OCCLUDED {
+                assert!(receipt.unwrap().is_none());
+            } else {
+                assert!(receipt.is_err());
+            }
+            assert!(receiver.recv().is_err(), "failed callback must be dropped");
+        }
+    }
+
+    #[test]
+    fn capture_converts_bgra_to_straight_rgba() {
+        let mut pixels = [64, 32, 16, 128, 6, 5, 4, 255, 9, 8, 7, 0, 2, 1, 0, 1];
+        straight_rgba(&mut pixels);
+        assert_eq!(
+            pixels,
+            [32, 64, 128, 128, 4, 5, 6, 255, 0, 0, 0, 0, 0, 255, 255, 1]
+        );
+    }
+}
