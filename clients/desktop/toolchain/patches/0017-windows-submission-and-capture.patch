+/// DXGI success statuses such as OCCLUDED are not successful submissions.
+/// Even S_OK only queues a present; it never confirms display of this frame.
+fn report_submission(
+    status: windows::core::HRESULT,
+    on_presented: Option<Box<dyn FnOnce(u64, bool) + Send>>,
+) -> Result<Option<u64>> {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static NEXT_SUBMISSION: AtomicU64 = AtomicU64::new(1);
+    status.ok().context("Presenting swap chain failed")?;
+    if status != S_OK {
+        return Ok(None);
+    }
+    let Ok(id) =
+        NEXT_SUBMISSION.try_update(Ordering::Relaxed, Ordering::Relaxed, |id| id.checked_add(1))
+    else {
+        return Ok(None);
+    };
+    if let Some(callback) = on_presented {
+        callback(id, false);
+    }
+    Ok(Some(id))
+}
+
+fn map_capture(
+    context: &ID3D11DeviceContext,
+    staging: &ID3D11Texture2D,
+) -> Result<D3D11_MAPPED_SUBRESOURCE> {
+    use std::time::{Duration, Instant};
+    let deadline = Instant::now() + Duration::from_secs(30);
+    // Submit the copy before polling; DO_NOT_WAIT prevents a lost/hung GPU
+    // from blocking the UI thread indefinitely inside Map.
+    unsafe { context.Flush() };
+    loop {
+        let mut mapped = D3D11_MAPPED_SUBRESOURCE::default();
+        match unsafe {
+            context.Map(
+                staging,
+                0,
+                D3D11_MAP_READ,
+                D3D11_MAP_FLAG_DO_NOT_WAIT.0 as u32,
+                Some(&mut mapped),
+            )
+        } {
+            Ok(()) => return Ok(mapped),
+            Err(error) if error.code() == DXGI_ERROR_WAS_STILL_DRAWING => {
+                anyhow::ensure!(
+                    Instant::now() < deadline,
+                    "D3D11 capture timed out after 30 seconds"
+                );
+                std::thread::sleep(Duration::from_millis(1));
+            }
+            Err(error) => return Err(error).context("Mapping D3D11 capture"),
+        }
+    }
+}
+
+fn read_staging_image(
+    context: &ID3D11DeviceContext,
+    staging: &ID3D11Texture2D,
+    width: u32,
+    height: u32,
+) -> Result<image::RgbaImage> {
+    let row_bytes = (width as usize)
+        .checked_mul(4)
+        .context("capture row size overflow")?;
+    let len = row_bytes
+        .checked_mul(height as usize)
+        .context("capture image size overflow")?;
+    let mut pixels = vec![0u8; len];
+    let mapped = map_capture(context, staging)?;
+    if mapped.pData.is_null() || (mapped.RowPitch as usize) < row_bytes {
+        unsafe { context.Unmap(staging, 0) };
+        anyhow::bail!("invalid D3D11 capture mapping");
+    }
+    // SAFETY: Map succeeded and RowPitch >= row_bytes. The staging texture's
+    // dimensions are width/height; the mapping outlives these disjoint copies.
+    unsafe {
+        let src = mapped.pData as *const u8;
+        for row in 0..height as usize {
+            std::ptr::copy_nonoverlapping(
+                src.add(row * mapped.RowPitch as usize),
+                pixels.as_mut_ptr().add(row * row_bytes),
+                row_bytes,
+            );
+        }
+        context.Unmap(staging, 0);
+    }
+    // D3D's UNORM target holds premultiplied BGRA. PNG/image consumers
+    // expect straight RGBA (no sRGB conversion for this UNORM target).
+    straight_rgba(&mut pixels);
+    image::RgbaImage::from_raw(width, height, pixels)
+        .context("Failed to build RgbaImage from staging readback")
+}
+
+fn straight_rgba(pixels: &mut [u8]) {
+    for pixel in pixels.chunks_exact_mut(4) {
+        pixel.swap(0, 2);
+        let alpha = u32::from(pixel[3]);
+        if alpha == 0 {
+            pixel[..3].fill(0);
+            continue;
+        }
+        for channel in &mut pixel[..3] {
+            *channel = ((u32::from(*channel) * 255 + alpha / 2) / alpha).min(255) as u8;
+        }
+    }
+}
