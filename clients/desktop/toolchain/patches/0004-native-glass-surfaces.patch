+    fn set_glass_effect(&self, corner_radius: Pixels, appearance: WindowAppearance) -> bool {
+        let Some(class) = Class::get("NSGlassEffectView") else {
+            return false;
+        };
+        let (native_window, native, existing, blur) = {
+            let mut this = self.0.lock();
+            this.renderer.update_transparency(true);
+            (
+                this.native_window,
+                this.native_view.as_ptr(),
+                this.glass_view,
+                this.blurred_view.take(),
+            )
+        };
+        // SAFETY: this method runs on the main thread and the window owns these
+        // views. Do not hold the state mutex across AppKit calls: reparenting or
+        // changing appearance can synchronously reenter GPUIView callbacks.
+        unsafe {
+            let name = match appearance {
+                WindowAppearance::Light | WindowAppearance::VibrantLight => "NSAppearanceNameAqua",
+                WindowAppearance::Dark | WindowAppearance::VibrantDark => {
+                    "NSAppearanceNameDarkAqua"
+                }
+            };
+            let appearance: id = msg_send![class!(NSAppearance), appearanceNamed: ns_string(name)];
+            let _: () = msg_send![native_window, setAppearance: appearance];
+            if let Some(glass) = existing {
+                let _: () = msg_send![glass, setCornerRadius: corner_radius.as_f32() as f64];
+                return true;
+            }
+            let root = native_window.contentView();
+            let glass: id = msg_send![class, alloc];
+            let glass = NSView::initWithFrame_(glass, NSView::bounds(root));
+            glass.setAutoresizingMask_(NSViewWidthSizable | NSViewHeightSizable);
+            let _: () = msg_send![glass, setStyle: 0isize];
+            let _: () = msg_send![glass, setCornerRadius: corner_radius.as_f32() as f64];
+            let interactive: BOOL =
+                msg_send![glass, respondsToSelector: sel!(setEffectIsInteractive:)];
+            if interactive == YES {
+                let _: () = msg_send![glass, setEffectIsInteractive: YES];
+            }
+            // Keep GPUI's view alive while contentView moves it between owners.
+            let _: id = msg_send![native, retain];
+            let _: () = msg_send![glass, setContentView: native];
+            root.addSubview_(glass);
+            // Moving through a detached contentView can clear first responder.
+            native_window.makeFirstResponder_(native);
+            let _: () = msg_send![native, release];
+            if let Some(blur) = blur {
+                NSView::removeFromSuperview(blur);
+            }
+            self.0.lock().glass_view = Some(glass.autorelease());
+        }
+        true
+    }
+
+    fn set_window_opacity(&self, opacity: f32) {
+        // SAFETY: the native window is alive for this call; UI methods
+        // are called on the main thread and the alpha argument is a scalar.
+        let native_window = self.0.lock().native_window;
+        unsafe {
+            let _: () = msg_send![native_window, setAlphaValue: opacity as f64];
+        }
+    }
+
     fn background_appearance(&self) -> WindowBackgroundAppearance {
         self.0.as_ref().lock().background_appearance
     }
