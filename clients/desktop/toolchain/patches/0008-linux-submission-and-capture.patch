+/// A submission receipt, never a display-presentation receipt. Ids remain
+/// unique across windows and GPU recovery; exhaustion drops the receipt.
+fn report_submission(
+    submitted: bool,
+    on_presented: Option<Box<dyn FnOnce(u64, bool) + Send>>,
+) -> Option<u64> {
+    use std::sync::atomic::{AtomicU64, Ordering};
+    static NEXT_SUBMISSION: AtomicU64 = AtomicU64::new(1);
+    if !submitted {
+        return None;
+    }
+    let id = NEXT_SUBMISSION
+        .try_update(Ordering::Relaxed, Ordering::Relaxed, |id| id.checked_add(1))
+        .ok()?;
+    if let Some(callback) = on_presented {
+        // wgpu present() queues a surface texture; it does not prove that the
+        // compositor displayed it. A Wayland frame callback is not proof either.
+        callback(id, false);
+    }
+    Some(id)
