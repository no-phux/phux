+#[cfg(test)]
+mod adapter_tests {
+    use super::{DXGI_ADAPTER_DESC1, DXGI_ADAPTER_FLAG_SOFTWARE, hardware_adapter_is_usable};
+    use windows::Win32::Graphics::Dxgi::DXGI_ERROR_NOT_FOUND;
+
+    #[test]
+    fn unreadable_and_software_descriptions_do_not_select_hardware() {
+        assert!(!hardware_adapter_is_usable(
+            0,
+            Err(DXGI_ERROR_NOT_FOUND.into())
+        ));
+        let software = DXGI_ADAPTER_DESC1 {
+            Flags: DXGI_ADAPTER_FLAG_SOFTWARE.0 as u32,
+            ..Default::default()
+        };
+        assert!(!hardware_adapter_is_usable(1, Ok(software)));
+        assert!(hardware_adapter_is_usable(
+            2,
+            Ok(DXGI_ADAPTER_DESC1::default())
+        ));
+    }
+}
