+    #[test]
+    fn path_blend_accumulates_source_over_alpha() {
+        let source_over = wgpu::BlendComponent {
+            src_factor: wgpu::BlendFactor::One,
+            dst_factor: wgpu::BlendFactor::OneMinusSrcAlpha,
+            operation: wgpu::BlendOperation::Add,
+        };
+        assert_eq!(PATHS_BLEND.color, source_over);
+        assert_eq!(PATHS_BLEND.alpha, source_over);
+        // Half-blue over half-red: premultiplied RGB is (0.25, 0, 0.5),
+        // alpha is 0.75, and straight RGB is (1/3, 0, 2/3), not (0.25, 0, 0.5).
+        assert_eq!(0.5 + 0.5 * (1.0 - 0.5), 0.75);
+        // On an opaque destination the source-over alpha is still exactly 1:
+        // this corrects transparent targets without changing opaque rendering.
+        assert_eq!(0.5 + 1.0 * (1.0 - 0.5), 1.0);
+    }
