+#[test]
+fn image_source_crop_clamps_filtering_independently_of_the_visibility_mask() {
+    let mut harness = Harness::new().expect("image sampling regression requires Direct3D or WARP");
+    let tile = harness
+        .atlas
+        .get_or_insert_with(
+            AtlasKey::Image(RenderImageParams {
+                image_id: ImageId(10_000),
+                frame_index: 0,
+            }),
+            &mut || {
+                Ok(Some((
+                    device_size(3, 1),
+                    Cow::Owned(vec![0, 0, 255, 255, 0, 255, 0, 255, 255, 0, 0, 255]),
+                )))
+            },
+        )
+        .unwrap()
+        .unwrap();
+    let mut scene = Scene::default();
+    // Two instances also exercise the extended Rust/HLSL structure stride.
+    for (x, mask_width) in [(0., 8.), (32., 30.)] {
+        scene.insert_primitive(PolychromeSprite {
+            order: 0,
+            pad: 1,
+            grayscale: false.into(),
+            opacity: 1.,
+            bounds: sp(x, 0., 30., 10.),
+            content_mask: ContentMask {
+                bounds: sp(x, 0., mask_width, 10.),
+            },
+            corner_radii: Corners::default(),
+            tile,
+            sample_bounds: Bounds::new(point(1., 0.), size(1., 1.)),
+        });
+    }
+    scene.finish();
+    let pixels = harness.render(&scene, device_size(64, 12), rgba(0x00000000));
+    assert_eq!(pixel(&pixels, 64, 4, 4), [0, 255, 0, 255]);
+    assert_eq!(pixel(&pixels, 64, 40, 4), [0, 255, 0, 255]);
+    assert_eq!(pixel(&pixels, 64, 12, 4), [0, 0, 0, 0]);
+}
+
+#[test]
+fn capture_target_alpha_is_source_over_not_additive() {
+    let mut harness = Harness::new().expect("capture alpha regression requires Direct3D or WARP");
+    let mut scene = Scene::default();
+    scene.insert_primitive(quad(sp(0., 0., 16., 16.), Hsla::from(rgba(0x0000ff80))));
+    scene.insert_primitive(quad(sp(0., 0., 16., 16.), Hsla::from(rgba(0xff000080))));
+    scene.finish();
+    let pixels = harness.render(&scene, device_size(16, 16), rgba(0x00000000));
+    let actual = pixel(&pixels, 16, 8, 8);
+    for (actual, expected) in actual.into_iter().zip([128u8, 0, 64, 192]) {
+        assert!(
+            actual.abs_diff(expected) <= 1,
+            "source-over capture: {actual} != {expected}"
+        );
+    }
+}
