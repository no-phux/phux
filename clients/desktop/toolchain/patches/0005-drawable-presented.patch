+fn drawable_viewport(layer: &metal::MetalLayer) -> Size<DevicePixels> {
+    let viewport_size = layer.drawable_size();
+    size(
+        (viewport_size.width.ceil() as i32).into(),
+        (viewport_size.height.ceil() as i32).into(),
+    )
+}
+
+fn observe_drawable_presentation(
+    drawable: &metal::MetalDrawableRef,
+    drawable_id: u64,
+    on_presented: Box<dyn FnOnce(u64, bool) + Send>,
+) {
+    let callback = Mutex::new(Some(on_presented));
+    let block = ConcreteBlock::new(move |presented: &metal::DrawableRef| {
+        let Some(callback) = callback.lock().take() else {
+            return;
+        };
+        let shown =
+            presented.drawable_id() as u64 == drawable_id && presented.presented_time() > 0.0;
+        callback(drawable_id, shown);
+    });
+    let block = block.copy();
+    drawable.add_presented_handler(&block);
+}
+
+fn submit_drawable(
+    presents_with_transaction: bool,
+    command_buffer: &metal::CommandBufferRef,
+    drawable: &metal::MetalDrawableRef,
+) {
+    if presents_with_transaction {
+        command_buffer.commit();
+        command_buffer.wait_until_scheduled();
+        drawable.present();
+        return;
+    }
+    command_buffer.present_drawable(drawable);
+    command_buffer.commit();
+}
