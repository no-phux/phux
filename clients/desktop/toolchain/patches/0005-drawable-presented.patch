+struct DrawableNotice {
+    drawable_id: u64,
+    presented: bool,
+}
+
+async fn deliver_drawable_presentation(
+    cx: &mut AsyncApp,
+    handle: AnyWindowHandle,
+    receiver: oneshot::Receiver<DrawableNotice>,
+    serial: u64,
+    callbacks: Vec<FrameCallback>,
+) {
+    let Ok(notice) = receiver.await else {
+        return;
+    };
+    if !notice.presented {
+        return;
+    }
+    handle
+        .update(cx, |_, window, cx| {
+            if window.presentation_serial.get() != serial || window.removed {
+                return;
+            }
+            if window.submitted_drawable.get() != Some(notice.drawable_id) {
+                return;
+            }
+            if window.platform_window.native_visibility() != NativeVisibility::Visible {
+                return;
+            }
+            for callback in callbacks {
+                callback(window, cx);
+            }
+        })
+        .log_err();
+}
