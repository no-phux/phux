+fn native_window_visibility(window: id) -> gpui::NativeVisibility {
+    if window.is_null() {
+        return gpui::NativeVisibility::Unavailable;
+    }
+    unsafe {
+        let visible: BOOL = msg_send![window, isVisible];
+        let miniaturized: BOOL = msg_send![window, isMiniaturized];
+        let occlusion_visible = window
+            .occlusionState()
+            .contains(NSWindowOcclusionState::NSWindowOcclusionStateVisible);
+        if visible == YES && miniaturized == NO && occlusion_visible {
+            gpui::NativeVisibility::Visible
+        } else {
+            gpui::NativeVisibility::Obscured
+        }
+    }
+}
+
+fn hop_presentation_to_main(
+    on_presented: Box<dyn FnOnce(u64, bool) + Send>,
+) -> Box<dyn FnOnce(u64, bool) + Send> {
+    Box::new(move |drawable_id, presented| {
+        DispatchQueue::main().exec_async(move || on_presented(drawable_id, presented));
+    })
+}
