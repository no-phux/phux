+    pub(crate) fn primitives(&self) -> impl Iterator<Item = Primitive> + '_ {
+        self.sprites.iter().filter_map(|sprite| {
+            let primitive =
+                sprite.primitive(self.offset, &self.content_mask, self.opacity, self.order);
+            (!primitive_is_empty(&primitive)).then_some(primitive)
+        })
+    }
