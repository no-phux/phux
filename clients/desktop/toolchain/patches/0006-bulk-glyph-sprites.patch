+/// A glyph already resolved against one window's sprite atlas, in device
+/// pixels, so it can be painted on later frames without shaping,
+/// rasterizing or an atlas lookup. Made by
+/// [`Window::resolve_glyph`](crate::Window::resolve_glyph) and painted by
+/// [`Window::paint_glyph_sprites`](crate::Window::paint_glyph_sprites); valid
+/// while [`Window::glyph_raster`](crate::Window::glyph_raster) is unchanged.
+#[derive(Clone, Copy, Debug)]
+pub struct GlyphSprite {
+    kind: GlyphSpriteKind,
+    bounds: Bounds<ScaledPixels>,
+    /// The glyph's own clip, intersected with the content mask at paint time.
+    clip: Bounds<ScaledPixels>,
+    /// Monochrome and subpixel colour, before element opacity.
+    color: Hsla,
+    tile: AtlasTile,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum GlyphSpriteKind {
+    Monochrome,
+    Subpixel,
+    Polychrome,
+}
+
+impl GlyphSprite {
+    pub(crate) fn new(
+        kind: GlyphSpriteKind,
+        bounds: Bounds<ScaledPixels>,
+        clip: Bounds<ScaledPixels>,
+        color: Hsla,
+        tile: AtlasTile,
+    ) -> Self {
+        Self {
+            kind,
+            bounds,
+            clip,
+            color,
+            tile,
+        }
+    }
+
+    fn primitive(
+        &self,
+        offset: Point<ScaledPixels>,
+        content_mask: &ContentMask<ScaledPixels>,
+        opacity: f32,
+    ) -> Primitive {
+        let bounds = self.bounds + offset;
+        let content_mask = ContentMask {
+            bounds: (self.clip + offset).intersect(&content_mask.bounds),
+        };
+        match self.kind {
+            GlyphSpriteKind::Monochrome => Primitive::MonochromeSprite(MonochromeSprite {
+                order: 0,
+                pad: 0,
+                bounds,
+                content_mask,
+                color: self.color.opacity(opacity),
+                tile: self.tile,
+                transformation: TransformationMatrix::unit(),
+            }),
+            GlyphSpriteKind::Subpixel => Primitive::SubpixelSprite(SubpixelSprite {
+                order: 0,
+                pad: 0,
+                bounds,
+                content_mask,
+                color: self.color.opacity(opacity),
+                tile: self.tile,
+                transformation: TransformationMatrix::unit(),
+            }),
+            GlyphSpriteKind::Polychrome => Primitive::PolychromeSprite(PolychromeSprite {
+                order: 0,
+                pad: 0,
+                grayscale: false.into(),
+                opacity,
+                bounds,
+                content_mask,
+                corner_radii: Corners::default(),
+                tile: self.tile,
+            }),
+        }
+    }
+}
