+    /// The batch moved by `delta`, content mask included.
+    pub(crate) fn translated(&self, delta: Point<ScaledPixels>) -> Self {
+        let mut batch = self.clone();
+        batch.offset = batch.offset + delta;
+        batch.content_mask.bounds.origin = batch.content_mask.bounds.origin + delta;
+        batch
+    }
+}
+
+/// Whether `primitive` draws nothing: its bounds miss its content mask.
+fn primitive_is_empty(primitive: &Primitive) -> bool {
+    primitive
+        .bounds()
+        .intersect(&primitive.content_mask().bounds)
+        .is_empty()
+}
+
+/// `operations` with every glyph sprite batch replaced by the primitives it
+/// paints, for passes that look at primitives one by one.
+pub(crate) fn expand_glyph_sprites(operations: &[PaintOperation]) -> Vec<PaintOperation> {
+    let mut expanded = Vec::with_capacity(operations.len());
+    for operation in operations {
+        match operation {
+            PaintOperation::GlyphSprites(batch) => {
+                expanded.extend(batch.primitives().map(PaintOperation::Primitive))
+            }
+            PaintOperation::Primitive(primitive) => {
+                expanded.push(PaintOperation::Primitive(primitive.clone()))
+            }
+            PaintOperation::StartLayer(bounds) => expanded.push(PaintOperation::StartLayer(*bounds)),
+            PaintOperation::EndLayer => expanded.push(PaintOperation::EndLayer),
+            PaintOperation::FastRoundedClip(clip) => {
+                expanded.push(PaintOperation::FastRoundedClip(*clip))
+            }
+        }
+    }
+    expanded
