@@ -0,0 +1,86 @@
+//! Startup-only native extensions linked into the same host as GPUIX.
+//!
+//! Install before creating any registry or view. Only a function pointer
+//! crosses threads; factories and their GPUI objects are created on the renderer
+//! thread. This API does not make GPUI entities `Send`.
+
+pub use crate::custom_elements::{
+    custom_surface, CustomElement, CustomElementFactory, CustomElementRegistry, CustomRenderContext,
+};
+pub use crate::renderer::{EventCallback, GpuixView};
+pub use gpui;
+
+use std::sync::Mutex;
+
+pub type Installer = fn(&mut CustomElementRegistry);
+
+#[derive(Default)]
+struct Installation {
+    installer: Option<Installer>,
+    sealed: bool,
+}
+
+impl Installation {
+    fn install(&mut self, installer: Installer) -> Result<(), &'static str> {
+        if self.sealed {
+            return Err("native extensions must be installed before creating a registry");
+        }
+        if self.installer.is_some() {
+            return Err("native extensions already installed");
+        }
+        self.installer = Some(installer);
+        Ok(())
+    }
+}
+
+static INSTALLATION: Mutex<Installation> = Mutex::new(Installation {
+    installer: None,
+    sealed: false,
+});
+
+/// Install once, explicitly, before creating any view/registry. Called after
+/// built-in factories for each default registry; never from a NAPI constructor.
+pub fn install(installer: Installer) -> Result<(), &'static str> {
+    INSTALLATION.lock().unwrap().install(installer)
+}
+
+pub(crate) fn seal_installation() {
+    INSTALLATION.lock().unwrap().sealed = true;
+}
+
+pub(crate) fn install_into(registry: &mut CustomElementRegistry) {
+    let installer = INSTALLATION.lock().unwrap().installer;
+    // Do not hold the startup lock while executing application code.
+    if let Some(installer) = installer {
+        installer(registry);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn empty_installer(_: &mut CustomElementRegistry) {}
+
+    #[test]
+    fn installation_is_once_only() {
+        let mut state = Installation::default();
+        assert!(state.install(empty_installer).is_ok());
+        assert_eq!(
+            state.install(empty_installer),
+            Err("native extensions already installed")
+        );
+    }
+
+    #[test]
+    fn even_an_empty_registry_seals_startup() {
+        let mut state = Installation {
+            sealed: true,
+            ..Installation::default()
+        };
+        assert_eq!(
+            state.install(empty_installer),
+            Err("native extensions must be installed before creating a registry")
+        );
+    }
+}
