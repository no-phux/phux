diff --git a/packages/solid/src/renderer.ts b/packages/solid/src/renderer.ts
index 7c0e6a1..8d1f7b2 100644
--- a/packages/solid/src/renderer.ts
+++ b/packages/solid/src/renderer.ts
@@ -93,5 +93,8 @@ export function resetRender(): void {
   const host = global[RENDER_HOST]
   host?.loop?.stop()
   host?.root?.unmount()
+  // GPUI's profiler journal is a thread-local. Dropping an open window while
+  // that local is already destroyed aborts process exit. Close it first.
+  if (host?.renderer?.isWindowOpen?.() !== false) host?.renderer?.closeWindow?.()
   delete global[RENDER_HOST]
 }
