+//! Keep translated text ahead of later accelerators in the input-only pump.
+
+use windows::Win32::UI::WindowsAndMessaging::{
+    MSG, PM_QS_INPUT, PM_QS_POSTMESSAGE, PM_REMOVE, PeekMessageW, PostQuitMessage, WM_KEYFIRST,
+    WM_KEYLAST, WM_QUIT,
+};
+
+pub(crate) fn drain_input_messages(mut dispatch: impl FnMut(&MSG)) {
+    // A foreground wake may have preceded text already posted by the outer
+    // loop. Drain that text even if the next key is a consumed accelerator.
+    if !drain_posted_keyboard_messages(&mut dispatch) {
+        return;
+    }
+    let mut message = MSG::default();
+    while unsafe { PeekMessageW(&mut message, None, 0, 0, PM_REMOVE | PM_QS_INPUT).as_bool() } {
+        if !dispatch_input_message(&message, &mut dispatch) {
+            return;
+        }
+    }
+}
+
+fn dispatch_input_message(message: &MSG, dispatch: &mut impl FnMut(&MSG)) -> bool {
+    if message.message == WM_QUIT {
+        unsafe { PostQuitMessage(message.wParam.0 as i32) };
+        return false;
+    }
+    dispatch(message);
+    drain_posted_keyboard_messages(dispatch)
+}
+
+fn drain_posted_keyboard_messages(dispatch: &mut impl FnMut(&MSG)) -> bool {
+    let mut message = MSG::default();
+    // TranslateMessage posts WM_CHAR (including UTF-16 surrogate halves).
+    // PM_QS_INPUT alone leaves it behind while Enter can run synchronously.
+    // Restrict the range to keyboard messages: unrelated GPUI task wakes must
+    // remain queued, not recursively enter the foreground-task pump.
+    while unsafe {
+        PeekMessageW(
+            &mut message,
+            None,
+            WM_KEYFIRST,
+            WM_KEYLAST,
+            PM_REMOVE | PM_QS_POSTMESSAGE,
+        )
+        .as_bool()
+    } {
+        // PeekMessage returns WM_QUIT even outside the requested range.
+        if message.message == WM_QUIT {
+            unsafe { PostQuitMessage(message.wParam.0 as i32) };
+            return false;
+        }
+        dispatch(&message);
+    }
+    true
+}
+
+#[cfg(test)]
+#[path = "input_order_tests.rs"]
+mod tests;
diff --git a/gpui-fast-windows/src/fast/input_order_tests.rs b/gpui-fast-windows/src/fast/input_order_tests.rs
