+
+#[cfg(test)]
+mod repeat_tests {
+    use super::*;
+    use cocoa::{base::nil, foundation::NSPoint};
+
+    fn down(stroke: &str) -> KeyDownEvent {
+        KeyDownEvent {
+            keystroke: Keystroke::parse(stroke).expect("stroke"),
+            is_held: true,
+            prefer_character_input: false,
+        }
+    }
+
+    fn repeat_text(
+        event: &KeyDownEvent,
+        text: &str,
+        flags: NSEventModifierFlags,
+    ) -> Option<String> {
+        objc2::rc::autoreleasepool(|_| {
+            // SAFETY: Create and use the NSEvent and its strings within one
+            // autorelease pool. No window, input source, or application is needed.
+            unsafe {
+                let native = NSEvent::keyEventWithType_location_modifierFlags_timestamp_windowNumber_context_characters_charactersIgnoringModifiers_isARepeat_keyCode_(
+                    nil,
+                    NSEventType::NSKeyDown,
+                    NSPoint::new(0., 0.),
+                    flags,
+                    0.,
+                    0,
+                    nil,
+                    crate::ns_string(text),
+                    crate::ns_string(&event.keystroke.key),
+                    YES,
+                    0,
+                );
+                assert!(!native.is_null());
+                printable_repeat_text(native, event)
+            }
+        })
+    }
+
+    #[test]
+    fn repeat_text_preserves_native_caps_lock_and_layout_characters() {
+        use NSEventModifierFlags as F;
+        for (stroke, native_text, flags) in [
+            ("a->a", "A", F::NSAlphaShiftKeyMask),
+            (
+                "shift-a->A",
+                "a",
+                F::NSAlphaShiftKeyMask | F::NSShiftKeyMask,
+            ),
+            ("alt-a->å", "å", F::NSAlternateKeyMask),
+        ] {
+            assert_eq!(
+                repeat_text(&down(stroke), native_text, flags).as_deref(),
+                Some(native_text)
+            );
+        }
+        assert_eq!(
+            repeat_text(&down("space-> "), " ", F::empty()).as_deref(),
+            Some(" ")
+        );
+    }
+
+    #[test]
+    fn repeat_text_excludes_shortcuts_controls_dead_keys_and_initial_presses() {
+        use NSEventModifierFlags as F;
+        for (stroke, text, flags) in [
+            ("cmd-space-> ", " ", F::NSCommandKeyMask),
+            ("cmd-enter->\n", "\r", F::NSCommandKeyMask),
+            ("cmd-tab->\t", "\t", F::NSCommandKeyMask),
+            ("ctrl-space-> ", " ", F::NSControlKeyMask),
+            ("fn-space-> ", " ", F::NSFunctionKeyMask),
+            ("enter->\n", "\r", F::empty()),
+            ("tab->\t", "\t", F::empty()),
+            ("e->e", "", F::empty()),
+            ("left", "\u{f702}", F::empty()),
+        ] {
+            assert_eq!(repeat_text(&down(stroke), text, flags), None, "{stroke:?}");
+        }
+        let mut initial = down("a->a");
+        initial.is_held = false;
+        assert_eq!(repeat_text(&initial, "a", F::empty()), None);
+    }
+}
