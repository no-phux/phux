+/// Text eligible for the press-and-hold opt-out, after IME-first routing and
+/// keybindings have declined the event. Native characters preserve Caps Lock
+/// and keyboard-layout behavior that GPUI's shortcut-oriented key_char omits.
+///
+/// # Safety
+/// `native_event` must be a live NSEvent key-down event.
+pub(crate) unsafe fn printable_repeat_text(
+    native_event: *mut AnyObject,
+    event: &KeyDownEvent,
+) -> Option<String> {
+    let modifiers = event.keystroke.modifiers;
+    if !event.is_held || modifiers.platform || modifiers.control || modifiers.function {
+        return None;
+    }
+    event.keystroke.key_char.as_ref()?;
+    // SAFETY: The caller supplies a live key-down NSEvent. Copy its NSString
+    // before returning so no borrowed native storage escapes the callback.
+    let characters = unsafe { (&*native_event.cast::<NSEvent>()).characters() }?;
+    let text = characters.to_string();
+    if text.is_empty() || text.chars().any(char::is_control) {
+        return None;
+    }
+    Some(text)
+}
