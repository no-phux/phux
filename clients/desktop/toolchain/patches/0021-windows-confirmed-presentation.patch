+pub(crate) fn native_window_visibility(hwnd: HWND) -> NativeVisibility {
+    // Win32 visibility is not a full occlusion test or presentation proof.
+    if !unsafe { IsWindow(Some(hwnd)) }.as_bool() {
+        return NativeVisibility::Unavailable;
+    }
+    if !unsafe { IsWindowVisible(hwnd) }.as_bool() || unsafe { IsIconic(hwnd) }.as_bool() {
+        return NativeVisibility::Obscured;
+    }
+    let mut rect = RECT::default();
+    if unsafe { GetClientRect(hwnd, &mut rect) }.is_err()
+        || rect.right <= rect.left
+        || rect.bottom <= rect.top
+    {
+        return NativeVisibility::Obscured;
+    }
+    NativeVisibility::Visible
+}
