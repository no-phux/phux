+    #[cfg(not(target_family = "wasm"))]
+    fn composite_capture_over_white(mut image: image::RgbaImage, srgb: bool) -> image::RgbaImage {
+        for pixel in image.pixels_mut() {
+            let alpha = f32::from(pixel[3]) / 255.0;
+            for channel in &mut pixel.0[..3] {
+                let encoded = f32::from(*channel) / 255.0;
+                let straight = if srgb {
+                    decode_capture_srgb(encoded)
+                } else {
+                    encoded
+                };
+                let linear = straight * alpha + 1.0 - alpha;
+                let encoded = if srgb {
+                    encode_capture_srgb(linear)
+                } else {
+                    linear
+                };
+                *channel = (encoded * 255.0).round() as u8;
+            }
+            pixel[3] = 255;
+        }
