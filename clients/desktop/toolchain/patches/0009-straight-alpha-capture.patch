+/// GPU blending over a transparent target stores premultiplied RGB regardless
+/// of whether the source blend state expects straight or premultiplied alpha.
+/// RgbaImage/PNG consumers expect straight alpha. sRGB targets encode the
+/// blended linear RGB on storage, so unpremultiplication must happen in linear
+/// space rather than dividing their encoded bytes by alpha.
+#[cfg(not(target_family = "wasm"))]
+fn normalize_capture_pixels(pixels: &mut [u8], format: wgpu::TextureFormat) {
+    let bgra = matches!(
+        format,
+        wgpu::TextureFormat::Bgra8Unorm | wgpu::TextureFormat::Bgra8UnormSrgb
+    );
+    for pixel in pixels.chunks_exact_mut(4) {
+        if bgra {
+            pixel.swap(0, 2);
+        }
+        straighten_capture_alpha(pixel, format.is_srgb());
+    }
+}
+
+#[cfg(not(target_family = "wasm"))]
+fn straighten_capture_alpha(pixel: &mut [u8], srgb: bool) {
+    match pixel[3] {
+        0 => {
+            pixel[..3].fill(0);
+            return;
+        }
+        255 => return,
+        _ => {}
+    }
+    let alpha = f32::from(pixel[3]) / 255.0;
+    for channel in &mut pixel[..3] {
+        let encoded = f32::from(*channel) / 255.0;
+        let premultiplied = if srgb {
+            decode_capture_srgb(encoded)
+        } else {
+            encoded
+        };
+        let straight = (premultiplied / alpha).clamp(0.0, 1.0);
+        let encoded = if srgb {
+            encode_capture_srgb(straight)
+        } else {
+            straight
+        };
+        *channel = (encoded * 255.0).round() as u8;
+    }
+}
+
+#[cfg(not(target_family = "wasm"))]
+fn decode_capture_srgb(encoded: f32) -> f32 {
+    if encoded <= 0.04045 {
+        encoded / 12.92
+    } else {
+        ((encoded + 0.055) / 1.055).powf(2.4)
+    }
+}
+
+#[cfg(not(target_family = "wasm"))]
+fn encode_capture_srgb(linear: f32) -> f32 {
+    if linear <= 0.0031308 {
+        linear * 12.92
+    } else {
+        1.055 * linear.powf(1.0 / 2.4) - 0.055
+    }
+}
