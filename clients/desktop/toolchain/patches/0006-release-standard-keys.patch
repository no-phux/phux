+/// Standard app keys the host application handles itself.
+static RELEASED_KEYS: Mutex<Vec<&'static str>> = Mutex::new(Vec::new());
+
+/// Leave one of GPUIX's standard macOS app keys (`cmd-w`, `cmd-m`, ...)
+/// unbound, so the application's own key handling receives it. Its menu item
+/// stays, without the shortcut: a menu key equivalent would otherwise take the
+/// key back from the application. Call before the first window opens.
+pub fn release_standard_key(keystroke: &'static str) {
+    RELEASED_KEYS.lock().unwrap().push(keystroke);
+}
+
+pub(crate) fn standard_key_released(keystroke: &str) -> bool {
+    RELEASED_KEYS.lock().unwrap().contains(&keystroke)
+}
+
 pub(crate) fn seal_installation() {
     INSTALLATION.lock().unwrap().sealed = true;
 }
