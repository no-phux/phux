+/// The standard shortcuts, less those the host application released to
+/// handle itself (`native_extensions::release_standard_key`).
+fn standard_bindings(released: impl Fn(&str) -> bool) -> Vec<gpui::KeyBinding> {
+    [
+        ("cmd-q", Box::new(Quit) as Box<dyn gpui::Action>),
+        ("cmd-h", Box::new(Hide)),
+        ("cmd-alt-h", Box::new(HideOthers)),
+        ("cmd-m", Box::new(MinimizeWindow)),
+        ("cmd-w", Box::new(CloseWindow)),
+    ]
+    .into_iter()
+    .filter(|(keystroke, _)| !released(keystroke))
+    .map(|(keystroke, action)| {
+        gpui::KeyBinding::load(
+            keystroke,
+            action,
+            None,
+            false,
+            None,
+            &gpui::DummyKeyboardMapper,
+        )
+        .expect("standard keystrokes parse")
+    })
+    .collect()
+}
