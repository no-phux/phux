@@ -0,0 +1,63 @@
+import { describe, expect, it } from "vitest"
+import { createMutationQueue, createRendererState } from "../host.js"
+
+function host() {
+  let open = true
+  const batches: string[] = []
+  return {
+    batches,
+    isWindowOpen: () => open,
+    close: () => { open = false },
+    applyBatch(json: string) { batches.push(json); return [] },
+  }
+}
+
+describe("window/root delivery fences", () => {
+  it("drops scheduled events after close without touching a same-id sibling", () => {
+    const a = host(), b = host()
+    const scheduled: Array<() => void> = []
+    const delivered: string[] = []
+    const aState = createRendererState(a), bState = createRendererState(b)
+    aState.attach({
+      eventHandlers: new Map([[1, new Map([["click", () => delivered.push("a")]])]]),
+      schedule: (invoke) => scheduled.push(invoke),
+    })
+    bState.attach({ eventHandlers: new Map([[1, new Map([["click", () => delivered.push("b")]])]]) })
+    const event = { elementId: 1, eventType: "click" }
+    expect(aState.dispatch(event)).toBe(true)
+    a.close()
+    scheduled[0]!()
+    expect(aState.dispatch(event)).toBe(false)
+    expect(bState.dispatch(event)).toBe(true)
+    expect(delivered).toEqual(["b"])
+  })
+
+  it("drops a scheduled callback after root replacement on a live window", () => {
+    const renderer = host()
+    const state = createRendererState(renderer)
+    const scheduled: Array<() => void> = []
+    let deliveries = 0
+    const first = state.attach({
+      onWindowKeyDown: () => deliveries++,
+      schedule: (invoke) => scheduled.push(invoke),
+    })
+    state.dispatch({ elementId: first.windowKeyEventId, eventType: "windowKeyDown" })
+    first.detach()
+    state.attach({ onWindowKeyDown: () => deliveries++ })
+    scheduled[0]!()
+    expect(deliveries).toBe(0)
+  })
+
+  it("discards queued closed-window mutations and still flushes its sibling", () => {
+    const a = host(), b = host()
+    const qa = createMutationQueue(a), qb = createMutationQueue(b)
+    qa.createElement(1, "text")
+    qb.createElement(1, "text")
+    a.close()
+    qa.flushMutations()
+    qb.flushMutations()
+    expect(a.batches).toEqual([])
+    expect(qa.pending).toBe(0)
+    expect(b.batches).toHaveLength(1)
+  })
+})
