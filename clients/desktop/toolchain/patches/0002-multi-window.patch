+//! One embedded application and event pump; GPUI owns the generation-keyed
+//! window registry. Renderers retain only their own typed window handle.
+
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+
+use crate::renderer::{to_gpui_window_options, EventCallback, GpuixView, WindowOptions};
+use crate::retained_tree::RetainedTree;
+use crate::text::SharedSelection;
+use gpui::AppContext as _;
+use napi::{Error, Result};
+
+thread_local! {
+    static PLATFORM: RefCell<Option<Rc<gpui_macos::MacPlatform>>> = const { RefCell::new(None) };
+    static APP: RefCell<Option<gpui::ApplicationHandle>> = const { RefCell::new(None) };
+}
+
+pub(crate) fn with_app<R>(update: impl FnOnce(&mut gpui::App) -> R) -> Result<R> {
+    APP.with(|app| {
+        let app = app.borrow();
+        let app = app
+            .as_ref()
+            .ok_or_else(|| Error::from_reason("GPUI application is not initialized"))?;
+        Ok(app.update(update))
+    })
+}
+
+fn initialize_application(app_name: &str) {
+    if APP.with(|app| app.borrow().is_some()) {
+        return;
+    }
+    let platform = Rc::new(gpui_macos::MacPlatform::new_embedded());
+    let app_name = app_name.to_owned();
+    let app = gpui::Application::with_platform(platform.clone())
+        // The JS host owns process lifetime. LastWindowClosed schedules AppKit
+        // terminate:, which exits the process before tick() can return false.
+        // Explicit is GPUI's normal macOS policy and permits later new windows.
+        .with_quit_mode(gpui::QuitMode::Explicit)
+        .run_embedded(move |cx| {
+            crate::custom_elements::input::init(cx);
+            crate::custom_elements::img::init(cx);
+            crate::app_menu::init(&app_name, cx);
+        });
+    APP.with(|stored| *stored.borrow_mut() = Some(app));
+    PLATFORM.with(|stored| *stored.borrow_mut() = Some(platform));
+}
+
+pub(crate) fn open_window(
+    options: WindowOptions,
+    tree: Arc<Mutex<RetainedTree>>,
+    callback: Option<EventCallback>,
+    selection: SharedSelection,
+    alive: Arc<AtomicBool>,
+) -> Result<gpui::WindowHandle<GpuixView>> {
+    let title = options.title.clone().unwrap_or_else(|| "GPUIX".into());
+    initialize_application(options.app_name.as_deref().unwrap_or(&title));
+    with_app(|cx| {
+        let bounds = gpui::Bounds::centered(
+            None,
+            gpui::size(
+                gpui::px(options.width.unwrap_or(800.0) as f32),
+                gpui::px(options.height.unwrap_or(600.0) as f32),
+            ),
+            cx,
+        );
+        let handle = cx
+            .open_window(to_gpui_window_options(&options, bounds), |window, cx| {
+                cx.new(|cx| {
+                    let mut view = GpuixView::new(tree, callback, title, selection);
+                    view.frame_window = crate::window_state::key(window);
+                    cx.on_release(move |view: &mut GpuixView, _| {
+                        alive.store(false, Ordering::Release);
+                        view.release_window_state();
+                    })
+                    .detach();
+                    view
+                })
+            })
+            .map_err(|error| {
+                Error::from_reason(format!("Failed to open the GPUI window: {error}"))
+            })?;
+        if options.focus.unwrap_or(true) {
+            cx.activate(true);
+        }
+        Ok(handle)
+    })?
+}
+
+pub(crate) fn update_window<R>(
+    handle: gpui::WindowHandle<GpuixView>,
+    update: impl FnOnce(&mut GpuixView, &mut gpui::Window, &mut gpui::Context<GpuixView>) -> R,
+) -> Result<R> {
+    with_app(|cx| {
+        handle
+            .update(cx, update)
+            .map_err(|error| Error::from_reason(error.to_string()))
+    })?
+}
+
+// Input handlers may update the root: never lease GpuixView during dispatch.
+pub(crate) fn update_without_view<R>(
+    handle: gpui::WindowHandle<GpuixView>,
+    update: impl FnOnce(&mut gpui::Window, &mut gpui::App) -> R,
+) -> Result<R> {
+    with_app(|cx| {
+        gpui::AnyWindowHandle::from(handle)
+            .update(cx, |_, window, cx| update(window, cx))
+            .map_err(|error| Error::from_reason(error.to_string()))
+    })?
+}
+
+pub(crate) fn tick() -> bool {
+    let running = PLATFORM.with(|platform| {
+        platform
+            .borrow()
+            .as_ref()
+            .is_some_and(|platform| platform.pump_events())
+    });
+    running && with_app(|cx| !cx.windows().is_empty()).unwrap_or(false)
+}
