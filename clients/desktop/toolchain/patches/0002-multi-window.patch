diff --git a/packages/native/src/window_state.rs b/packages/native/src/window_state.rs
new file mode 100644
index 0000000..94208e2
--- /dev/null
+++ b/packages/native/src/window_state.rs
@@ -0,0 +1,50 @@
+//! Explicit window keys for caches that outlive an individual paint closure.
+//! No ambient "current window": delayed paint/input always names its own window.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+
+pub(crate) type WindowKey = Option<gpui::WindowId>;
+
+pub(crate) fn key(window: &gpui::Window) -> WindowKey {
+    key_for_handle(window.window_handle())
+}
+
+pub(crate) fn key_for_handle(window: gpui::AnyWindowHandle) -> WindowKey {
+    #[cfg(target_os = "macos")]
+    return Some(window.window_id());
+    #[cfg(not(target_os = "macos"))]
+    {
+        let _ = window;
+        None
+    }
+}
+
+/// Non-macOS retains its existing single-window namespace (`None`).
+#[derive(Default)]
+pub(crate) struct WindowLocal<T> {
+    windows: RefCell<HashMap<WindowKey, Rc<RefCell<T>>>>,
+}
+
+impl<T: Default> WindowLocal<T> {
+    pub(crate) fn with<R>(&self, key: WindowKey, read: impl FnOnce(&RefCell<T>) -> R) -> R {
+        let state = self.windows.borrow_mut().entry(key).or_default().clone();
+        // Release the map before calling out; a callback can access another window.
+        read(&state)
+    }
+
+    pub(crate) fn remove(&self, key: WindowKey) {
+        self.windows.borrow_mut().remove(&key);
+    }
+}
+
+pub(crate) trait WindowLocalExt<T> {
+    fn for_window<R>(&'static self, key: WindowKey, read: impl FnOnce(&RefCell<T>) -> R) -> R;
+}
+
+impl<T: Default + 'static> WindowLocalExt<T> for std::thread::LocalKey<WindowLocal<T>> {
+    fn for_window<R>(&'static self, key: WindowKey, read: impl FnOnce(&RefCell<T>) -> R) -> R {
+        self.with(|states| states.with(key, read))
+    }
+}
