+
+    #[test]
+    fn fullscreen_auto_hides_system_bars_without_losing_appkit_options() {
+        let preserved = NSApplicationPresentationOptions::FullScreen
+            | NSApplicationPresentationOptions::AutoHideToolbar
+            | NSApplicationPresentationOptions::DisableProcessSwitching;
+        for bars in [
+            NSApplicationPresentationOptions::empty(),
+            NSApplicationPresentationOptions::AutoHideDock,
+            NSApplicationPresentationOptions::HideDock
+                | NSApplicationPresentationOptions::HideMenuBar,
+        ] {
+            let options = fullscreen_presentation_options((preserved | bars).bits());
+            assert_eq!(
+                NSApplicationPresentationOptions::from_bits_retain(options),
+                preserved
+                    | NSApplicationPresentationOptions::AutoHideDock
+                    | NSApplicationPresentationOptions::AutoHideMenuBar,
+            );
+        }
+    }
