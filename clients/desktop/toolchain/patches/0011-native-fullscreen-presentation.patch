+extern "C" fn window_fullscreen_presentation_options(
+    _: &AnyObject,
+    _: Sel,
+    _: *mut AnyObject,
+    options: usize,
+) -> usize {
+    fullscreen_presentation_options(options)
+}
+
+fn fullscreen_presentation_options(options: usize) -> usize {
+    // Keep AppKit's native fullscreen Space and restore behavior, but do not
+    // reserve a strip for a menu bar configured to remain visible system-wide.
+    // The Hide and AutoHide variants are mutually exclusive.
+    let mut options = NSApplicationPresentationOptions::from_bits_retain(options);
+    options.remove(
+        NSApplicationPresentationOptions::HideDock | NSApplicationPresentationOptions::HideMenuBar,
+    );
+    options.insert(
+        NSApplicationPresentationOptions::AutoHideDock
+            | NSApplicationPresentationOptions::AutoHideMenuBar,
+    );
+    options.bits()
+}
