+        struct Guard {
+            dropped: Rc<Cell<usize>>,
+            payload: [u8; 512],
+        }
+        impl Drop for Guard {
+            fn drop(&mut self) {
+                assert!(self.payload.iter().all(|byte| *byte == 0x5a));
+                self.dropped.set(self.dropped.get() + 1);
+            }
+        }
+        let mut arena = Arena::new(1024);
+        for _ in 0..16 {
+            arena.alloc(|| [0_u8; 1024]);
+        }
+        arena.clear();
+        arena.low_usage_since = Some(Instant::now() - Duration::from_secs(6));
+        let dropped = Rc::new(Cell::new(0));
+        arena.begin_scope();
+        let guard = arena.alloc(|| Guard {
+            dropped: dropped.clone(),
+            payload: [0x5a; 512],
+        });
+        arena.begin_scope();
+        arena.clear();
+        assert_eq!(arena.capacity(), 16 * 1024);
+        assert_eq!(dropped.get(), 0);
+        assert_eq!(guard.payload[0], 0x5a);
+        arena.end_scope();
+        arena.clear();
+        assert_eq!(dropped.get(), 0);
+        arena.end_scope();
+        arena.clear();
