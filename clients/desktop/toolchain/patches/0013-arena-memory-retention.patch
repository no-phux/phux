     fn force_clear(&mut self) {
+        let used_chunks = self.current_chunk_index + 1;
         self.valid.set(false);
         self.valid = Rc::new(Cell::new(true));
         self.elements.clear();
+        self.trim_surplus_chunks(used_chunks, Instant::now());
         for chunk_index in 0..=self.current_chunk_index {
             self.chunks[chunk_index].reset();
         }
         self.current_chunk_index = 0;
     }
 
+    fn trim_surplus_chunks(&mut self, used_chunks: usize, now: Instant) {
+        // Arenas are shared across windows. A single small draw must not evict
+        // the capacity needed by an interleaved large one. Wait for five
+        // seconds continuously below a quarter of capacity, then keep 2x usage.
+        // Use time rather than draw counts: windows can have unequal cadences.
+        // Call only after elements are dropped, never while a scope is active.
+        if self.chunks.len() <= used_chunks.saturating_mul(4) {
+            self.low_usage_since = None;
+            return;
+        }
+        let since = self.low_usage_since.get_or_insert(now);
+        if now.saturating_duration_since(*since) >= Duration::from_secs(5) {
+            self.chunks.truncate(used_chunks.saturating_mul(2));
+            self.low_usage_since = None;
+        }
+    }
