-// Element types supported by GPUIX
-export type ElementType =
-  | "div"
-  | "text"
-  | "img"
-  | "svg"
-  | "canvas"
-  | "input"
-  | "textarea"
-  | "anchored"
-  | "code"
-  | "diff"
-  | "markdown"
-  | "virtual-list"
+const HOST_ELEMENT_TYPES = [
+  "div", "text", "img", "svg", "canvas", "input", "textarea",
+  "anchored", "code", "diff", "markdown", "virtual-list",
+] as const
+const BUILTIN_HOST_ELEMENTS: ReadonlySet<string> = new Set(HOST_ELEMENT_TYPES)
+declare const registeredCustomElementType: unique symbol
+/** A name admitted explicitly by registerCustomElementType, not arbitrary text. */
+export type CustomElementType = string & { readonly [registeredCustomElementType]: true }
+export type ElementType = typeof HOST_ELEMENT_TYPES[number] | CustomElementType
+
+const CUSTOM_ELEMENT_TYPES = Symbol.for("@gpuix/native/custom-element-types")
+
+function customElementTypes(): Set<string> {
+  const global = globalThis as typeof globalThis & { [CUSTOM_ELEMENT_TYPES]?: Set<string> }
+  return global[CUSTOM_ELEMENT_TYPES] ??= new Set<string>()
+}
+
+/** Register a JS host schema name. Does not load native code or install a factory. */
+export function registerCustomElementType(type: string): CustomElementType {
+  if (BUILTIN_HOST_ELEMENTS.has(type)) {
+    throw new Error(`Cannot register built-in GPUIX element <${type}>`)
+  }
+  if (typeof type !== "string" || !/^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$/.test(type)) {
+    throw new TypeError("Custom GPUIX element names must be lowercase hyphen-separated names")
+  }
+  customElementTypes().add(type)
+  return type as CustomElementType
+}
+
+/** Admission shared by framework adapters; registration is idempotent across reloads. */
+export function isHostElementType(type: string): type is ElementType {
+  return BUILTIN_HOST_ELEMENTS.has(type) || customElementTypes().has(type)
+}
+
+export function isCustomElementType(type: string): type is CustomElementType {
+  return customElementTypes().has(type)
+}
 
