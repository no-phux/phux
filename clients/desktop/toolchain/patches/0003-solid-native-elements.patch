@@ -0,0 +1,37 @@
+import { describe, expect, it, vi } from "vitest"
+import {
+  isCustomElementType,
+  isHostElementType,
+  registerCustomElementType,
+  type ElementType,
+} from "../host.js"
+import { createHostElement } from "../../../solid/src/host.js"
+
+describe("explicit shared custom element admission", () => {
+  it("preserves built-ins and rejects overriding them", () => {
+    for (const name of ["div", "text", "img", "svg", "canvas", "input", "textarea", "anchored", "code", "diff", "markdown", "virtual-list"]) {
+      expect(isHostElementType(name)).toBe(true)
+      expect(() => registerCustomElementType(name)).toThrow(/built-in/)
+    }
+  })
+
+  it("requires a lowercase hyphenated name and explicit registration", () => {
+    for (const name of ["", "plain", "Bad-name", "bad--name", "-bad", "bad-", "bad name", "bad/name", "bad.name", 7, null]) {
+      expect(() => registerCustomElementType(name as string)).toThrow(/hyphen-separated/)
+    }
+    expect(() => createHostElement("test-not-registered")).toThrow(/register custom types/)
+    const name: ElementType = registerCustomElementType("test-native-probe")
+    expect(createHostElement(name).type).toBe(name)
+    expect(isCustomElementType(name)).toBe(true)
+    expect(isCustomElementType("div")).toBe(false)
+  })
+
+  it("is idempotent across module reloads without loading native code", async () => {
+    const first = registerCustomElementType("test-shared-reload")
+    vi.resetModules()
+    const other = await import("../host.js")
+    expect(other.registerCustomElementType(first)).toBe(first)
+    expect(other.isHostElementType(first)).toBe(true)
+    expect(createHostElement(first).type).toBe(first)
+  })
+})
