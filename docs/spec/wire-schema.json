{
  "description": [
    "Machine-readable schema of the phux terminal wire codec (ADR-0117): every frame's type byte and, for each top-level TLV field of its body, the field id, name, value type, and presence.",
    "The prose spec in docs/spec/ is normative and this file mirrors it (appendix-encoding.md section 3). The reference codec is checked against this file on every test run.",
    "Every top-level field is `field_id: varint || wire_type: u8 (always 4, BYTES) || varint length || value` (appendix-encoding.md section 1). Decoders match fields by id, in any order, and skip unknown ids by length.",
    "`type` is the encoding of the value inside the TLV length; `types` defines each name. A top-level `str` or `bytes` is the raw value with no inner length prefix; strings and byte strings nested inside a positional record carry a u32 big-endian length prefix (appendix-encoding.md section 2.1).",
    "`presence`: `required` means a decoder rejects the frame without the field; `optional` means the field may be absent and the decoder applies the default the prose spec documents.",
    "`retired` lists ids inside a frame's range that are allocated to no field and must never be reused. Field-tagged records nested inside positional values (the SessionSnapshot extension block, field-tagged AgentEvent bodies) are specified in the prose only.",
    "Regenerate after an intended codec change with `PHUX_UPDATE_WIRE_SCHEMA=1 cargo nextest run -p phux-protocol wire_schema_matches`, then set the `type` of any new field (written as `?`)."
  ],
  "types": {
    "ActorRef": "positional record: u32 client id, then optional credential id str and optional client name str (L1.md section 7)",
    "AgentEvent": "positional tagged union: event tag, then its body (L1.md section 7.1)",
    "AttachTarget": "positional tagged union (L1.md section 8)",
    "BootstrapCodec": "positional tagged union (L1.md section 4.3)",
    "BootstrapProfile": "positional tagged union (proto.md section 6.2)",
    "ClientCapabilities": "positional record in a fixed field order (proto.md section 6.2)",
    "Command": "positional tagged union keyed by the command tag (L1.md section 5)",
    "CommandResult": "positional tagged union (L1.md section 5)",
    "DirectoryEntryList": "u32 count, then that many (name: u32-prefixed str, flags: u8) rows (L3.md section 4)",
    "Env": "u32 count, then that many (key, value) pairs of u32-prefixed UTF-8 strings",
    "GridSize": "4 bytes: cols u16 then rows u16, big-endian",
    "KeyEvent": "positional record (input.md section 2)",
    "MouseEvent": "positional record (input.md section 3)",
    "MoveResult": "positional tagged union (L1.md section 3.1)",
    "PasteEvent": "positional record: trust u8, then u32-prefixed bytes (input.md section 5)",
    "PathRowList": "u32 count, then that many (path: u32-prefixed str, kind: u8) rows (L3.md section 5)",
    "ResourceId": "positional tagged union: u8 tag; 0 = local, then u32 id; 1 = satellite, then host str and u32 id",
    "Scope": "positional tagged union: u8 tag, then a ResourceId, a u32 group id, or nothing (L3.md section 1)",
    "ServerCapabilities": "positional record: layers u8, then optional trailing feature words (proto.md section 6.2)",
    "SessionSnapshot": "positional record ending in a field-tagged extension block (L1.md sections 8 and 9.1)",
    "SpawnResult": "positional tagged union (L1.md section 3.1)",
    "SshOrigin": "positional record: client address str, client port u16, has-server u8, then server address str and port u16 when present (proto.md section 6.1)",
    "StringList": "u32 count, then that many u32-prefixed UTF-8 strings",
    "ViewportInfo": "positional record (L1.md sections 8 and 9.2)",
    "bool": "1 byte: 0 = false, 1 = true",
    "bytes": "raw opaque bytes filling the field; no inner length prefix",
    "bytes16": "exactly 16 opaque bytes (ServerInstance, IdempotencyKey)",
    "i32": "4 bytes, two's complement, big-endian",
    "str": "raw UTF-8 filling the field; no inner length prefix",
    "u16": "2 bytes, unsigned, big-endian",
    "u32": "4 bytes, unsigned, big-endian",
    "u64": "8 bytes, unsigned, big-endian",
    "u8": "1 byte, unsigned; enum tags are u8, with values in the prose spec"
  },
