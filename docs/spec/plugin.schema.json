{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "PluginAgentAttention": {
      "description": "Normalized attention priority for agent-aware consumers.",
      "oneOf": [
        {
          "const": "none",
          "description": "Explicitly no attention requested.",
          "type": "string"
        },
        {
          "const": "low",
          "description": "Low-priority background signal.",
          "type": "string"
        },
        {
          "const": "normal",
          "description": "Normal attention priority.",
          "type": "string"
        },
        {
          "const": "high",
          "description": "High-priority signal that should be surfaced prominently.",
          "type": "string"
        }
      ]
    },
    "PluginAgentState": {
      "description": "Normalized state labels for agent-aware consumers.",
      "oneOf": [
        {
          "const": "unknown",
          "description": "State cannot be determined yet.",
          "type": "string"
        },
        {
          "const": "idle",
          "description": "Agent is available and not actively working.",
          "type": "string"
        },
        {
          "const": "working",
          "description": "Agent is currently doing work.",
          "type": "string"
        },
        {
          "const": "blocked",
          "description": "Agent is waiting for human input or otherwise blocked.",
          "type": "string"
        }
      ]
    },
    "PluginPanePlacement": {
      "description": "Placement requested by a plugin pane entrypoint.",
      "oneOf": [
        {
          "const": "overlay",
          "description": "Floating box over the pane area, in no window; closes when its\nprocess exits or the user dismisses it (ADR-0147).",
          "type": "string"
        },
        {
          "const": "split",
          "description": "Split next to the focused pane.",
          "type": "string"
        },
        {
          "const": "tab",
          "description": "New window/tab.",
          "type": "string"
        },
        {
          "const": "zoomed",
          "description": "Zoomed pane view.",
          "type": "string"
        }
      ]
    },
    "PluginPlatform": {
      "description": "Platform names accepted in plugin manifests.",
      "oneOf": [
        {
          "const": "linux",
          "description": "Linux.",
          "type": "string"
        },
        {
          "const": "macos",
          "description": "macOS.",
          "type": "string"
        },
        {
          "const": "windows",
          "description": "Windows.",
          "type": "string"
        }
      ]
    },
    "PluginWidgetSlot": {
      "description": "Status-bar slot a plugin widget appends to.",
      "oneOf": [
        {
          "const": "left",
          "description": "Append to the left slot.",
          "type": "string"
        },
        {
          "const": "center",
          "description": "Append to the center slot.",
          "type": "string"
        },
        {
          "const": "right",
          "description": "Append to the right slot (the conventional home for indicators).",
          "type": "string"
        }
      ]
    },
