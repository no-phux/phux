{
  "name": "phux-site",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run sync-docs && astro dev",
    "build": "bun run sync-docs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "bun test worker/src src/components/terminal scripts/phux-wire.test.ts",
    "check:links": "bun run scripts/check-links.ts",
    "sync-docs": "bun run scripts/sync-docs.ts",
    "build:client": "bash scripts/build-client.sh",
    "build:edge": "bash scripts/build-edge.sh",
    "dev:live": "bash scripts/dev-live.sh",
    "dev:worker": "wrangler dev --cwd worker",
    "deploy": "bun run build && bunx wrangler deploy",
    "deploy:preview": "bun run build && bunx wrangler versions upload",
    "worker:check": "tsc --project worker/tsconfig.json",
    "worker:dry-run": "wrangler deploy --dry-run --cwd worker",
    "worker:deploy": "wrangler deploy --cwd worker",
    "worker:smoke-native": "bun run scripts/smoke-native.ts",
    "worker:smoke-fallback": "bun run scripts/smoke-native.ts --exercise-fallback"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudflare/containers": "0.3.7",
    "@pierre/diffs": "1.3.5",
    "fumadocs-core": "^16.14.0",
    "fumadocs-ui": "^16.14.0",
    "jose": "^6.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^4.20260529.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.6",
    "playwright-core": "^1.60.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "sharp": "0.35.0",
    "svgo": "4.0.2",
    "yaml": "2.8.3"
  }
}
