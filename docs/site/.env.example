# Point the live-demo terminal island at a phux WebSocket backend.
#
# Local dev:
#   bun run dev:worker     # the edge Worker+DO (phux-edge) at :8787
#   PUBLIC_PHUX_DEMO_WS=ws://localhost:8787/session bun run dev
#   (or bun run dev:live for the real native phux server at ws://localhost:8080/)
#
# Production is the deployed Worker custom domain:
#   PUBLIC_PHUX_DEMO_WS=wss://shell.phux.sh/session
#
# Leave it unset to show the "coming online" state.
PUBLIC_PHUX_DEMO_WS=ws://localhost:8787/session
