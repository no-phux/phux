{
  // phux static site — Workers static assets (Pages is legacy; this replaces
  // the old phux-site Pages project). Assets-only: no script, no bindings.
  // `wrangler deploy` uploads docs/site/dist (built by `bun run build`) and
  // serves it on the phux.sh custom domain. _headers / _redirects in dist/
  // are honored. The live-demo backend is a SEPARATE worker: worker/wrangler.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phux-site",
  "compatibility_date": "2026-05-01",
  "assets": {
    "directory": "./dist",
    // Bare canonical paths with no trailing slash; /foo resolves foo.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "phux.sh", "custom_domain": true }]
}
