---
import "../../styles/global.css";
import Head from "../Head.astro";
import { ClientRouter } from "astro:transitions";
import { SITE } from "../../lib/site";

interface Props {
  title: string;
  description: string;
  origin?: string;
}

const { title, description, origin = SITE.docsUrl } = Astro.props;
---

<!doctype html>
<html lang="en" data-design="reader">
  <head>
    <Head title={title} description={description} type="article" origin={origin} />
    <script is:inline>
      // Match next-themes before first paint and before Astro swaps documents.
      function applyReadingTheme(root) {
        let theme = "system";
        try { theme = localStorage.getItem("theme") || theme; } catch {}
        const dark = theme === "dark" || (theme === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        root.classList.toggle("dark", dark);
        root.classList.toggle("light", !dark);
        root.style.colorScheme = dark ? "dark" : "light";
      }
      applyReadingTheme(document.documentElement);
      document.addEventListener("astro:before-swap", (event) => {
        if (event.newDocument.documentElement.dataset.design === "reader") {
          applyReadingTheme(event.newDocument.documentElement);
        }
      });
    </script>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip" href="#nd-page">Skip to documentation</a>
    <slot />

    <footer class="docs-foot wrap">
      <a href={SITE.url}>{SITE.domain}</a>
      <a href="/overview">Docs</a>
      <a href="/wire">Protocol</a>
      <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
      <a href={`${SITE.url}/privacy`}>Privacy</a>
      <span>© 2026 no-phux</span>
    </footer>
  </body>
</html>
