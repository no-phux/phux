---
import "../../styles/global.css";
import Head from "../Head.astro";
import { ClientRouter } from "astro:transitions";
import { SITE } from "../../lib/site";

interface Props {
  title: string;
  description: string;
  origin?: string;
}

const { title, description, origin = SITE.docsUrl } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark" data-design={SITE.designMode}>
  <head>
    <Head title={title} description={description} type="article" origin={origin} />
    <ClientRouter />
  </head>
  <body
    class="flex min-h-screen flex-col"
    transition:persist
    transition:animate="none"
    transition:name="docs-layout"
  >
    <a class="skip" href="#nd-page">Skip to documentation</a>
    <slot />

    <footer class="wrap">
      <div class="foot">
        <span class="dim">phux · MIT/Apache-2.0</span>
        <a href={SITE.url}>phux.sh</a>
        <a href={SITE.github} target="_blank" rel="noopener">source</a>
        <a href="/wire">the wire</a>
        <span class="sp dim">© 2026 no-phux</span>
      </div>
    </footer>
  </body>
</html>
