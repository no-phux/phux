---
import "../../styles/global.css";
import Head from "../Head.astro";
import { ClientRouter } from "astro:transitions";
import { SITE } from "../../lib/site";

interface Props {
  title: string;
  description: string;
  origin?: string;
}

const { title, description, origin = SITE.docsUrl } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark" data-design={SITE.designMode}>
  <head>
    <Head title={title} description={description} type="article" origin={origin} />
    <ClientRouter />
  </head>
  <body
    class="flex min-h-screen flex-col"
    transition:persist
    transition:animate="none"
    transition:name="docs-layout"
  >
    <a class="skip" href="#nd-page">Skip to documentation</a>
    <slot />

    <footer class="docs-foot wrap">
      <a href={SITE.url}>phux.sh</a>
      <a href="/overview">Docs</a>
      <a href="/wire">Protocol</a>
      <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
      <span>© 2026 no-phux</span>
    </footer>
  </body>
</html>
