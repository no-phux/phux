---
// Same-tab (and leftover popup) completion for native GitHub/Google sign-in.
// The Worker redirects here with ?auth=success|error after the provider
// callback. Identity stays on the HttpOnly session cookie.
---
<script is:inline>
  const authUrl = new URL(window.location.href);
  const result = authUrl.searchParams.get("auth");
  if (result === "success" || result === "error") {
    const messages = {
      session_expired: "Sign-in expired or its cookie was blocked. Open phux.sh in a top-level tab, allow site cookies, and try again.",
      cancelled: "Sign-in was cancelled. Try again and approve sign-in, or continue with the edge shell.",
      account_too_new: "GitHub accounts must be at least seven days old. Use Google or continue with the edge shell.",
      configuration: "Sign-in is unavailable because the provider is not configured correctly. Try the other provider or the edge shell, and report this to the site operator.",
      provider_unavailable: "The sign-in provider could not verify your account. Try again, use the other provider, or continue with the edge shell.",
    };
    const code = authUrl.searchParams.get("auth_error");
    const error = result === "error"
      ? (Object.hasOwn(messages, code) ? messages[code] : messages.provider_unavailable)
      : undefined;
    document.documentElement.dataset.nativeAuthResult = result;
    if (error) document.documentElement.dataset.nativeAuthError = error;
    else delete document.documentElement.dataset.nativeAuthError;
    authUrl.searchParams.delete("auth");
    authUrl.searchParams.delete("auth_error");
    history.replaceState({}, "", authUrl);
    if (window.opener && !window.opener.closed) {
      window.opener.postMessage(
        { source: "phux-auth", type: "complete", result, ...(error ? { error } : {}) },
        window.location.origin,
      );
      window.close();
      // If browser policy prevents closing, the normal page still shows the result.
    }
  }
</script>

