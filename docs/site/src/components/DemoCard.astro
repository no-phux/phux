---
import type { CollectionEntry } from "astro:content";
import { demoDate, demoDuration } from "../lib/demos";

interface Props {
  demo: CollectionEntry<"demos">;
  featured?: boolean;
}

const { demo, featured = false } = Astro.props;
const Heading = featured ? "h2" : "h3";
---

<a class:list={["demo-card", { featured }]} href={`/demos/${demo.id}`}>
  <div class="poster">
    <img
      src={demo.data.poster}
      alt=""
      width="1600"
      height="900"
      loading={featured ? "eager" : "lazy"}
      decoding="async"
    />
    <span class="duration" aria-label={`Duration ${demoDuration(demo.data.duration)}`}>
      {demoDuration(demo.data.duration)}
    </span>
  </div>
  <div class="copy">
    {featured && <p class="label">Latest demo</p>}
    <Heading>{demo.data.title}</Heading>
    <p class="summary">{demo.data.summary}</p>
    <p class="meta">
      <time datetime={demo.data.publishedAt}>{demoDate(demo.data.publishedAt)}</time>
      {demo.data.version && <span>phux {demo.data.version}</span>}
    </p>
    <span class="watch">Watch demo <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .demo-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
    color: var(--color-fg);
  }
  .demo-card:hover {
    border-color: var(--color-accent-soft);
  }
  .poster {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-rule);
  }
  img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .duration {
    position: absolute;
    bottom: 10px;
    right: 10px;
    border: 1px solid var(--color-rule);
    background: var(--color-bg);
    padding: 2px 8px;
    font-family: var(--font-code);
    font-size: 12px;
  }
  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
    padding: clamp(20px, 3vw, 32px);
    overflow-wrap: anywhere;
  }
  .label {
    color: var(--color-signal);
    font-family: var(--font-code);
    font-size: 12px;
    margin: 0 0 16px;
  }
  h2, h3 {
    margin: 0 0 12px;
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  h2 {
    font-size: clamp(24px, 3vw, 32px);
  }
  .summary {
    color: var(--color-muted);
    line-height: 1.65;
    margin: 0 0 20px;
    max-width: 52ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin: auto 0 16px;
    color: var(--color-muted);
    font-size: 13px;
  }
  .watch {
    display: inline-flex;
    gap: 12px;
    color: var(--color-accent);
    font-weight: 500;
    font-size: 14px;
  }
  .demo-card:hover .watch {
    text-decoration: underline;
  }
  @media (min-width: 800px) {
    .featured {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: center;
    }
    .featured .poster {
      border-bottom: 0;
      border-right: 1px solid var(--color-rule);
    }
    .featured .meta {
      margin-top: 0;
    }
  }
</style>
