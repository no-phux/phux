---
import "../styles/global.css";
import Head from "../components/Head.astro";
import { SITE, NAV, docsHref } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  minimal?: boolean;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  minimal = false,
} = Astro.props;

const path = Astro.url.pathname;
const navigation = minimal ? [
  { href: docsHref("/overview"), label: "Docs" },
  { href: "/embed", label: "Try" },
  { href: SITE.github, label: "Source", external: true },
] : NAV;
---

<!doctype html>
<html lang="en" data-design={SITE.designMode} data-home={minimal || undefined}>
  <head>
    <Head title={title} description={description} type="website" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-frame">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/">{SITE.name}</a>
        <div class="links">
          {
            navigation.map((item) => (
              <a
                href={item.href}
                aria-current={
                  !("external" in item && item.external) && path.startsWith(item.href)
                    ? "page"
                    : undefined
                }
                {...("external" in item && item.external
                  ? { target: "_blank", rel: "noopener" }
                  : {})}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-frame">
      {minimal ? (
        <div class="quiet-foot">
          <span>Open source · Apache-2.0</span>
          <nav aria-label="More about phux">
            <a href="/demos">Demos</a>
            <a href="/more">More</a>
            <a href="/privacy">Privacy</a>
            <a href="/support">Support</a>
          </nav>
        </div>
      ) : <><div class="foot">
        <div class="foot-brand">
          <a class="brand" href="/">{SITE.name}</a>
          <p>{SITE.category}</p>
        </div>
        <nav class="foot-col" aria-label="Product">
          <h2>Product</h2>
          <a href="/demos">Demos</a>
          <a href={docsHref("/consumers/tui")}>CLI</a>
          <a href={docsHref("/consumers/cockpit")}>Cockpit</a>
          <a href={docsHref("/consumers/web")}>Web</a>
          <a href={docsHref("/consumers/agents")}>Agents</a>
        </nav>
        <nav class="foot-col" aria-label="Docs">
          <h2>Docs</h2>
          <a href={docsHref("/overview")}>Overview</a>
          <a href={docsHref("/quickstart")}>Quickstart</a>
          <a href={docsHref("/quickstart/install")}>Install</a>
          <a href={docsHref("/wire")}>Protocol</a>
        </nav>
        <nav class="foot-col" aria-label="Project">
          <h2>Project</h2>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <a href="https://discord.gg/dUv5rzdHp" target="_blank" rel="noopener">Discord</a>
          <a href={SITE.github + "/blob/main/LICENSE"} target="_blank" rel="noopener">Apache-2.0</a>
          <a href="/privacy">Privacy</a>
          <a href="/support">Support</a>
        </nav>
      </div>
      <p class="foot-end">© 2026 no-phux</p></>}
    </footer>

  </body>
</html>

<style>
  :global(html[data-home]) {
    --color-bg: #0b0b0d;
    --color-bg-soft: #111114;
    --color-fg: #ededee;
    --color-dim: #95959d;
    --color-muted: #aaaab1;
    --color-rule: #29292e;
    --color-surface: #101013;
    --color-accent: #ededee;
    --content-wide: 920px;
    --page-gutter: 24px;
  }
  :global(html[data-home]) .nav { border-bottom: 0; }
  .quiet-foot { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px 24px; border-top: 1px solid var(--color-rule); padding-block: 20px 32px; color: var(--color-dim); font-size: 12px; }
  .quiet-foot nav { display: flex; flex-wrap: wrap; gap: 20px; }
  .quiet-foot a { display: inline-flex; align-items: center; min-height: 44px; }
  @media (max-width: 560px) {
    :global(html[data-home]) .nav { flex-wrap: nowrap; gap: 16px; }
    :global(html[data-home]) .nav .links { flex-basis: auto; margin-left: auto; gap: 16px; }
  }
  /* Keep the full primary navigation readable and reachable on small screens. */
  @media (max-width: 560px) {
    .nav {
      height: auto;
      flex-wrap: wrap;
      gap: 4px 20px;
      padding-block: 10px;
    }
    .nav .links {
      flex-basis: 100%;
      flex-wrap: wrap;
      gap: 0 14px;
      margin-left: 0;
    }
    .nav .brand,
    .nav .links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 0;
    }
    .nav .links a {
      font-size: 14px;
    }
  }
</style>
