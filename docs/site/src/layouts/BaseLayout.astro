---
import "../styles/global.css";
import Head from "../components/Head.astro";
import { SITE, NAV, docsHref } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
} = Astro.props;

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-design={SITE.designMode}>
  <head>
    <Head title={title} description={description} type="website" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-frame">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/">phux</a>
        <div class="links">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                aria-current={
                  !("external" in item && item.external) && path.startsWith(item.href)
                    ? "page"
                    : undefined
                }
                {...("external" in item && item.external
                  ? { target: "_blank", rel: "noopener" }
                  : {})}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-frame">
      <div class="foot">
        <div class="foot-brand">
          <a class="brand" href="/">phux</a>
          <p>You and your agents share the same terminals.</p>
        </div>
        <nav class="foot-col" aria-label="Product">
          <h2>Product</h2>
          <a href={docsHref("/consumers/tui")}>CLI</a>
          <a href={docsHref("/consumers/cockpit")}>Cockpit</a>
          <a href={docsHref("/consumers/web")}>Web</a>
          <a href={docsHref("/consumers/agents")}>Agents</a>
        </nav>
        <nav class="foot-col" aria-label="Docs">
          <h2>Docs</h2>
          <a href={docsHref("/overview")}>Overview</a>
          <a href={docsHref("/quickstart")}>Quickstart</a>
          <a href={docsHref("/quickstart/install")}>Install</a>
          <a href={docsHref("/wire")}>Protocol</a>
        </nav>
        <nav class="foot-col" aria-label="Project">
          <h2>Project</h2>
          <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <a href="https://discord.gg/dUv5rzdHp" target="_blank" rel="noopener">Discord</a>
          <a href={SITE.github + "/blob/main/LICENSE-MIT"} target="_blank" rel="noopener">MIT</a>
          <a href={SITE.github + "/blob/main/LICENSE-APACHE"} target="_blank" rel="noopener">Apache-2.0</a>
        </nav>
      </div>
      <p class="foot-end">© 2026 no-phux</p>
    </footer>

    <script>
      console.log(
        "%c phux %c / terminal control plane",
        "color:#07080b;background:#7aa2f7;font-weight:700;padding:2px 6px",
        "color:#565f89",
      );
    </script>
  </body>
</html>
