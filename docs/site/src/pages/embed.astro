---
import "../styles/global.css";
import AuthReturn from "../components/AuthReturn.astro";
import PhuxTerminal from "../components/PhuxTerminal";
import { SITE } from "../lib/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0b0b0d" />
    <title>{SITE.name} — hosted terminal</title>
    <AuthReturn />
  </head>
  <body>
    <main>
      <h1>{SITE.name} hosted terminal</h1>
      <div class="embed-frame">
        <nav class="embed-nav" aria-label="Terminal navigation" hidden>
          <a href="/">← phux</a>
          <span>Browser terminal</span>
        </nav>
      <PhuxTerminal
        client:load
        wsUrl={SITE.demoWsUrl}
        mode="native"
        cols={110}
        rows={32}
        autoStart
        statusParentOrigin="https://phall.io"
      />
        <noscript><p>This terminal needs JavaScript. <a href="https://docs.phux.sh/quickstart/install">Install phux locally instead.</a></p></noscript>
      </div>
    </main>
  </body>
</html>

<script>
  // Embedded clients keep their host's navigation; standalone gets a way back.
  if (window.self === window.top) {
    document.querySelector<HTMLElement>(".embed-nav")?.removeAttribute("hidden");
  }
</script>

<style>
  html,
  body {
    min-height: 100%;
    margin: 0;
    background: #0b0b0d;
  }
  body {
    padding: 0;
  }
  main {
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    padding: clamp(8px, 2vw, 24px);
    box-sizing: border-box;
  }
  h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .embed-frame { width: min(920px, 100%); min-width: 0; }
  .embed-nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; color: #aaaab1; font-size: 12px; }
  .embed-nav[hidden] { display: none; }
  .embed-nav a { display: inline-flex; align-items: center; min-height: 44px; color: #ededee; }
  .embed-nav a:hover { text-decoration: underline; }
  noscript p { color: #aaaab1; font-size: 13px; }
  noscript a { text-decoration: underline; }
</style>
