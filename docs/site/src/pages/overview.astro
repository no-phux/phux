---
// /overview — docs landing on docs.phux.sh (and locally at /overview).
// Custom body; the Fumadocs tree still lists this slug from the synced stub
// so search and the sidebar stay in sync. [...slug] skips this path.
import { Docs } from "../components/docs/Docs";
import { OverviewBody } from "../components/docs/Overview";
import Layout from "../components/docs/layout.astro";
import { source } from "../lib/source";
import { SITE } from "../lib/site";

const title = "phux — Get started";
const description =
  "You and your agents share the same running terminals. Start with the quickstart, choose an interface, or explore the measured performance.";
---

<Layout title={title} description={description} origin={SITE.docsUrl}>
  <Docs
    tree={source.getPageTree()}
    pathname="/overview"
    params={Astro.params}
    sourceUrl={`${SITE.github}/blob/main/docs/site/src/pages/overview.astro`}
    title="Get started"
    summary="You and your agents, on the same running terminals. Start locally, choose your interface, and keep working when you disconnect."
    description={description}
    stability="stable"
    protocolVersion=""
    client:load
  >
    <OverviewBody />
  </Docs>
</Layout>
