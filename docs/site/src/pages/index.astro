---
import BaseLayout from "../layouts/BaseLayout.astro";
import AgentInboxDemo from "../components/AgentInboxDemo";
import PhuxTerminal from "../components/PhuxTerminal.tsx";
import { SITE, docsHref } from "../lib/site";
import release from "../lib/release.json";

const cliInstall = "curl -fsSL https://phux.sh/install | sh";
const cockpitInstall = "curl -fsSL https://phux.sh/install-cockpit | sh";
---

<BaseLayout>
  <section class="wrap hero">
    <div class="hero-copy">
      <h1>You and your agents share the same terminals.</h1>
      <p class="lede">
        phux is a terminal multiplexer whose panes are a view. Underneath,
        each terminal is an object on a wire: you, Cockpit, a script, or an
        agent attach to the same live emulator. When the harness emits,
        blocked is a fact. Join another machine with no account.
      </p>
      <div class="hero-ctas">
        <a class="cta" href="#install">Install</a>
        <a class="cta ghost" href={docsHref("/overview")}>Read the docs</a>
      </div>
    </div>
    <div class="hero-stage">
      <PhuxTerminal
        client:idle
        wsUrl={SITE.demoWsUrl}
        mode="native"
        cols={100}
        rows={24}
        poster="/demo-poster.png"
        posterAlt="a live phux session: the demo shell MOTD, OSC 8 hyperlinks, and 24-bit color rendered by the phux-web client"
      />
      <p class="hero-cap">
        A real phux terminal in the browser. The same bytes a GUI, headless
        tool, or agent consumes.
      </p>
    </div>
  </section>

  <section class="wrap attention" aria-labelledby="attention-title">
    <div class="attention-copy">
      <p class="attention-kicker">THE FLEET INBOX</p>
      <h2 id="attention-title">Never hunt for the stuck one.</h2>
      <p>
        Agents publish their own work state beside the terminal where it
        happened. When one needs you, that terminal rises to the inbox with
        the exact question attached.
      </p>
    </div>
    <AgentInboxDemo client:visible />
  </section>

  <section class="wrap features-list">
    <a class="feature" href={docsHref("/concepts")}>
      <span>01</span>
      <div>
        <h2>Panes are a view.</h2>
        <p>
          The multiplexer chrome is one consumer. Underneath, each terminal
          is an object with a stable id. Detach, reattach, share it.
        </p>
      </div>
    </a>
    <a class="feature" href={docsHref("/consumers")}>
      <span>02</span>
      <div>
        <h2>Same objects, many consumers.</h2>
        <p>
          CLI, Cockpit, the browser, and agents attach to the same live
          emulator. Nobody screen-scrapes. Nobody holds a second copy.
        </p>
      </div>
    </a>
    <a class="feature" href={docsHref("/consumers/agents")}>
      <span>03</span>
      <div>
        <h2>Co-presence.</h2>
        <p>
          An agent reads, acts, and waits against the terminal you are
          looking at. When it emits, blocked is a fact on the wire, not a
          scrape of its UI. OpenCode, Pi, and Claude plug into that loop.
        </p>
      </div>
    </a>
    <a class="feature" href={docsHref("/wire")}>
      <span>04</span>
      <div>
        <h2>Bytes stay bytes.</h2>
        <p>
          The same libghostty engine runs on both ends. Server sends VT;
          client sends structured input. Nothing in the middle re-parses.
        </p>
      </div>
    </a>
    <a class="feature" href={docsHref("/remote-access")}>
      <span>05</span>
      <div>
        <h2>Your machines. No account.</h2>
        <p>
          Pair once with <code>phux --remote me@mini</code>. After that the
          dial is encrypted QUIC with no ssh in the path and no phux
          account in the middle.
        </p>
      </div>
    </a>
  </section>

  <section class="wrap install" id="install">
    <h2>Install the CLI, or Cockpit on macOS.</h2>
    <p class="lede">
      One command, then <code>phux</code>. Cockpit is the native app for the
      same terminals.
    </p>
    <div class="install-row">
      <div class="install-cmd">
        <span>CLI {release.tag && <em>{release.tag}</em>}</span>
        <code>{cliInstall}</code>
        <button type="button" data-copy={cliInstall}>Copy</button>
      </div>
      <div class="install-cmd">
        <span>Cockpit {release.cockpit?.tag && <em>{release.cockpit.tag}</em>}</span>
        <code>{cockpitInstall}</code>
        <button type="button" data-copy={cockpitInstall}>Copy</button>
      </div>
    </div>
    <p class="install-more">
      Both scripts verify release checksums. Cockpit needs Apple silicon macOS
      11+. Homebrew: <code>brew tap no-phux/tap && brew install no-phux/tap/phux</code>.
      To track green <code>main</code>, add{" "}
      <code>--channel next</code>{" "}
      (<code>curl -fsSL https://phux.sh/install | sh -s -- --channel next</code>).
      {" "}
      <a href={docsHref("/quickstart/install")}>All install methods</a>
    </p>
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const value = btn.getAttribute("data-copy");
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const previous = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => {
          btn.textContent = previous;
        }, 1400);
      } catch {
        btn.textContent = "Copy failed";
      }
    });
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 64px);
    padding-block: clamp(48px, 8vw, 96px);
    align-items: start;
  }
  .hero h1 {
    margin: 0 0 20px;
    max-width: 12ch;
    font-size: clamp(40px, 5.4vw, 68px);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }
  .hero .lede,
  .install .lede {
    max-width: 46ch;
    margin: 0 0 28px;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.65;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-stage {
    min-width: 0;
  }
  .hero-cap {
    margin: 12px 0 0;
    color: var(--color-dim);
    font-size: 13px;
    line-height: 1.5;
  }

  .attention {
    display: grid;
    grid-template-columns: minmax(220px, 0.52fr) minmax(0, 1.48fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
    padding-block: clamp(56px, 8vw, 96px);
    border-top: 1px solid var(--color-rule);
  }
  .attention-kicker {
    margin: 0 0 14px;
    color: var(--color-attention);
    font-family: var(--font-code);
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .attention h2 {
    margin: 0 0 16px;
    max-width: 11ch;
    font-size: clamp(30px, 3.8vw, 48px);
    letter-spacing: -0.045em;
    line-height: 1.03;
  }
  .attention-copy > p:last-child {
    margin: 0;
    max-width: 38ch;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .features-list {
    border-top: 1px solid var(--color-rule);
  }
  .feature {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 20px;
    padding: 36px 0;
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
  }
  .feature:hover h2 {
    color: var(--color-accent);
  }
  .feature span {
    color: var(--color-subtle);
    font-family: var(--font-code);
    font-size: 13px;
    padding-top: 6px;
  }
  .feature h2 {
    margin: 0 0 8px;
    font-size: clamp(22px, 2.4vw, 30px);
    letter-spacing: -0.03em;
  }
  .feature p {
    margin: 0;
    max-width: 62ch;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .install {
    padding-block: clamp(56px, 8vw, 96px);
  }
  .install h2 {
    margin: 0 0 16px;
    max-width: 18ch;
    font-size: clamp(28px, 3.4vw, 42px);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .install-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
  }
  .install-cmd {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 12px;
    align-items: center;
    padding: 14px 16px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }
  .install-cmd span {
    grid-column: 1 / -1;
    color: var(--color-dim);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .install-cmd em {
    font-style: normal;
    color: var(--color-accent);
  }
  .install-cmd code {
    min-width: 0;
    overflow-x: auto;
    color: var(--color-signal);
    font-size: 13px;
    white-space: nowrap;
  }
  .install-cmd button {
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg);
    background: transparent;
    border: 1px solid var(--color-rule);
    padding: 6px 10px;
    cursor: pointer;
  }
  .install-cmd button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .install-more {
    margin: 0;
    max-width: 78ch;
    color: var(--color-dim);
    font-size: 13px;
    line-height: 1.6;
  }
  .install-more a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 40px 48px;
    }
    .hero h1 {
      max-width: 14ch;
    }
    .attention {
      grid-template-columns: 1fr;
    }
    .attention h2 {
      max-width: 14ch;
    }
    .install-row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .feature {
      grid-template-columns: 32px 1fr;
      padding: 28px 0;
    }
    .install-cmd code {
      grid-column: 1 / -1;
    }
    .install-cmd button {
      justify-self: start;
    }
  }
</style>
