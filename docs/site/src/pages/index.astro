---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthReturn from "../components/AuthReturn.astro";
import HeroDemo from "../components/HeroDemo";
import { SITE, docsHref } from "../lib/site";
import release from "../lib/release.json";

const cliInstall = "curl -fsSL https://phux.sh/install | sh";
const desktopInstall = "curl -fsSL https://phux.sh/install-desktop | sh";
const cockpitInstall = "curl -fsSL https://phux.sh/install-cockpit | sh";
// The desktop canary rides the moving `next` prerelease: same installer, the
// next channel. `sh -s --` forwards install-desktop.sh's own --channel flag.
const canaryInstall = `${desktopInstall} -s -- --channel next`;
// One hover/focus-driven switcher in the hero. The first target is server
// rendered into #install-command, so a no-JS visitor still sees the CLI curl.
const installs = [
  { id: "cli", label: "CLI", command: cliInstall, note: "macOS and Linux. Installs phux and phux-mcp." },
  { id: "desktop", label: "Desktop", command: desktopInstall, note: "Apple-silicon macOS. Installs the CLI first, then opens Phux.app." },
  { id: "canary", label: "Canary", command: canaryInstall, note: "Desktop canary: verified green-main builds. Switch back to Stable in Settings → Updates." },
];
// Build-time snapshot; site-deploy.yml rebuilds on every published release.
const day = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", timeZone: "UTC" });
const latest = [
  { name: "CLI", release },
  { name: "Desktop", release: release.desktop },
  { name: "Cockpit", release: release.cockpit },
].flatMap(({ name, release: r }) => r?.tag && r.url ? [{
  name,
  version: r.tag.replace(/^[a-z]+-/, ""),
  url: r.url,
  date: r.publishedAt ? day.format(new Date(r.publishedAt)) : "",
}] : []);
const projectLinks = [
  { label: "Releases", href: `${SITE.github}/releases` },
  { label: "Changelog", href: `${SITE.github}/blob/main/CHANGELOG.md` },
  { label: "Pull requests", href: `${SITE.github}/pulls?q=is%3Apr+sort%3Aupdated-desc` },
  { label: "Commits", href: `${SITE.github}/commits/main` },
];
const features = [
  { href: "/concepts", title: "Keep work running.", text: "Detach, close the window, come back. Your shells stay alive." },
  { href: "/consumers/getting-started", title: "Let agents work.", text: "Read output, send input, and wait for events through the CLI or MCP." },
  { href: "/remote-access", title: "Connect from anywhere.", text: "Attach from another client or machine. The work stays where it started." },
];
---

<BaseLayout minimal>
  <AuthReturn slot="head" />
  <div class="home">
    <section class="hero" aria-labelledby="product-name">
      <h1 id="product-name">{SITE.name}</h1>
      <div class="install" id="install" data-install aria-label="Install phux">
        <div class="install-tabs" role="group" aria-label="Choose an install">
          {installs.map((target, index) => (
            <button
              type="button"
              data-install-target={target.id}
              data-install-command={target.command}
              data-install-note={target.note}
              aria-pressed={index === 0 ? "true" : "false"}
            >{target.label}</button>
          ))}
        </div>
        <div class="install-line">
          <span class="install-prompt" aria-hidden="true">$</span>
          <code id="install-command">{cliInstall}</code>
          <button type="button" class="install-copy" data-copy={cliInstall} aria-label="Copy install command">Copy</button>
        </div>
        <p class="install-note" id="install-note">{installs[0].note}</p>
        <span class="install-sweep" aria-hidden="true"></span>
      </div>
      <div class="release">
        macOS &amp; Linux
        <span aria-hidden="true"> · </span>
        <details class="latest">
          <summary>{release.tag ?? "Latest"}<span aria-hidden="true"> ▾</span></summary>
          <div class="latest-panel">
            {latest.length > 0 && (
              <ul>
                {latest.map((item) => (
                  <li>
                    <a href={item.url}>{item.name} <b>{item.version}</b></a>
                    {item.date && <time>{item.date}</time>}
                  </li>
                ))}
              </ul>
            )}
            <p>
              {projectLinks.map((link, i) => (
                <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={link.href}>{link.label}</a></>
              ))}
            </p>
          </div>
        </details>
        <span aria-hidden="true"> · </span>
        <a href={docsHref("/quickstart/install")}>Other installs</a>
      </div>
      <p class="copy-status" role="status" aria-live="polite"></p>
    </section>

    <section class="terminal" aria-label="Try phux">
      <HeroDemo client:load wsUrl={SITE.demoWsUrl} />
      <p class="terminal-note"><a href="/embed" data-demo-launch>Try it in your browser <span aria-hidden="true">↗</span></a> · No install needed.</p>
    </section>

    <section class="beta" id="testflight" aria-labelledby="beta-title">
      <p class="beta-kicker">TestFlight beta</p>
      <h2 id="beta-title">phux on your iPhone</h2>
      <p class="beta-blurb">
        Drive the same terminals from your phone. Request access and App Store Connect
        emails the TestFlight invite.
      </p>
      <form class="beta-form" id="beta-form">
        <input
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="Apple Account email"
          aria-label="Email address for the TestFlight invite"
        />
        <input
          class="beta-trap"
          type="text"
          name="website"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <button type="submit">Request access</button>
      </form>
      <p class="beta-note" id="beta-note" aria-live="polite">
        Apple emails the invite to this address.
      </p>
    </section>

    <section class="features" aria-label="What phux does">
      {features.map((feature) => (
        <a href={docsHref(feature.href)}>
          <h2>{feature.title}</h2>
          <p>{feature.text}</p>
        </a>
      ))}
    </section>
  </div>
  <div hidden data-webmcp data-product={SITE.name} data-cli={cliInstall}
    data-desktop={desktopInstall} data-cockpit={cockpitInstall} data-docs={SITE.docsUrl}
    data-release-tag={release.tag} data-release-url={release.url}></div>
</BaseLayout>

<script>
  import { registerSiteTools, siteModelContext } from "../webmcp.ts";
  import { wireBetaRequest } from "../lib/beta.ts";
  const facts = document.querySelector<HTMLElement>("[data-webmcp]");
  const context = siteModelContext(globalThis);
  if (facts && context) {
    void registerSiteTools(context, {
      productName: facts.dataset.product ?? "", cliInstall: facts.dataset.cli ?? "",
      desktopInstall: facts.dataset.desktop ?? "", cockpitInstall: facts.dataset.cockpit ?? "",
      docsUrl: facts.dataset.docs ?? "", releaseTag: facts.dataset.releaseTag ?? "",
      releaseUrl: facts.dataset.releaseUrl ?? "",
    });
  }
  // The latest-releases popover closes on Escape or a click outside it.
  const latest = document.querySelector<HTMLDetailsElement>("details.latest");
  document.addEventListener("click", (event) => {
    if (latest?.open && !latest.contains(event.target as Node)) latest.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && latest?.open) {
      latest.open = false;
      latest.querySelector("summary")?.focus();
    }
  });
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const status = document.querySelector<HTMLElement>(".copy-status");
  button?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      if (status) status.textContent = "Install command copied.";
      setTimeout(() => { button.textContent = "Copy"; }, 1400);
    } catch {
      if (status) status.textContent = "Could not copy. Select the command to copy it manually.";
    }
  });

  // Hover, focus, or click a target to swap the command. The sliding pill and
  // the command wipe are motion; reduced motion keeps the swap, drops the rest.
  const install = document.querySelector<HTMLElement>("[data-install]");
  const code = install?.querySelector<HTMLElement>("#install-command");
  const note = install?.querySelector<HTMLElement>("#install-note");
  const tabs = install?.querySelector<HTMLElement>(".install-tabs");
  const targets = install ? [...install.querySelectorAll<HTMLButtonElement>("[data-install-target]")] : [];
  if (install && code && note && tabs && targets.length > 0) {
    const sweep = install.querySelector<HTMLElement>(".install-sweep");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    let active = targets[0];
    const placePill = (target: HTMLButtonElement) => {
      tabs.style.setProperty("--pill-offset", `${target.offsetLeft}px`);
      tabs.style.setProperty("--pill-width", `${target.offsetWidth}px`);
    };
    const swap = (target: HTMLButtonElement) => {
      if (target === active) return;
      active = target;
      for (const candidate of targets) {
        candidate.setAttribute("aria-pressed", String(candidate === target));
      }
      const command = target.dataset.installCommand ?? "";
      code.textContent = command;
      note.textContent = target.dataset.installNote ?? "";
      if (button) button.dataset.copy = command;
      placePill(target);
      if (reduce.matches) return;
      code.animate(
        [{ clipPath: "inset(0 100% 0 0)", opacity: 0.25 }, { clipPath: "inset(0 0 0 0)", opacity: 1 }],
        { duration: 340, easing: "cubic-bezier(.16,.84,.3,1)" },
      );
      note.animate(
        [{ opacity: 0, transform: "translateY(4px)" }, { opacity: 1, transform: "none" }],
        { duration: 220, easing: "ease-out" },
      );
      sweep?.animate(
        [
          { opacity: 0, transform: "translateX(-70%)" },
          { opacity: 1, offset: 0.45 },
          { opacity: 0, transform: "translateX(160%)" },
        ],
        { duration: 520, easing: "ease-out" },
      );
    };
    targets.forEach((target, index) => {
      target.addEventListener("pointerenter", () => swap(target));
      target.addEventListener("focus", () => swap(target));
      target.addEventListener("click", () => swap(target));
      target.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        const next = targets[(index + step + targets.length) % targets.length];
        next.focus();
        swap(next);
      });
    });
    // Widths are only final once fonts settle; re-place on the same signals.
    const relayout = () => placePill(active);
    relayout();
    requestAnimationFrame(relayout);
    document.fonts?.ready.then(relayout);
    addEventListener("resize", relayout);
    addEventListener("load", relayout);
  }

  wireBetaRequest(
    document.getElementById("beta-form") as HTMLFormElement | null,
    document.getElementById("beta-note"),
  );
</script>

<style>
  .home { width: min(100%, 920px); margin: auto; padding-inline: 24px; box-sizing: border-box; }
  .hero { text-align: center; padding-top: clamp(48px, 8vw, 88px); }
  h1 { margin: 0; font-size: clamp(80px, 15vw, 144px); line-height: 1; font-weight: 700; letter-spacing: -0.085em; }
  .hero .install { margin-top: 32px; border-radius: 12px; background: #ffffff03; border-color: #ffffff12; }
  .install { position: relative; display: grid; gap: 10px; width: fit-content; max-width: 100%; margin: auto; padding: 12px; border: 1px solid var(--color-rule); background: var(--color-surface); box-sizing: border-box; text-align: left; overflow: hidden; }
  .install-tabs { position: relative; display: inline-flex; gap: 2px; width: fit-content; padding: 3px; border: 1px solid var(--color-rule); border-radius: 999px; background: #ffffff05; }
  .install-tabs::before { content: ""; position: absolute; top: 3px; bottom: 3px; left: 0; width: var(--pill-width, 0); border-radius: 999px; background: #ffffff14; transform: translateX(var(--pill-offset, 0)); transition: transform 280ms cubic-bezier(.2,.8,.2,1), width 280ms cubic-bezier(.2,.8,.2,1); }
  .install-tabs button { position: relative; z-index: 1; min-height: 30px; padding: 0 12px; border: 0; border-radius: 999px; background: transparent; color: var(--color-muted); font: inherit; font-size: 12px; letter-spacing: 0.02em; cursor: pointer; transition: color 180ms ease; }
  .install-tabs button:hover, .install-tabs button:focus-visible { color: var(--color-fg); }
  .install-tabs button[aria-pressed="true"] { color: var(--color-fg); }
  .install-line { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .install-prompt { color: var(--color-signal); font-family: var(--font-code); }
  #install-command { min-width: 0; overflow-x: auto; white-space: nowrap; font-size: 13px; will-change: clip-path; }
  .install-copy { min-height: 44px; padding: 0 12px; border: 0; background: transparent; color: var(--color-muted); font: inherit; font-size: 12px; cursor: pointer; }
  .install-copy:hover { color: var(--color-fg); }
  .install-note { margin: 0; min-height: 18px; color: var(--color-dim); font-size: 12px; line-height: 1.5; }
  .install-sweep { position: absolute; inset: 0; pointer-events: none; opacity: 0; background: linear-gradient(100deg, transparent 30%, rgba(158, 206, 106, 0.16) 50%, transparent 70%); }
  .release { margin: 12px 0 0; color: var(--color-dim); font-size: 12px; }
  .release a:hover, .terminal-note a:hover { text-decoration: underline; }
  .latest { position: relative; display: inline-block; }
  .latest summary { display: inline; list-style: none; cursor: pointer; color: var(--color-muted); }
  .latest summary::-webkit-details-marker { display: none; }
  .latest summary:hover, .latest[open] summary { color: var(--color-fg); }
  .latest-panel { position: absolute; z-index: 10; top: calc(100% + 8px); left: 50%; transform: translateX(-50%); width: max-content; max-width: min(320px, calc(100vw - 32px)); padding: 12px 14px; border: 1px solid var(--color-rule); background: var(--color-surface); text-align: left; }
  .latest-panel ul { margin: 0 0 10px; padding: 0; list-style: none; display: grid; gap: 6px; }
  .latest-panel li { display: flex; justify-content: space-between; gap: 24px; font-size: 13px; }
  .latest-panel li a { color: var(--color-fg); }
  .latest-panel b { font-family: var(--font-code); font-weight: 500; }
  .latest-panel time { color: var(--color-dim); }
  .latest-panel p { margin: 0; padding-top: 10px; border-top: 1px solid var(--color-rule); }
  .latest-panel p a { color: var(--color-muted); }
  .copy-status { min-height: 20px; margin: 4px 0 0; color: var(--color-muted); font-size: 12px; }
  .terminal { margin-top: 28px; }
  .terminal-note { margin: 12px 0 0; text-align: center; color: var(--color-dim); font-size: 12px; }
  .terminal-note a { color: var(--color-muted); }
  .beta { position: relative; margin-top: 56px; padding: clamp(24px, 4vw, 36px); border: 1px solid var(--color-rule); border-radius: 14px; background: radial-gradient(120% 140% at 50% 0%, #ffffff0a, transparent 70%), var(--color-surface); text-align: center; }
  .beta-kicker { margin: 0 0 10px; color: var(--color-signal); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; }
  .beta h2 { margin: 0 0 8px; font-size: clamp(22px, 3vw, 28px); letter-spacing: -0.03em; }
  .beta-blurb { max-width: 46ch; margin: 0 auto 20px; color: var(--color-muted); font-size: 14px; line-height: 1.6; }
  .beta-form { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .beta-form input { min-width: 0; flex: 1 1 260px; max-width: 320px; padding: 11px 14px; border: 1px solid var(--color-rule); border-radius: 8px; background: #ffffff06; color: var(--color-fg); font: inherit; }
  .beta-form input:focus-visible { border-color: var(--color-signal); outline: none; }
  .beta-form button { padding: 11px 20px; border: 0; border-radius: 8px; background: var(--color-signal); color: #07080b; font: inherit; font-weight: 600; cursor: pointer; }
  .beta-form button:hover { filter: brightness(1.08); }
  .beta-form button:disabled { opacity: 0.6; cursor: progress; }
  .beta-trap { position: absolute; left: -10000px; width: 1px; height: 1px; opacity: 0; }
  .beta-note { min-height: 1.4em; margin: 14px 0 0; color: var(--color-dim); font-size: 12px; }
  .features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 56px; padding: 32px 0 48px; border-top: 1px solid var(--color-rule); }
  .features h2 { margin: 0 0 8px; font-size: 15px; font-weight: 600; letter-spacing: -0.02em; }
  .features p { margin: 0; color: var(--color-muted); font-size: 14px; line-height: 1.6; }
  .features a:hover h2 { text-decoration: underline; }
  @media (max-width: 600px) {
    .home { padding-inline: 20px; }
    .features { grid-template-columns: 1fr; gap: 24px; margin-top: 36px; }
    .install { gap: 8px; padding: 10px; }
    .install-tabs button { padding-inline: 9px; }
    #install-command { font-size: 11px; white-space: normal; overflow-wrap: anywhere; }
    .install-copy { padding-inline: 8px; }
    .beta { margin-top: 36px; }
    .beta-form input { flex-basis: 100%; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .install-tabs::before, .install-tabs button { transition: none; }
  }
  @media (scripting: none) {
    .install-tabs { display: none; }
  }
</style>
