---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthReturn from "../components/AuthReturn.astro";
import HeroDemo from "../components/HeroDemo";
import { SITE, docsHref } from "../lib/site";
import release from "../lib/release.json";

const cliInstall = "curl -fsSL https://phux.sh/install | sh";
const desktopInstall = "curl -fsSL https://phux.sh/install-desktop | sh";
// One hover/focus-driven switcher in the hero: CLI, Desktop, and the iPhone
// beta. The first target is server rendered into #install-command, so a no-JS
// visitor still sees the CLI curl. Command targets carry a command; the mobile
// target carries none, which swaps the command line for the TestFlight request
// form. Notes stay one line at desktop width; the dock reserves the row heights
// so a swap never resizes it and never slides a target out from the pointer.
const installs = [
  { id: "cli", label: "CLI", command: cliInstall, note: "macOS and Linux · installs phux and phux-mcp" },
  { id: "desktop", label: "Desktop", command: desktopInstall, note: "Apple-silicon macOS · installs the CLI too, then opens Phux.app" },
  { id: "mobile", label: "Mobile", command: "", note: "No install: open the demo, scan its code, drive the shell from your phone. App in TestFlight." },
];
// Build-time snapshot; site-deploy.yml rebuilds on every published release.
const day = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", timeZone: "UTC" });
type ReleaseSnapshot = { tag: string | null; url: string | null; publishedAt: string | null };
const releaseStreams: { name: string; release: ReleaseSnapshot }[] = [
  { name: "CLI", release },
  { name: "Desktop", release: release.desktop },
];
const latest = releaseStreams.flatMap(({ name, release: r }) => r.tag && r.url ? [{
  name,
  version: r.tag.replace(/^[a-z]+-/, ""),
  url: r.url,
  date: r.publishedAt ? day.format(new Date(r.publishedAt)) : "",
}] : []);
const projectLinks = [
  { label: "Releases", href: `${SITE.github}/releases` },
  { label: "Changelog", href: `${SITE.github}/blob/main/CHANGELOG.md` },
  { label: "Pull requests", href: `${SITE.github}/pulls?q=is%3Apr+sort%3Aupdated-desc` },
  { label: "Commits", href: `${SITE.github}/commits/main` },
];
const features = [
  { href: "/concepts", title: "Keep work running.", text: "Detach, close the window, come back. Your shells stay alive." },
  { href: "/consumers/getting-started", title: "Let agents work.", text: "Read output, send input, and wait for events through the CLI or MCP." },
  { href: "/remote-access", title: "Connect from anywhere.", text: "Attach from another client or machine. The work stays where it started." },
];
---

<BaseLayout minimal>
  <AuthReturn slot="head" />
  <div class="home">
    <section class="hero" aria-labelledby="product-name">
      <p class="hero-wordmark">{SITE.name}<span> / programmable terminal runtime</span></p>
      <h1 id="product-name" class="hero-headline">Leave the window.<br /><em>Keep the work.</em></h1>
      <p class="hero-summary">Your terminals. Your agents. Every screen.<br />One running session, wherever you pick it up.</p>
      <div class="hero-actions">
        <a class="hero-try" href="/embed" data-demo-launch>Try live demo <span aria-hidden="true">↗</span></a>
        <a href="#install">Install phux <span aria-hidden="true">↓</span></a>
      </div>
      <p class="hero-promise">No install. No sign-in. Bring your phone.</p>
    </section>

    <section class="terminal" aria-label="Try phux">
      <HeroDemo client:load wsUrl={SITE.demoWsUrl} />
    </section>

    <section class="installation" aria-label="Make it yours">
      <div class="install" id="install" data-install aria-label="Install phux">
        <div class="install-head">
          <div class="install-tabs" role="group" aria-label="Choose an install">
            {installs.map((target, index) => (
              <button
                type="button"
                data-install-target={target.id}
                data-install-command={target.command}
                data-install-note={target.note}
                aria-pressed={index === 0 ? "true" : "false"}
              >{target.label}</button>
            ))}
          </div>
        </div>
        <span class="install-rule" aria-hidden="true"></span>
        <div class="install-stage">
          <div class="install-line">
            <span class="install-command">
              <span class="install-prompt" aria-hidden="true">$</span>
              <code id="install-command">{cliInstall}</code>
            </span>
            <button type="button" class="install-copy" data-copy={cliInstall} aria-label="Copy install command">Copy</button>
          </div>
          <form class="install-request" id="beta-form" hidden>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="Apple Account email"
              aria-label="Email address for the TestFlight invite"
            />
            <input
              class="install-trap"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <button type="submit">Request access</button>
          </form>
        </div>
        <span class="install-rule" aria-hidden="true"></span>
        <p class="install-note" id="install-note">{installs[0].note}</p>
        <p class="copy-status" id="beta-note" role="status" aria-live="polite"></p>
      </div>
      <div class="release">
        macOS &amp; Linux
        <span aria-hidden="true"> · </span>
        <details class="latest">
          <summary>{release.tag ?? "Latest"}<span aria-hidden="true"> ▾</span></summary>
          <div class="latest-panel">
            {latest.length > 0 && (
              <ul>
                {latest.map((item) => (
                  <li>
                    <a href={item.url}>{item.name} <b>{item.version}</b></a>
                    {item.date && <time>{item.date}</time>}
                  </li>
                ))}
              </ul>
            )}
            <p>
              {projectLinks.map((link, i) => (
                <>{i > 0 && <span aria-hidden="true"> · </span>}<a href={link.href}>{link.label}</a></>
              ))}
            </p>
          </div>
        </details>
        <span aria-hidden="true"> · </span>
        <a href={docsHref("/quickstart/install")}>Other installs</a>
      </div>
    </section>

    <section class="features" aria-label="What phux does">
      {features.map((feature) => (
        <a href={docsHref(feature.href)}>
          <h2>{feature.title}</h2>
          <p>{feature.text}</p>
        </a>
      ))}
    </section>
  </div>
  <div hidden data-webmcp data-product={SITE.name} data-cli={cliInstall}
    data-desktop={desktopInstall} data-docs={SITE.docsUrl}
    data-release-tag={release.tag} data-release-url={release.url}></div>
</BaseLayout>

<script>
  import { registerSiteTools, siteModelContext } from "../webmcp.ts";
  import { wireBetaRequest } from "../lib/beta.ts";
  const facts = document.querySelector<HTMLElement>("[data-webmcp]");
  const context = siteModelContext(globalThis);
  if (facts && context) {
    void registerSiteTools(context, {
      productName: facts.dataset.product ?? "", cliInstall: facts.dataset.cli ?? "",
      desktopInstall: facts.dataset.desktop ?? "",
      docsUrl: facts.dataset.docs ?? "", releaseTag: facts.dataset.releaseTag ?? "",
      releaseUrl: facts.dataset.releaseUrl ?? "",
    });
  }
  // The latest-releases popover closes on Escape or a click outside it.
  const latest = document.querySelector<HTMLDetailsElement>("details.latest");
  document.addEventListener("click", (event) => {
    if (latest?.open && !latest.contains(event.target as Node)) latest.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && latest?.open) {
      latest.open = false;
      latest.querySelector("summary")?.focus();
    }
  });
  const button = document.querySelector<HTMLButtonElement>("[data-copy]");
  const status = document.querySelector<HTMLElement>(".copy-status");
  button?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
      if (status) status.textContent = "Install command copied.";
      setTimeout(() => { button.textContent = "Copy"; }, 1400);
    } catch {
      if (status) status.textContent = "Could not copy. Select the command to copy it manually.";
    }
  });

  // The dock keeps its fixed width and reserves its stage height, so a swap
  // moves nothing. Only the target underline travels (transform), and the
  // command settles with opacity and a short translate. The Mobile target has
  // no command: it swaps the command line for the TestFlight request form. No
  // clip or backdrop animation: both are what made the first pass stutter.
  const install = document.querySelector<HTMLElement>("[data-install]");
  const code = install?.querySelector<HTMLElement>("#install-command");
  const note = install?.querySelector<HTMLElement>("#install-note");
  const tabs = install?.querySelector<HTMLElement>(".install-tabs");
  const line = install?.querySelector<HTMLElement>(".install-line");
  const request = install?.querySelector<HTMLFormElement>(".install-request");
  const targets = install ? [...install.querySelectorAll<HTMLButtonElement>("[data-install-target]")] : [];
  if (install && code && note && tabs && line && request && targets.length > 0) {
    const still = matchMedia("(prefers-reduced-motion: reduce)");
    let active = targets[0];

    const placePill = (target: HTMLButtonElement) => {
      const frame = tabs.getBoundingClientRect();
      const box = target.getBoundingClientRect();
      tabs.style.setProperty("--pill-x", `${box.left - frame.left}px`);
      tabs.style.setProperty("--pill-width", `${box.width}px`);
    };
    // Equal-width targets mean the mark only ever translates; keep the width
    // set once per layout and let the transform transition carry the motion.
    const settle = (element: HTMLElement, distance: number, duration: number) => {
      if (still.matches) return;
      element.animate(
        [{ opacity: 0, transform: `translateY(${distance}px)` }, { opacity: 1, transform: "none" }],
        { duration, easing: "cubic-bezier(.22,.61,.36,1)" },
      );
    };
    const swap = (target: HTMLButtonElement) => {
      if (target === active) return;
      active = target;
      for (const candidate of targets) {
        candidate.setAttribute("aria-pressed", String(candidate === target));
      }
      const command = target.dataset.installCommand ?? "";
      const mobile = command === "";
      code.textContent = command;
      note.textContent = target.dataset.installNote ?? "";
      if (button) button.dataset.copy = command;
      line.hidden = mobile;
      request.hidden = !mobile;
      placePill(target);
      settle(mobile ? request : code, mobile ? 4 : 6, mobile ? 340 : 420);
      settle(note, 4, 340);
    };
    targets.forEach((target, index) => {
      target.addEventListener("pointerenter", () => swap(target));
      target.addEventListener("focus", () => swap(target));
      target.addEventListener("click", () => swap(target));
      target.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (step === 0) return;
        event.preventDefault();
        const next = targets[(index + step + targets.length) % targets.length];
        next.focus();
        swap(next);
      });
    });
    // Tab widths are only final once fonts settle; re-place on the same signals.
    const relayout = () => placePill(active);
    relayout();
    requestAnimationFrame(relayout);
    document.fonts?.ready.then(relayout);
    addEventListener("resize", relayout);
    addEventListener("load", relayout);
  }

  wireBetaRequest(
    document.getElementById("beta-form") as HTMLFormElement | null,
    document.getElementById("beta-note"),
  );
</script>

<style>
  .home { width: min(100%, 1120px); margin: auto; padding-inline: 24px; box-sizing: border-box; }
  .hero { text-align: center; padding-top: clamp(32px, 5vw, 64px); }
  .hero-wordmark { margin: 0 0 22px; font-size: 18px; line-height: 1.4; font-weight: 700; letter-spacing: -0.06em; }
  .hero-wordmark span { margin-left: 8px; color: var(--color-dim); font: 11px var(--font-code); letter-spacing: 0; }
  .hero-headline { margin: 0; font-size: clamp(44px, 7.5vw, 86px); line-height: 1.04; font-weight: 600; letter-spacing: -0.065em; }
  .hero-headline em { color: #b4cba2; font-style: normal; }
  .hero-summary { margin: 22px 0; color: var(--color-muted); font-size: clamp(15px, 2vw, 18px); line-height: 1.6; }
  .hero-actions { display: flex; align-items: center; justify-content: center; gap: 24px; font-size: 13px; }
  .hero-actions a { display: inline-flex; align-items: center; justify-content: center; gap: 18px; min-height: 44px; }
  .hero-actions .hero-try { padding: 0 22px; border: 1px solid #b4cba266; border-radius: 999px; color: #d9e6cf; background: #b4cba213; transition: background 180ms ease, border-color 180ms ease; }
  .hero-try:hover { background: #b4cba224; border-color: #b4cba2; }
  .hero-promise { margin: 12px 0 0; color: var(--color-dim); font-size: 11px; }
  .installation { max-width: 872px; margin: 48px auto 0; text-align: center; }
  /* No dock, no card: the targets, the command or request, and the note are
     plain type floating on the canvas. Structure comes from spacing and the two
     hairlines only. */
  .install { position: relative; width: 100%; margin: 30px auto 0; box-sizing: border-box; text-align: left; }
  .install-head { display: flex; justify-content: center; }
  .install-tabs { position: relative; display: flex; gap: 6px; }
  /* The travelling mark is a hairline under the active target, not a pill. */
  .install-tabs::before { content: ""; position: absolute; bottom: -6px; left: 0; width: var(--pill-width, 0); height: 1px; background: var(--color-fg); opacity: 0.45; transform: translateX(var(--pill-x, 0)); transition: transform 460ms cubic-bezier(.22,.61,.36,1); }
  .install-tabs button { position: relative; z-index: 1; flex: 1 1 0; min-width: 76px; min-height: 34px; padding: 0 10px; border: 0; border-radius: 0; background: transparent; color: var(--color-dim); font: inherit; font-size: 12.5px; letter-spacing: 0.01em; cursor: pointer; transition: color 240ms ease; }
  .install-tabs button:hover, .install-tabs button:focus-visible, .install-tabs button[aria-pressed="true"] { color: var(--color-fg); }
  .install-rule { display: block; height: 1px; margin-top: 16px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.09) 20%, rgba(255, 255, 255, 0.09) 80%, transparent); }
  /* Stage: the command line and the TestFlight request share one slot and one
     reserved height, so switching targets never resizes the dock. */
  .install-stage { display: grid; align-items: center; min-height: 62px; }
  /* Symmetric gutters put the command on the dock's center line with the copy
     action at the edge; equal 1fr tracks cannot collide because the copy track
     never shrinks below the button. */
  .install-line { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 12px; padding: 18px 0 4px; }
  .install-request { grid-area: 1 / 1; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 8px; }
  .install-line[hidden], .install-request[hidden] { display: none; }
  .install-command { grid-column: 2; display: flex; align-items: center; justify-content: center; gap: 10px; min-width: 0; }
  .install-prompt { color: var(--color-signal); font-family: var(--font-code); font-size: 13px; }
  #install-command { min-width: 0; overflow-x: auto; white-space: nowrap; font-size: 13px; }
  .install-copy { grid-column: 3; justify-self: end; min-height: 40px; padding: 0; border: 0; background: transparent; color: var(--color-dim); font: inherit; font-size: 12px; cursor: pointer; transition: color 220ms ease; }
  .install-copy:hover { color: var(--color-fg); }
  /* The request controls carry a hairline outline, not a filled panel: they
     float with the rest of the hero. */
  .install-request input { width: min(280px, 100%); padding: 9px 16px; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 999px; background: transparent; color: var(--color-fg); font: inherit; font-size: 14px; transition: border-color 200ms ease; }
  .install-request input::placeholder { color: var(--color-dim); }
  .install-request input:focus-visible, .install-request button:focus-visible { outline: 2px solid rgba(158, 206, 106, 0.6); outline-offset: 2px; }
  .install-request button { padding: 10px 20px; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 999px; background: transparent; color: var(--color-fg); font: inherit; font-size: 13px; font-weight: 500; cursor: pointer; transition: border-color 200ms ease; }
  .install-request button:hover { border-color: rgba(255, 255, 255, 0.3); }
  .install-request button:disabled { opacity: 0.55; cursor: progress; }
  .install-request .install-trap { position: absolute; left: -10000px; width: 1px; height: 1px; opacity: 0; }
  .install-note { min-height: 1.6em; margin: 0; padding: 14px 0 0; color: var(--color-dim); font-size: 12px; line-height: 1.6; text-align: center; }
  .release { margin: 14px 0 0; color: var(--color-dim); font-size: 12px; }
  .release a:hover, .terminal-note a:hover { text-decoration: underline; }
  .latest { position: relative; display: inline-block; }
  .latest summary { display: inline; list-style: none; cursor: pointer; color: var(--color-muted); }
  .latest summary::-webkit-details-marker { display: none; }
  .latest summary:hover, .latest[open] summary { color: var(--color-fg); }
  .latest-panel { position: absolute; z-index: 10; top: calc(100% + 8px); left: 50%; transform: translateX(-50%); width: max-content; max-width: min(320px, calc(100vw - 32px)); padding: 12px 14px; border: 1px solid var(--color-rule); background: var(--color-surface); text-align: left; }
  .latest-panel ul { margin: 0 0 10px; padding: 0; list-style: none; display: grid; gap: 6px; }
  .latest-panel li { display: flex; justify-content: space-between; gap: 24px; font-size: 13px; }
  .latest-panel li a { color: var(--color-fg); }
  .latest-panel b { font-family: var(--font-code); font-weight: 500; }
  .latest-panel time { color: var(--color-dim); }
  .latest-panel p { margin: 0; padding-top: 10px; border-top: 1px solid var(--color-rule); }
  .latest-panel p a { color: var(--color-muted); }
  .copy-status { min-height: 20px; margin: 4px 0 0; color: var(--color-muted); font-size: 12px; }
  .terminal { margin-top: 36px; }
  @media (max-width: 600px) { .hero-wordmark span { display: block; margin: 4px 0 0; font-size: 10px; } }
  @media (prefers-reduced-motion: reduce) { .hero-actions .hero-try { transition: none; } }
  .terminal-note { margin: 12px 0 0; text-align: center; color: var(--color-dim); font-size: 12px; }
  .terminal-note a { color: var(--color-muted); }
  .features { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 64px; padding: 32px 0 48px; border-top: 1px solid var(--color-rule); }
  .features h2 { margin: 0 0 8px; font-size: 15px; font-weight: 600; letter-spacing: -0.02em; }
  .features p { margin: 0; color: var(--color-muted); font-size: 14px; line-height: 1.6; }
  .features a:hover h2 { text-decoration: underline; }
  @media (max-width: 820px) {
    .install-tabs button { min-width: 76px; padding: 0 8px; font-size: 12px; }
    .install-line { grid-template-columns: minmax(0, 1fr) auto; padding: 14px 0 2px; }
    .install-command { grid-column: 1; align-items: flex-start; min-height: 34px; }
    .install-copy { grid-column: 2; }
    #install-command { white-space: normal; overflow-wrap: anywhere; font-size: 11.5px; }
    .install-note { min-height: 3.2em; padding: 12px 0 0; }
  }
  @media (max-width: 600px) {
    .home { padding-inline: 20px; }
    .features { grid-template-columns: 1fr; gap: 24px; margin-top: 48px; }
    /* A wrapped command needs two lines; the stacked request form needs two
       rows. Either way the stage keeps both targets the same height. */
    .install-stage { min-height: 84px; }
    .install-request { flex-direction: column; align-items: stretch; }
    .install-request input, .install-request button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .install-tabs::before, .install-tabs button, .install-copy, .install-request input, .install-request button { transition: none; }
  }
  @media (scripting: none) {
    .install-head { display: none; }
  }
</style>
