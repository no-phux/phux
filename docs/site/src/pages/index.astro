---
import BaseLayout from "../layouts/BaseLayout.astro";
import AuthReturn from "../components/AuthReturn.astro";
import AgentInboxDemo from "../components/AgentInboxDemo";
import MultiplexShowcase from "../components/MultiplexShowcase";
import { SITE, docsHref } from "../lib/site";
import release from "../lib/release.json";

const cliInstall = "curl -fsSL https://phux.sh/install | sh";
const cockpitInstall = "curl -fsSL https://phux.sh/install-cockpit | sh";
---

<BaseLayout>
  <AuthReturn slot="head" />
  <section class="wrap hero">
    <div class="hero-copy">
      <p class="hero-kicker">{SITE.category}</p>
      <h1>{SITE.tagline}</h1>
      <p class="lede">{SITE.description}</p>
      <div class="hero-ctas">
        <a class="cta" href="#install">Install</a>
        <a class="cta ghost" href={docsHref("/overview")}>Read the docs</a>
      </div>
    </div>
    <div class="hero-stage">
      <MultiplexShowcase client:load wsUrl={SITE.demoWsUrl} />
    </div>
  </section>

  <section class="wrap attention" aria-labelledby="attention-title">
    <div class="attention-copy">
      <p class="attention-kicker">AGENT ATTENTION</p>
      <h2 id="attention-title">See what needs input.</h2>
      <p>
        Integrated agents report progress and questions beside their terminals.
        Open the terminal that needs a decision.
      </p>
    </div>
    <AgentInboxDemo client:visible />
  </section>

  <section class="wrap features-list">
    <a class="feature" href={docsHref("/concepts")}>
      <span>01</span>
      <div>
        <h2>Keep processes running</h2>
        <p>
          Shells live in a background server, independent of your interface.
          Disconnect and reattach without restarting them.
        </p>
      </div>
    </a>
    <a class="feature" href={docsHref("/consumers/build-a-client")}>
      <span>02</span>
      <div>
        <h2>Build your own tools</h2>
        <p>
          Create terminals, send input, read output, and wait for events.
          Use the CLI or MCP adapter, or build a client against the public protocol.
        </p>
      </div>
    </a>
    <a class="feature" href={docsHref("/consumers/agents")}>
      <span>03</span>
      <div>
        <h2>Read agent state</h2>
        <p>
          Supported harnesses publish activity, questions, and completion as
          structured events. Terminal-based detectors cover additional harnesses.
        </p>
      </div>
    </a>
    <a class="feature" href={docsHref("/wire")}>
      <span>04</span>
      <div>
        <h2>Render with libghostty</h2>
        <p>
          Bundled clients receive raw terminal output and render it with
          libghostty, the same engine the server uses. Input travels as structured events.
        </p>
      </div>
    </a>
    <a class="feature" href={docsHref("/remote-access")}>
      <span>05</span>
      <div>
        <h2>Connect your machines</h2>
        <p>
          Connect over SSH or encrypted QUIC. Address remote terminals from
          the same CLI and API, without a hosted account.
        </p>
      </div>
    </a>
  </section>

  <section class="wrap install" id="install">
    <h2>Install</h2>
    <p class="lede">
      Use the CLI or a native macOS app.
    </p>
    <div class="install-row">
      <div class="install-cmd">
        <span>CLI {release.tag && <em>{release.tag}</em>}</span>
        <code tabindex="0">{cliInstall}</code>
        <button type="button" data-copy={cliInstall}>Copy</button>
      </div>
      <div class="install-cmd">
        <span>Cockpit {release.cockpit?.tag && <em>{release.cockpit.tag}</em>}</span>
        <code tabindex="0">{cockpitInstall}</code>
        <button type="button" data-copy={cockpitInstall}>Copy</button>
      </div>
    </div>
    <p class="install-more">
      CLI: macOS arm64 and Linux x86_64 or arm64. Cockpit: Apple silicon,
      macOS 11+. Both installers verify release checksums.{" "}
      <a href={docsHref("/quickstart/install#desktop-demo")}>Desktop demo (GPUIX/Solid, source build)</a>
      {" · "}
      <a href={docsHref("/quickstart/install")}>Other install methods and channels</a>
      {" · "}
      <a href={docsHref("/consumers/getting-started")}>Set up an agent</a>
    </p>
  </section>

  <section class="wrap join" id="testflight">
    <div class="join-copy">
      <h2>phux for iPhone</h2>
      <p>
        The phux terminal, in your pocket. Pair with your phux server, then
        watch and drive the same terminals from iPhone. The app is in
        TestFlight beta: request access and Apple emails you the invite.
      </p>
    </div>
    <form class="join-form" id="beta-form">
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        aria-label="Email address for the TestFlight invite"
      />
      <input
        class="join-trap"
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <button type="submit">Request access</button>
      <p class="join-note" id="beta-note" aria-live="polite">
        Use the address of your Apple Account so the invite opens in TestFlight.
      </p>
    </form>
  </section>

  <section class="wrap join" id="beta">
    <div class="join-copy">
      <h2>Release updates</h2>
      <p>Release notes and beta invitations. Unsubscribe at any time.</p>
    </div>
    <form class="join-form" id="join-form">
      <input
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        aria-label="Email address"
      />
      <button type="submit">Subscribe</button>
      <p class="join-note" id="join-note">
        Site statistics are aggregate. Device-level reporting requires a
        separate opt-in.{" "}
        <a href="/telemetry">What we measure</a>
      </p>
    </form>
  </section>
</BaseLayout>

<style>
  .join {
    display: grid;
    grid-template-columns: minmax(240px, 1fr) minmax(280px, 1fr);
    gap: clamp(20px, 4vw, 48px);
    padding-block: clamp(32px, 6vw, 64px);
    border-top: 1px solid var(--line, #232433);
    align-items: start;
  }
  .join h2 {
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .join-copy p {
    color: var(--color-muted);
    margin: 0;
    max-width: 46ch;
  }
  .join-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }
  .join-form input {
    min-width: 0;
    background: var(--bg, #07080b);
    border: 1px solid var(--line, #232433);
    color: var(--fg, #c0caf5);
    border-radius: 8px;
    padding: 10px 12px;
    font: inherit;
  }
  .join-form button {
    background: #7aa2f7;
    color: #07080b;
    border: none;
    border-radius: 8px;
    padding: 10px 18px;
    font-weight: 600;
    cursor: pointer;
  }
  .join-note {
    grid-column: 1 / -1;
    font-size: 12px;
    color: var(--color-muted);
    margin: 0;
  }
  .join-note a {
    color: inherit;
  }
  .join-trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  @media (max-width: 720px) {
    .join {
      grid-template-columns: 1fr;
    }
  }
</style>

<script is:inline define:vars={{ cliInstall, cockpitInstall, productName: SITE.name, docsUrl: SITE.docsUrl, releaseTag: release.tag, releaseUrl: release.url }}>
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const value = btn.getAttribute("data-copy");
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        const previous = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => {
          btn.textContent = previous;
        }, 1400);
      } catch {
        btn.textContent = "Copy failed";
      }
    });
  });

  // join-the-beta form → POST /api/join (voluntary email signup)
  (() => {
    const form = document.getElementById("join-form");
    if (!form) return;
    const note = document.getElementById("join-note");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = form.email.value.trim();
      const button = form.querySelector("button");
      button.disabled = true;
      try {
        const response = await fetch("/api/join", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ email, source: new URLSearchParams(location.search).get("utm_source") ?? location.pathname }),
        });
        const result = await response.json();
        note.textContent = result.ok
          ? "You're on the list."
          : "Could not subscribe: " + (result.error ?? "try again.");
        if (result.ok) form.reset();
      } catch {
        note.textContent = "Could not connect. Try again.";
      } finally {
        button.disabled = false;
      }
    });
  })();

  // phux for iPhone → POST /api/beta (TestFlight invite via App Store Connect)
  (() => {
    const form = document.getElementById("beta-form");
    if (!form) return;
    const note = document.getElementById("beta-note");
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = form.email.value.trim();
      const button = form.querySelector("button");
      button.disabled = true;
      try {
        const response = await fetch("/api/beta", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ email, website: form.website.value }),
        });
        const result = await response.json();
        if (!result.ok) {
          note.textContent = "Could not request access: " + (result.error ?? "try again.");
          return;
        }
        note.textContent =
          result.status === "invited"
            ? "Invite sent. Check " + email + " for an email from TestFlight."
            : "Request received. The TestFlight invite will go to " + email + ".";
        form.reset();
      } catch {
        note.textContent = "Could not connect. Try again.";
      } finally {
        button.disabled = false;
      }
    });
  })();

  // WebMCP: expose the site's key actions to in-browser AI agents.
  // Experimental API — feature-detect and no-op where it doesn't exist.
  (() => {
    const modelContext = navigator.modelContext;
    if (!modelContext || typeof modelContext.registerTool !== "function") return;
    modelContext.registerTool("get_install_command", {
      description:
        `Get the installer for the ${productName} CLI, Cockpit, or agent skills.`,
      inputSchema: {
        type: "object",
        properties: {
          target: {
            type: "string",
            enum: ["cli", "cockpit", "skills"],
            description: `Which installer to return. Defaults to the ${productName} CLI.`,
          },
        },
      },
      execute: ({ target } = {}) => ({
        command:
          target === "cockpit"
            ? cockpitInstall
            : target === "skills"
              ? "npx skills add no-phux/skills"
              : cliInstall,
      }),
    });
    modelContext.registerTool("open_docs", {
      description:
        `Get the canonical documentation URL for a ${productName} topic.`,
      inputSchema: {
        type: "object",
        properties: {
          topic: {
            type: "string",
            description: "Docs topic, e.g. \"quickstart\", \"wire\", \"consumers\".",
          },
        },
        required: ["topic"],
      },
      execute: ({ topic } = {}) => {
        const slug = String(topic || "").toLowerCase().replace(/[^a-z0-9/-]+/g, "");
        const paths = {
          overview: "/overview",
          quickstart: "/quickstart/install",
          concepts: "/concepts",
          consumers: "/consumers",
          agents: "/consumers/agents",
          "remote-access": "/remote-access",
          wire: "/wire/proto",
          architecture: "/architecture",
          decisions: "/decisions",
        };
        const path = paths[slug] ?? `/overview?search=${encodeURIComponent(slug)}`;
        return { url: `${docsUrl}${path}` };
      },
    });
    modelContext.registerTool("get_latest_release", {
      description: `Get the latest ${productName} release tag and URL.`,
      inputSchema: { type: "object", properties: {} },
      execute: () => ({ tag: releaseTag, url: releaseUrl }),
    });
  })();
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.2fr);
    gap: clamp(32px, 5vw, 64px);
    padding-block: clamp(48px, 8vw, 96px);
    align-items: center;
  }
  .hero-kicker {
    margin: 0 0 16px;
    color: var(--color-accent);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .hero h1 {
    margin: 0 0 20px;
    max-width: 12ch;
    font-size: clamp(40px, 5.4vw, 68px);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }
  .hero .lede,
  .install .lede {
    max-width: 46ch;
    margin: 0 0 28px;
    color: var(--color-muted);
    font-size: 17px;
    line-height: 1.65;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-stage {
    min-width: 0;
  }

  .attention {
    display: grid;
    grid-template-columns: minmax(220px, 0.52fr) minmax(0, 1.48fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: start;
    padding-block: clamp(56px, 8vw, 96px);
    border-top: 1px solid var(--color-rule);
  }
  .attention-kicker {
    margin: 0 0 14px;
    color: var(--color-attention);
    font-family: var(--font-code);
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .attention h2 {
    margin: 0 0 16px;
    max-width: 11ch;
    font-size: clamp(30px, 3.8vw, 48px);
    letter-spacing: -0.045em;
    line-height: 1.03;
  }
  .attention-copy > p:last-child {
    margin: 0;
    max-width: 38ch;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  .features-list {
    border-top: 1px solid var(--color-rule);
  }
  .feature {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 20px;
    padding: 36px 0;
    border-bottom: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
  }
  .feature:hover h2 {
    color: var(--color-accent);
  }
  .feature span {
    color: var(--color-subtle);
    font-family: var(--font-code);
    font-size: 13px;
    padding-top: 6px;
  }
  .feature h2 {
    margin: 0 0 8px;
    font-size: clamp(22px, 2.4vw, 30px);
    letter-spacing: -0.03em;
  }
  .feature p {
    margin: 0;
    max-width: 62ch;
    color: var(--color-muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .install {
    padding-block: clamp(56px, 8vw, 96px);
  }
  .install h2 {
    margin: 0 0 16px;
    max-width: 18ch;
    font-size: clamp(28px, 3.4vw, 42px);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .install-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 16px;
  }
  .install-cmd {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 12px;
    align-items: center;
    padding: 14px 16px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }
  .install-cmd span {
    grid-column: 1 / -1;
    color: var(--color-dim);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .install-cmd em {
    font-style: normal;
    color: var(--color-accent);
  }
  .install-cmd code {
    min-width: 0;
    overflow-x: auto;
    color: var(--color-signal);
    font-size: 13px;
    white-space: nowrap;
  }
  .install-cmd button {
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-fg);
    background: transparent;
    border: 1px solid var(--color-rule);
    padding: 6px 10px;
    cursor: pointer;
  }
  .install-cmd button:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .install-more {
    margin: 0;
    max-width: 78ch;
    color: var(--color-dim);
    font-size: 13px;
    line-height: 1.6;
  }
  .install-more a {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 40px 48px;
    }
    .hero h1 {
      max-width: 14ch;
    }
    .attention {
      grid-template-columns: 1fr;
    }
    .attention h2 {
      max-width: 14ch;
    }
    .install-row {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .feature {
      grid-template-columns: 32px 1fr;
      padding: 28px 0;
    }
    .install-cmd code {
      grid-column: 1 / -1;
    }
    .install-cmd button {
      justify-self: start;
    }
  }
</style>
