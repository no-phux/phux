---
// The web half of the pairing Universal Link (phux-z84.4).
//
// On an iPhone with the app installed, iOS resolves this URL against
// /.well-known/apple-app-site-association (host/pairing.ts) and hands it
// straight to phux — this page never renders. It renders exactly when that
// did not happen: the app is not installed, the association has not been
// fetched yet, or the link was opened on a desktop.
//
// The URL carries a bearer token, so this page is built to leak it nowhere:
// no analytics script, no outbound referrer, noindex, and the token is
// dropped from the address bar as soon as the page has read it. Nothing is
// ever sent to the server — the whole exchange is local to the device.
import { SITE } from "../lib/site";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <!-- The query carries a credential: keep it out of indexes and headers. -->
    <meta name="robots" content="noindex,nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#08080b" />
    <title>Pair with {SITE.name}</title>
  </head>
  <body>
    <main>
      <h1>Pair this device</h1>

      <p id="lede" class="lede">Reading your pairing link&hellip;</p>

      <section id="details" hidden>
        <dl>
          <div><dt>Server</dt><dd id="server">&mdash;</dd></div>
          <div id="name-row" hidden><dt>Name</dt><dd id="name">&mdash;</dd></div>
          <div id="fp-row" hidden>
            <dt>Certificate</dt><dd id="fp" class="mono">&mdash;</dd>
          </div>
        </dl>
        <a id="open" class="button" href="#">Open in {SITE.name}</a>
        <p class="hint">
          If nothing opens, install the app on this device.
        </p>
      </section>

      <section id="install" hidden>
        <p>
          Install {SITE.name} on the host, then scan its pairing code
          from the app.
        </p>
        <pre class="mono">curl -fsSL https://phux.sh/install | sh</pre>
      </section>

      <section id="bad" hidden>
        <p>
          This pairing link is invalid or incomplete.
          Paste the complete link printed by <code>phux pair</code> below.
          You do not need to scan a QR code on this phone.
        </p>
        <form id="recover">
          <label for="pairing-link">Pairing link</label>
          <textarea id="pairing-link" rows="4" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="https://phux.sh/connect?…"></textarea>
          <button class="button" type="submit">Open in {SITE.name}</button>
          <p class="hint">The link contains a password. It stays on this device.</p>
        </form>
      </section>
    </main>

    <script is:inline>
      (function () {
        var lede = document.getElementById("lede");
        function show(id) {
          document.getElementById(id).hidden = false;
        }

        function unique(q, key) {
          var values = q.getAll(key);
          return values.length === 1 ? values[0] : null;
        }

        function endpoint(raw, protocols) {
          try {
            var parsed = new URL(raw);
            return protocols.includes(parsed.protocol) && !!parsed.hostname &&
              !parsed.username && !parsed.password && !parsed.hash;
          } catch (_) {
            return false;
          }
        }

        function destination(q) {
          var quic = unique(q, "quic");
          var ws = unique(q, "url");
          if (q.has("url") && !endpoint(ws, ["ws:", "wss:"])) return null;
          if (q.has("quic") && !quicEndpoint(quic)) return null;
          var sni = unique(q, "sni");
          if (!validRoute(sni, quic)) return null;
          if (!ws && !sni) return null;
          return quic || ws;
        }

        function validRoute(sni, quic) {
          if (!sni) return true;
          if (!quic) return false;
          var name = sni.trim();
          var labels = name.split(".");
          var ip = labels.length === 4 && labels.every(function (label) {
            return /^(0|[1-9][0-9]{0,2})$/.test(label) && Number(label) <= 255;
          });
          return name.length <= 253 && !ip && labels.every(function (label) {
            return /^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/i.test(label);
          });
        }

        function quicEndpoint(raw) {
          if (!endpoint(raw, ["quic:"])) return false;
          var parsed = new URL(raw);
          return !!parsed.port && Number(parsed.port) > 0 &&
            !parsed.pathname && !parsed.search;
        }

        function unambiguous(q) {
          return ["url", "quic", "sni", "token", "name", "fp"].every(function (key) {
            return q.getAll(key).length <= 1;
          });
        }

        function optionalDetail(q, key, row) {
          var value = unique(q, key);
          document.getElementById(row).hidden = !value;
          document.getElementById(key).textContent = value || "";
        }

        function readPairing(search) {
          // The emitter percent-encodes spaces and treats a literal + as +,
          // not HTML form encoding. Preserve its query bytes in the handoff.
          var q = new URLSearchParams(search.replace(/\+/g, "%2B"));
          var target = destination(q);
          if (!target || !unique(q, "token") || !unambiguous(q)) {
            lede.textContent = "That link is incomplete. Copy the whole link, including everything after the question mark.";
            show("bad");
            return null;
          }
          var deepLink = "phux://connect?" + search.replace(/^\?/, "");
          document.getElementById("server").textContent = target;
          optionalDetail(q, "name", "name-row");
          optionalDetail(q, "fp", "fp-row");
          document.getElementById("open").setAttribute("href", deepLink);
          document.getElementById("bad").hidden = true;
          lede.textContent = "Open the app to finish pairing. This page handles the link on your device.";
          show("details");
          show("install");
          return deepLink;
        }

        // Scrub even malformed links: a missing endpoint can still carry a
        // valid secret. Keep it only in memory, never storage or a request.
        var search = window.location.search;
        try {
          window.history.replaceState({}, "", window.location.pathname);
        } catch (_) {
          /* history is unavailable in some embedded browsers; not fatal. */
        }
        readPairing(search);

        document.getElementById("recover").addEventListener("submit", function (event) {
          event.preventDefault();
          var input = document.getElementById("pairing-link");
          try {
            // A long terminal URL may have acquired line breaks while copying.
            var link = new URL(input.value.replace(/\s/g, ""));
            var supported = link.protocol === "phux:" && link.hostname === "connect";
            var universal = link.protocol === "https:" && link.hostname === "phux.sh" && link.pathname === "/connect";
            if (!supported && !universal) throw new Error("Not a pairing link");
            var deepLink = readPairing(link.search);
            if (!deepLink) return;
            input.value = "";
            window.location.href = deepLink;
          } catch (_) {
            lede.textContent = "Paste the complete phux pairing link, not just the server address.";
          }
        });
      })();
    </script>

    <style>
      :root {
        color-scheme: dark;
        --bg: #08080b;
        --fg: #e8e8ee;
        --muted: #9a9aa8;
        --line: #232330;
        --accent: #7cf1b0;
      }
      html,
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font:
          16px/1.6 ui-sans-serif,
          system-ui,
          -apple-system,
          sans-serif;
      }
      main {
        max-width: 34rem;
        margin: 0 auto;
        padding: 3rem 1rem 4rem;
      }
      h1 {
        font-size: 1.5rem;
        letter-spacing: -0.01em;
        margin: 0 0 0.75rem;
      }
      .lede {
        color: var(--muted);
        margin: 0 0 2rem;
      }
      dl {
        margin: 0 0 1.75rem;
        border-top: 1px solid var(--line);
      }
      dl > div {
        display: flex;
        gap: 1rem;
        padding: 0.7rem 0;
        border-bottom: 1px solid var(--line);
      }
      dt {
        flex: 0 0 6.5rem;
        color: var(--muted);
      }
      dd {
        margin: 0;
        min-width: 0;
        overflow-wrap: anywhere;
      }
      .mono {
        font:
          13px/1.5 ui-monospace,
          SFMono-Regular,
          Menlo,
          monospace;
      }
      .button {
        width: 100%;
        box-sizing: border-box;
        border: 0;
        font: inherit;
        display: block;
        text-align: center;
        background: var(--accent);
        color: #06120c;
        font-weight: 600;
        text-decoration: none;
        padding: 0.85rem 1rem;
        border-radius: 0.6rem;
      }
      .hint {
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
      }
      textarea {
        width: 100%;
        box-sizing: border-box;
        margin: 0.5rem 0 1rem;
        padding: 0.75rem;
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        background: var(--bg);
        color: var(--fg);
        font: inherit;
      }
      section {
        margin-bottom: 2rem;
      }
      pre {
        background: #101018;
        border: 1px solid var(--line);
        border-radius: 0.5rem;
        padding: 0.8rem 1rem;
        overflow-x: auto;
      }
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      }
    </style>
  </body>
</html>
