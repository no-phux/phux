{
  "phux_mail_send": {
    "type": "object",
    "properties": {
      "schema": {
        "type": "string",
        "const": "phux.coord/v1"
      },
      "mail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "thread": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "body": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "read_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "acked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "thread",
          "from",
          "to",
          "body",
          "created_at"
        ]
      },
      "operation_id": {
        "type": "string",
        "pattern": "^[0-9a-f]{32}$",
        "description": "Durable identity in the local work store; not an adapter receipt."
      },
      "replayed": {
        "type": "boolean"
      },
      "scope": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "const": "work_store"
          },
          "id": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "schema",
      "mail"
    ]
  },
