{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://phux.dev/schema/phux.mission.v1.schema.json",
  "title": "phux.mission/v1",
  "description": "JSON documents printed by `phux mission --json`. Every document carries schema phux.mission/v1. A task alias is the full repo/n form, such as phux/3. State needs_you is the needs-you state.",
  "oneOf": [
    { "$ref": "#/definitions/list" },
    { "$ref": "#/definitions/show" },
    { "$ref": "#/definitions/mutation" },
    { "$ref": "#/definitions/error" }
  ],
  "definitions": {
    "schemaName": {
      "const": "phux.mission/v1"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "alias",
        "repo",
        "title",
        "description",
        "state",
        "revision",
        "archived",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "alias": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}/[1-9][0-9]{0,18}$"
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "state": {
          "enum": ["todo", "working", "needs_you"]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "archived": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "updated_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "verb", "tasks"],
      "properties": {
        "schema": { "$ref": "#/definitions/schemaName" },
        "schema_version": { "const": 1 },
        "verb": { "const": "list" },
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/task" }
        }
      }
    },
    "show": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "verb", "task"],
      "properties": {
        "schema": { "$ref": "#/definitions/schemaName" },
        "schema_version": { "const": 1 },
        "verb": { "const": "show" },
        "task": { "$ref": "#/definitions/task" }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_version",
        "verb",
        "operation_id",
        "idempotent_replay",
        "task"
      ],
      "properties": {
        "schema": { "$ref": "#/definitions/schemaName" },
        "schema_version": { "const": 1 },
        "verb": {
          "enum": ["add", "edit", "archive", "restore"]
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "idempotent_replay": {
          "type": "boolean"
        },
        "task": { "$ref": "#/definitions/task" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "error", "remedy", "exit_code"],
      "properties": {
        "schema": { "$ref": "#/definitions/schemaName" },
        "schema_version": { "const": 1 },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {
              "enum": [
                "mission_not_found",
                "mission_revision_conflict",
                "mission_operation_conflict",
                "mission_unsupported_schema",
                "mission_busy",
                "mission_store",
                "usage_error"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "remedy": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "enum": [1, 2]
        }
      }
    }
  }
}
