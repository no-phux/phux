{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phux.sh/brand/tokens/phux.tokens.schema.json",
  "title": "phux design tokens (resolved)",
  "description": "The resolved file every generator reads (design spec §1.12). Closed: a consumer may not invent a role; a missing need is a schema change in phux.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "design_version", "house", "house_name", "color", "terminal", "variants", "vocabulary", "status", "type", "radius", "space", "icon", "layout", "haptic", "elevation", "motion", "material", "derive", "results", "identity"],
  "properties": {
    "$schema": { "const": "./phux.tokens.schema.json" },
    "schema": { "const": 2 },
    "design_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "house": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "house_name": { "type": "string" },
    "color": { "$ref": "#/$defs/rolesByMode" },
    "terminal": {
      "type": "object", "additionalProperties": false, "required": ["dark", "light"],
      "properties": { "dark": { "$ref": "#/$defs/terminal" }, "light": { "$ref": "#/$defs/terminal" } }
    },
    "variants": {
      "type": "object", "additionalProperties": false, "required": ["reader", "contrast_more", "forced_colors"],
      "properties": {
        "reader": {
          "type": "object", "additionalProperties": false, "required": ["color", "type"],
          "properties": {
            "color": { "$ref": "#/$defs/rolesByMode" },
            "type": {
              "type": "object", "additionalProperties": false, "required": ["lead"],
              "properties": {
                "lead": {
                  "type": "object", "additionalProperties": false, "required": ["size", "line_height"],
                  "properties": { "size": { "$ref": "#/$defs/platform" }, "line_height": { "$ref": "#/$defs/platform" } }
                }
              }
            }
          }
        },
        "contrast_more": {
          "type": "object", "additionalProperties": false, "required": ["color"],
          "properties": { "color": { "$ref": "#/$defs/rolesByMode" } }
        },
        "forced_colors": {
          "type": "object",
          "propertyNames": { "enum": ["layer", "text", "border", "wash", "accent", "status", "selection", "match", "diff", "control"] },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "enum": ["Canvas", "CanvasText", "LinkText", "VisitedText", "ActiveText", "ButtonFace", "ButtonText", "ButtonBorder", "Field", "FieldText", "Highlight", "HighlightText", "SelectedItem", "SelectedItemText", "Mark", "MarkText", "GrayText", "AccentColor", "AccentColorText", "transparent"] }
          }
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "required": ["needs_you", "working", "done", "failed", "lost", "idle", "ended", "bell", "count.needs_you", "count.failed", "count.done"],
      "propertyNames": { "pattern": "^(count\\.)?[a-z_]+$" },
      "additionalProperties": { "type": "string" }
    },
    "status": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["state", "color", "word", "glyph", "ascii", "icon", "sf_symbol", "rank", "bold"],
        "properties": {
          "state": { "enum": ["needs_you", "failed", "lost", "done", "working", "done_seen", "idle", "unknown", "ended", "bell"] },
          "color": { "type": "string", "pattern": "^(status|text)\\.[a-z_]+$" },
          "word": { "type": "string" },
          "glyph": { "type": "string" },
          "ascii": { "type": "string", "pattern": "^[ -~]$" },
          "icon": { "type": "string", "pattern": "^status-[a-z-]+$" },
          "sf_symbol": { "type": "string" },
          "rank": { "type": "integer", "minimum": 0, "maximum": 8 },
          "bold": { "type": "boolean" }
        }
      }
    },
    "type": {
      "type": "object", "additionalProperties": false, "required": ["family", "weights", "role"],
      "properties": {
        "family": {
          "type": "object", "additionalProperties": false, "required": ["ui", "mono"],
          "properties": { "ui": { "$ref": "#/$defs/family" }, "mono": { "$ref": "#/$defs/family" } }
        },
        "weights": {
          "type": "object", "additionalProperties": false, "required": ["regular", "medium", "semibold"],
          "properties": { "regular": { "type": "integer" }, "medium": { "type": "integer" }, "semibold": { "type": "integer" } }
        },
        "role": {
          "type": "object", "additionalProperties": false,
          "required": ["micro", "caption", "label", "body", "lead", "title", "display"],
          "properties": {
            "micro": { "$ref": "#/$defs/typeRole" }, "caption": { "$ref": "#/$defs/typeRole" }, "label": { "$ref": "#/$defs/typeRole" },
            "body": { "$ref": "#/$defs/typeRole" }, "lead": { "$ref": "#/$defs/typeRole" }, "title": { "$ref": "#/$defs/typeRole" },
            "display": { "$ref": "#/$defs/typeRole" }
          }
        }
      }
    },
    "radius": {
      "type": "object", "additionalProperties": false, "required": ["xs", "sm", "md", "lg", "xl", "full"],
      "properties": {
        "xs": { "type": "number", "minimum": 0 }, "sm": { "type": "number", "minimum": 0 }, "md": { "type": "number", "minimum": 0 },
        "lg": { "type": "number", "minimum": 0 }, "xl": { "type": "number", "minimum": 0 }, "full": { "const": 9999 }
      }
    },
    "space": {
      "type": "object", "additionalProperties": false,
      "required": ["s0", "s0_5", "s1", "s2", "s3", "s4", "s5", "s6", "s8", "s10", "s12", "s16", "row_h", "row_h_touch", "row_inset_x", "icon_gap", "card_gap", "card_inset", "sheet_pad", "page_margin", "section", "pointer_min", "touch_min", "bottom_bar_touch", "titlebar_h", "sidebar_w", "hairline", "focus_ring"],
      "properties": {
        "s0": { "const": 0 }, "s0_5": { "const": 2 }, "s1": { "const": 4 }, "s2": { "const": 8 }, "s3": { "const": 12 }, "s4": { "const": 16 },
        "s5": { "const": 20 }, "s6": { "const": 24 }, "s8": { "const": 32 }, "s10": { "const": 40 }, "s12": { "const": 48 }, "s16": { "const": 64 },
        "row_h": { "type": "number" }, "row_h_touch": { "$ref": "#/$defs/platform" }, "row_inset_x": { "type": "number" },
        "icon_gap": { "type": "number" }, "card_gap": { "type": "number" }, "card_inset": { "type": "number" }, "sheet_pad": { "type": "number" },
        "page_margin": { "$ref": "#/$defs/platform" }, "section": { "type": "number" }, "pointer_min": { "type": "number", "minimum": 24 },
        "touch_min": { "$ref": "#/$defs/platform" }, "bottom_bar_touch": { "$ref": "#/$defs/platform" }, "titlebar_h": { "type": "number" },
        "sidebar_w": { "type": "number" }, "hairline": { "const": 1 },
        "focus_ring": {
          "type": "object", "additionalProperties": false, "required": ["width", "offset"],
          "properties": { "width": { "type": "number" }, "offset": { "type": "number" } }
        }
      }
    },
    "icon": {
      "type": "object", "additionalProperties": false, "required": ["size", "grid", "button"],
      "properties": {
        "size": { "$ref": "#/$defs/numbers", "required": ["xs", "sm", "md", "lg", "xl", "xxl"] },
        "grid": { "type": "number" },
        "button": { "$ref": "#/$defs/numbers", "required": ["sm", "md", "lg"] }
      }
    },
    "layout": {
      "type": "object", "additionalProperties": false, "required": ["breakpoint", "content_max"],
      "properties": {
        "breakpoint": { "$ref": "#/$defs/numbers", "required": ["compact", "desktop_min_w", "desktop_min_h"] },
        "content_max": { "$ref": "#/$defs/numbers", "required": ["phone_column", "reader"] }
      }
    },
    "haptic": {
      "type": "object", "additionalProperties": false,
      "required": ["selection", "impact_light", "impact_medium", "success", "warning", "error"],
      "propertyNames": { "enum": ["selection", "impact_light", "impact_medium", "success", "warning", "error"] },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["ios", "android", "android_legacy"],
        "properties": {
          "ios": { "type": "string" },
          "android": { "enum": ["CLOCK_TICK", "CONTEXT_CLICK", "VIRTUAL_KEY", "CONFIRM", "REJECT"] },
          "android_legacy": { "enum": ["CLOCK_TICK", "CONTEXT_CLICK", "VIRTUAL_KEY"] }
        }
      }
    },
    "elevation": {
      "type": "object", "additionalProperties": false, "required": ["dark", "light"],
      "properties": { "dark": { "$ref": "#/$defs/elevation" }, "light": { "$ref": "#/$defs/elevation" } }
    },
    "motion": {
      "type": "object", "additionalProperties": false, "required": ["spring", "curve", "loop", "enter_scale"],
      "properties": {
        "spring": {
          "type": "object", "additionalProperties": false,
          "required": ["press", "control", "select", "list", "pop", "drawer", "page", "settle"],
          "properties": {
            "press": { "$ref": "#/$defs/springPair" }, "control": { "$ref": "#/$defs/springPair" }, "select": { "$ref": "#/$defs/springPair" },
            "list": { "$ref": "#/$defs/springPair" }, "pop": { "$ref": "#/$defs/springPair" }, "drawer": { "$ref": "#/$defs/springPair" },
            "page": { "$ref": "#/$defs/springPair" }, "settle": { "$ref": "#/$defs/springPair" }
          }
        },
        "curve": {
          "type": "object", "additionalProperties": false, "required": ["fade", "recolor"],
          "properties": { "fade": { "$ref": "#/$defs/curve" }, "recolor": { "$ref": "#/$defs/curve" } }
        },
        "loop": {
          "type": "object", "additionalProperties": false, "required": ["pulse", "shimmer", "indeterminate"],
          "properties": {
            "pulse": {
              "type": "object", "additionalProperties": false, "required": ["period", "min_opacity"],
              "properties": { "period": { "type": "number", "minimum": 0 }, "min_opacity": { "type": "number", "minimum": 0, "maximum": 1 } }
            },
            "shimmer": { "$ref": "#/$defs/period" },
            "indeterminate": { "$ref": "#/$defs/period" }
          }
        },
        "enter_scale": { "type": "number", "minimum": 0.9, "maximum": 1 }
      }
    },
    "material": {
      "type": "object", "additionalProperties": false, "required": ["default", "glass", "metal"],
      "properties": {
        "default": { "const": "solid" },
        "glass": {
          "type": "object", "additionalProperties": false, "required": ["where", "blur", "tint", "tint_min", "ring"],
          "properties": {
            "where": { "type": "array", "items": { "$ref": "#/$defs/glassSurface" } },
            "blur": { "type": "object", "propertyNames": { "$ref": "#/$defs/glassSurface" }, "additionalProperties": { "type": "number", "minimum": 0 } },
            "tint": {
              "type": "object", "additionalProperties": false, "required": ["dark", "light"],
              "properties": { "dark": { "$ref": "#/$defs/tint" }, "light": { "$ref": "#/$defs/tint" } }
            },
            "tint_min": { "$ref": "#/$defs/modeNumber" },
            "ring": { "const": "border.base" }
          }
        },
        "metal": {
          "type": "object", "additionalProperties": false, "required": ["stops", "rim", "sheen"],
          "properties": {
            "stops": {
              "type": "object", "additionalProperties": false, "required": ["dark", "light"],
              "properties": { "dark": { "$ref": "#/$defs/metalStops" }, "light": { "$ref": "#/$defs/metalStops" } }
            },
            "rim": { "const": "border.strong" },
            "sheen": {
              "type": "object", "additionalProperties": false, "required": ["spring", "passes"],
              "properties": { "spring": { "$ref": "#/$defs/spring" }, "passes": { "const": 1 } }
            }
          }
        }
      }
    },
    "derive": { "$ref": "#/$defs/derive" },
    "results": {
      "type": "object", "additionalProperties": false, "required": ["oklab_delta_e", "verify", "terminal_diff"],
      "properties": {
        "oklab_delta_e": {
          "type": "object", "additionalProperties": false, "required": ["dark", "light"],
          "properties": {
            "dark": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
            "light": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
          }
        },
        "verify": {
          "type": "object", "additionalProperties": false, "required": ["house", "reader", "contrast_more"],
          "properties": {
            "house": { "type": "array", "items": { "$ref": "#/$defs/violation" } },
            "reader": { "type": "array", "items": { "$ref": "#/$defs/violation" } },
            "contrast_more": { "type": "array", "items": { "$ref": "#/$defs/violation" } }
          }
        },
        "terminal_diff": {
          "type": "object", "additionalProperties": false, "required": ["dark", "light"],
          "properties": {
            "dark": { "type": "array", "items": { "$ref": "#/$defs/diff" } },
            "light": { "type": "array", "items": { "$ref": "#/$defs/diff" } }
          }
        }
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["host_palette", "auto_count", "session_palette", "provider", "host_bar", "host_ease_max", "glow_alpha"],
      "properties": {
        "host_palette": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "color"],
            "properties": { "id": { "type": "string", "pattern": "^[a-z]+$" }, "color": { "$ref": "#/$defs/opaque" } }
          }
        },
        "auto_count": { "type": "integer", "minimum": 1 },
        "session_palette": { "type": "array", "items": { "type": "string", "pattern": "^[a-z]+$" } },
        "provider": { "type": "object", "additionalProperties": { "$ref": "#/$defs/opaque" } },
        "host_bar": { "type": "number" },
        "host_ease_max": { "type": "number", "minimum": 0, "maximum": 1 },
        "glow_alpha": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}([0-9A-F]{2})?$" },
    "opaque": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
    "translucent": { "type": "string", "pattern": "^#[0-9A-F]{8}$" },
    "numbers": { "type": "object", "additionalProperties": { "type": "number" } },
    "modeNumber": {
      "type": "object", "additionalProperties": false, "required": ["dark", "light"],
      "properties": { "dark": { "type": "number" }, "light": { "type": "number" } }
    },
    "platform": {
      "type": "object", "additionalProperties": false, "required": ["desktop"],
      "properties": { "desktop": { "type": "number" }, "ios": { "type": "number" }, "android": { "type": "number" }, "web": { "type": "number" } }
    },
    "group": { "type": "object", "additionalProperties": { "$ref": "#/$defs/hex" } },
    "rolesByMode": {
      "type": "object", "additionalProperties": false, "required": ["dark", "light"],
      "properties": { "dark": { "$ref": "#/$defs/roles" }, "light": { "$ref": "#/$defs/roles" } }
    },
    "roles": {
      "type": "object", "additionalProperties": false,
      "required": ["layer", "text", "border", "wash", "accent", "status", "match", "diff", "syntax", "selection", "flat"],
      "properties": {
        "layer": {
          "type": "object", "additionalProperties": false, "required": ["ground", "sidebar", "raised", "overlay", "scrim"],
          "properties": {
            "ground": { "$ref": "#/$defs/opaque" }, "sidebar": { "$ref": "#/$defs/opaque" }, "raised": { "$ref": "#/$defs/opaque" },
            "overlay": { "$ref": "#/$defs/opaque" }, "scrim": { "$ref": "#/$defs/translucent" }
          }
        },
        "text": {
          "type": "object", "additionalProperties": false, "required": ["text", "dim", "faint", "inverse"],
          "properties": {
            "text": { "$ref": "#/$defs/opaque" }, "dim": { "$ref": "#/$defs/opaque" }, "faint": { "$ref": "#/$defs/opaque" }, "inverse": { "$ref": "#/$defs/opaque" }
          }
        },
        "border": {
          "type": "object", "additionalProperties": false, "required": ["muted", "base", "strong", "control", "focus"],
          "properties": {
            "muted": { "$ref": "#/$defs/hex" }, "base": { "$ref": "#/$defs/hex" }, "strong": { "$ref": "#/$defs/hex" },
            "control": { "$ref": "#/$defs/opaque" }, "focus": { "$ref": "#/$defs/opaque" }
          }
        },
        "wash": {
          "type": "object", "additionalProperties": false, "required": ["hover", "press", "current", "selected"],
          "properties": {
            "hover": { "$ref": "#/$defs/translucent" }, "press": { "$ref": "#/$defs/translucent" },
            "current": { "$ref": "#/$defs/translucent" }, "selected": { "$ref": "#/$defs/translucent" }
          }
        },
        "accent": {
          "type": "object", "additionalProperties": false, "required": ["accent", "on_accent", "accent_text"],
          "properties": {
            "accent": { "$ref": "#/$defs/opaque" }, "on_accent": { "$ref": "#/$defs/opaque" }, "accent_text": { "$ref": "#/$defs/opaque" },
            "hi": { "$ref": "#/$defs/opaque" }, "lo": { "$ref": "#/$defs/opaque" }
          }
        },
        "status": {
          "type": "object", "additionalProperties": false,
          "required": ["needs_you", "needs_you_wash", "needs_you_edge", "needs_you_glow", "working", "working_wash", "working_edge", "working_glow", "done", "done_wash", "done_edge", "done_glow", "failed", "failed_wash", "failed_edge", "failed_glow", "idle", "idle_wash", "idle_edge", "idle_glow", "unknown", "unknown_wash", "unknown_edge", "unknown_glow", "bell", "bell_wash", "bell_edge", "bell_glow"],
          "propertyNames": { "pattern": "^(needs_you|working|done|failed|idle|unknown|bell)(_wash|_edge|_glow)?$" },
          "additionalProperties": { "$ref": "#/$defs/hex" }
        },
        "match": {
          "type": "object", "additionalProperties": false, "required": ["bg", "current_bg", "current_fg"],
          "properties": { "bg": { "$ref": "#/$defs/translucent" }, "current_bg": { "$ref": "#/$defs/opaque" }, "current_fg": { "$ref": "#/$defs/opaque" } }
        },
        "diff": {
          "type": "object", "additionalProperties": false, "required": ["add", "remove", "add_text", "remove_text"],
          "properties": {
            "add": { "$ref": "#/$defs/translucent" }, "remove": { "$ref": "#/$defs/translucent" },
            "add_text": { "$ref": "#/$defs/opaque" }, "remove_text": { "$ref": "#/$defs/opaque" }
          }
        },
        "syntax": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/opaque" } },
        "selection": {
          "type": "object", "additionalProperties": false, "required": ["bg", "fg"],
          "properties": { "bg": { "$ref": "#/$defs/opaque" }, "fg": { "$ref": "#/$defs/opaque" } }
        },
        "flat": {
          "type": "object", "additionalProperties": false, "required": ["ground", "sidebar", "raised", "overlay"],
          "properties": {
            "ground": { "$ref": "#/$defs/flatLayer" }, "sidebar": { "$ref": "#/$defs/flatLayer" },
            "raised": { "$ref": "#/$defs/flatLayer" }, "overlay": { "$ref": "#/$defs/flatLayer" }
          }
        }
      }
    },
    "flatLayer": {
      "type": "object",
      "propertyNames": { "enum": ["layer", "border", "wash", "status", "match", "diff"] },
      "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/opaque" } }
    },
    "terminal": {
      "type": "object", "additionalProperties": false, "required": ["bg", "fg", "cursor", "cursor_text", "selection_bg", "ansi"],
      "properties": {
        "bg": { "$ref": "#/$defs/opaque" }, "fg": { "$ref": "#/$defs/opaque" }, "cursor": { "$ref": "#/$defs/opaque" },
        "cursor_text": { "$ref": "#/$defs/opaque" }, "selection_bg": { "$ref": "#/$defs/opaque" },
        "ansi": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/opaque" } }
      }
    },
    "family": {
      "type": "object", "additionalProperties": false, "required": ["name", "stack", "features"],
      "properties": {
        "name": { "type": "string" },
        "stack": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "features": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]{4}$" } }
      }
    },
    "typeRole": {
      "type": "object", "additionalProperties": false, "required": ["family", "size", "weight", "line_height", "tracking_em", "features"],
      "properties": {
        "family": { "enum": ["ui", "mono"] },
        "size": { "$ref": "#/$defs/platform" },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "line_height": { "$ref": "#/$defs/platform" },
        "tracking_em": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]{4}$" } }
      }
    },
    "shadow": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "blur", "spread", "color", "alpha", "kind"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" }, "blur": { "type": "number", "minimum": 0 }, "spread": { "type": "number" },
        "color": { "$ref": "#/$defs/opaque" }, "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "kind": { "enum": ["ring", "lit", "drop"] }
      }
    },
    "tier": { "type": "array", "maxItems": 4, "items": { "$ref": "#/$defs/shadow" } },
    "elevation": {
      "type": "object", "additionalProperties": false, "required": ["flat", "raised", "floating", "overlay", "glow"],
      "properties": {
        "flat": { "type": "array", "maxItems": 0 },
        "raised": { "$ref": "#/$defs/tier" }, "floating": { "$ref": "#/$defs/tier" }, "overlay": { "$ref": "#/$defs/tier" },
        "glow": {
          "type": "object", "additionalProperties": false, "required": ["x", "y", "blur", "spread", "kind", "alpha"],
          "properties": {
            "x": { "const": 0 }, "y": { "const": 0 }, "blur": { "type": "number" }, "spread": { "type": "number" },
            "kind": { "const": "glow" }, "alpha": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "spring": {
      "type": "object", "additionalProperties": false, "required": ["duration", "bounce"],
      "properties": { "duration": { "type": "number", "minimum": 0 }, "bounce": { "type": "number", "minimum": -1, "maximum": 1 } }
    },
    "springPair": {
      "type": "object", "additionalProperties": false, "required": ["enter", "exit"],
      "properties": { "enter": { "$ref": "#/$defs/spring" }, "exit": { "$ref": "#/$defs/spring" } }
    },
    "curve": {
      "type": "object", "additionalProperties": false, "required": ["duration", "cubic_bezier"],
      "properties": {
        "duration": { "type": "number", "minimum": 0 },
        "cubic_bezier": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } }
      }
    },
    "period": {
      "type": "object", "additionalProperties": false, "required": ["period"],
      "properties": { "period": { "type": "number", "minimum": 0 } }
    },
    "glassSurface": { "enum": ["sidebar", "titlebar", "floating", "overlay", "phone_bar", "composer", "toast"] },
    "tint": {
      "type": "object", "additionalProperties": false, "required": ["layer", "alpha", "color"],
      "properties": {
        "layer": { "enum": ["ground", "sidebar", "raised", "overlay"] },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "color": { "$ref": "#/$defs/hex" }
      }
    },
    "metalStops": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["at", "role", "color"],
        "properties": {
          "at": { "type": "number", "minimum": 0, "maximum": 1 },
          "role": { "enum": ["accent.hi", "accent.accent", "accent.lo"] },
          "color": { "$ref": "#/$defs/opaque" }
        }
      }
    },
    "violation": {
      "type": "object", "additionalProperties": false, "required": ["id", "severity", "role", "surface", "value", "bar", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^V([1-9]|1[0-7])$" },
        "severity": { "enum": ["error", "warning"] },
        "role": { "type": "string" }, "surface": { "type": "string" },
        "value": { "type": "number" }, "bar": { "type": "number" },
        "mode": { "enum": ["dark", "light"] }
      }
    },
    "diff": {
      "type": "object", "additionalProperties": false, "required": ["role", "authored", "derived"],
      "properties": { "role": { "type": "string" }, "authored": { "$ref": "#/$defs/hex" }, "derived": { "$ref": "#/$defs/hex" } }
    },
    "derive": {
      "type": "object", "additionalProperties": false,
      "required": ["light_threshold", "bars", "contrast_more", "iterations", "slots", "selection_mix", "status_alpha", "match_alpha", "diff_alpha", "max_shadow_layers", "tier_surfaces", "floor_surfaces", "floor_washes", "srgb_lut", "layers", "alpha", "wash_selected_source", "scrim", "glass"],
      "properties": {
        "light_threshold": { "type": "number" },
        "bars": {
          "type": "object", "additionalProperties": false,
          "required": ["text", "tier_ratio", "tier_min", "text_floor", "signal", "on_accent", "focus", "control", "accent_indicator", "border_strong", "layer_step", "pulse_trough", "cursor"],
          "properties": {
            "text": { "type": "number" }, "tier_ratio": { "type": "number" }, "tier_min": { "type": "number" }, "text_floor": { "type": "number" },
            "signal": { "type": "number" }, "on_accent": { "type": "number" }, "focus": { "type": "number" }, "control": { "type": "number" },
            "accent_indicator": { "type": "number" }, "border_strong": { "type": "number" }, "layer_step": { "type": "number" },
            "pulse_trough": { "type": "number" }, "cursor": { "type": "number" }
          }
        },
        "contrast_more": {
          "type": "object", "additionalProperties": false, "required": ["text_floor", "control", "border_strong", "wash_scale"],
          "properties": { "text_floor": { "type": "number" }, "control": { "type": "number" }, "border_strong": { "type": "number" }, "wash_scale": { "type": "number" } }
        },
        "iterations": { "const": 24 },
        "slots": {
          "type": "object", "additionalProperties": false, "required": ["failed", "done", "needs_you", "working", "bell", "accent", "match"],
          "properties": {
            "failed": { "type": "integer", "minimum": 0, "maximum": 15 }, "done": { "type": "integer", "minimum": 0, "maximum": 15 },
            "needs_you": { "type": "integer", "minimum": 0, "maximum": 15 }, "working": { "type": "integer", "minimum": 0, "maximum": 15 },
            "bell": { "type": "integer", "minimum": 0, "maximum": 15 }, "accent": { "type": "integer", "minimum": 0, "maximum": 15 },
            "match": { "type": "integer", "minimum": 0, "maximum": 15 }
          }
        },
        "selection_mix": { "type": "number" },
        "status_alpha": {
          "type": "object", "additionalProperties": false, "required": ["wash", "edge", "glow"],
          "properties": { "wash": { "type": "number" }, "edge": { "type": "number" }, "glow": { "type": "number" } }
        },
        "match_alpha": {
          "type": "object", "additionalProperties": false, "required": ["bg"],
          "properties": { "bg": { "type": "number" } }
        },
        "diff_alpha": { "type": "number" },
        "max_shadow_layers": { "const": 4 },
        "tier_surfaces": { "const": ["ground", "sidebar", "raised", "overlay"] },
        "floor_surfaces": { "type": "string" },
        "floor_washes": { "const": ["hover", "press", "current", "selected"] },
        "srgb_lut": { "type": "array", "minItems": 256, "maxItems": 256, "items": { "type": "string", "pattern": "^[0-9A-F]{16}$" } },
        "layers": {
          "type": "object", "additionalProperties": false, "required": ["dark", "light"],
          "properties": { "dark": { "$ref": "#/$defs/layerSteps" }, "light": { "$ref": "#/$defs/layerSteps" } }
        },
        "alpha": {
          "type": "object", "additionalProperties": false, "required": ["dark", "light"],
          "properties": { "dark": { "$ref": "#/$defs/alphas" }, "light": { "$ref": "#/$defs/alphas" } }
        },
        "wash_selected_source": { "enum": ["fg", "accent"] },
        "scrim": { "$ref": "#/$defs/modeNumber" },
        "glass": {
          "type": "object", "additionalProperties": false, "required": ["tint_min"],
          "properties": { "tint_min": { "$ref": "#/$defs/modeNumber" } }
        }
      }
    },
    "layerSteps": {
      "type": "object", "additionalProperties": false, "required": ["sidebar", "raised", "overlay"],
      "properties": {
        "sidebar": { "type": "number", "minimum": -1, "maximum": 1 }, "raised": { "type": "number", "minimum": -1, "maximum": 1 },
        "overlay": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "alphas": {
      "type": "object", "additionalProperties": false, "required": ["border", "wash"],
      "properties": {
        "border": {
          "type": "object", "additionalProperties": false, "required": ["muted", "base", "strong"],
          "properties": { "muted": { "type": "number" }, "base": { "type": "number" }, "strong": { "type": "number" } }
        },
        "wash": {
          "type": "object", "additionalProperties": false, "required": ["hover", "press", "current", "selected"],
          "properties": { "hover": { "type": "number" }, "press": { "type": "number" }, "current": { "type": "number" }, "selected": { "type": "number" } }
        }
      }
    }
  }
}
