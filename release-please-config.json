{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",

  "draft-pull-request": true,
  "always-update": true,
  "draft": true,
  "force-tag-creation": true,
  "separate-pull-requests": false,
  "sequential-calls": true,

  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,

  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactors" },
    { "type": "docs", "section": "Documentation" },
    { "type": "build", "section": "Build System" },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],

  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "clients/desktop",
        "clients/rune",
        "integrations/runtime",
        "integrations/opencode-v2",
        "integrations/pi",
        "integrations/claude",
        ".claude-plugin",
        "integrations/omp",
        "integrations/grok",
        ".grok-plugin"
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "generic",
          "path": ".agents/skills/using-phux/SKILL.md"
        },
        {
          "type": "generic",
          "path": ".agents/skills/using-phux-mcp/SKILL.md"
        }
      ]
    },
    "clients/desktop": {
      "release-type": "node",
      "component": "desktop",
      "separate-pull-requests": true,
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease-type": "alpha.1",
      "prerelease": false
    },
    "integrations/pi": {
      "release-type": "node",
      "component": "pi-extension",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    },
    "integrations/opencode-v2": {
      "release-type": "node",
      "component": "opencode-plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    },
    "integrations/omp": {
      "release-type": "node",
      "component": "omp-extension",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0"
    },
    "integrations/grok": {
      "release-type": "node",
      "component": "grok-plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "json",
          "path": ".grok-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/.grok-plugin/marketplace.json",
          "jsonpath": "$.plugins[?(@.name=='phux')].version"
        }
      ]
    },
    "integrations/claude": {
      "release-type": "node",
      "component": "claude-plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/.claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[?(@.name=='phux')].version"
        }
      ]
    }
  }
}
