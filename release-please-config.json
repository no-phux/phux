{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "draft-pull-request": true,
  "always-update": true,
  "draft": true,
  "force-tag-creation": true,
  "separate-pull-requests": false,
  "sequential-calls": true,
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactors"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Build System"
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": [
        "clients/rune",
        "integrations/runtime",
        "integrations/opencode-v2",
        "integrations/pi",
        "integrations/claude",
        ".claude-plugin",
        "integrations/omp",
        "integrations/grok",
        ".grok-plugin"
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "generic",
          "path": ".agents/skills/using-phux/SKILL.md"
        },
        {
          "type": "generic",
          "path": ".agents/skills/using-phux-mcp/SKILL.md"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(!@.source && (@.name.value=='phux' || @.name.value=='phux-agent-host' || @.name.value=='phux-agent-rules' || @.name.value=='phux-agent-session' || @.name.value=='phux-client' || @.name.value=='phux-client-core' || @.name.value=='phux-client-ffi' || @.name.value=='phux-client-runtime' || @.name.value=='phux-config' || @.name.value=='phux-config-core' || @.name.value=='phux-core' || @.name.value=='phux-crash' || @.name.value=='phux-dial' || @.name.value=='phux-frozen' || @.name.value=='phux-git' || @.name.value=='phux-mcp' || @.name.value=='phux-mission' || @.name.value=='phux-perf' || @.name.value=='phux-plugin' || @.name.value=='phux-protocol' || @.name.value=='phux-record' || @.name.value=='phux-relay' || @.name.value=='phux-resource' || @.name.value=='phux-server' || @.name.value=='phux-server-testkit' || @.name.value=='phux-terminal' || @.name.value=='phux-terminal-api' || @.name.value=='phux-tree' || @.name.value=='phux-tui' || @.name.value=='phux-usage' || @.name.value=='phux-work' || @.name.value=='portable-pty-adopt' || @.name.value=='quictun'))].version"
        },
        {
          "type": "toml",
          "path": "clients/phux-web/Cargo.lock",
          "jsonpath": "$.package[?(!@.source && (@.name.value=='phux-client-core' || @.name.value=='phux-perf' || @.name.value=='phux-protocol'))].version"
        },
        {
          "type": "toml",
          "path": "clients/rune/Cargo.lock",
          "jsonpath": "$.package[?(!@.source && (@.name.value=='phux-client-core' || @.name.value=='phux-client-runtime' || @.name.value=='phux-config-core' || @.name.value=='phux-core' || @.name.value=='phux-dial' || @.name.value=='phux-perf' || @.name.value=='phux-protocol' || @.name.value=='quictun'))].version"
        },
        {
          "type": "toml",
          "path": "crates/phux-server/tests/fixtures/host-only-engine/Cargo.lock",
          "jsonpath": "$.package[?(!@.source && (@.name.value=='phux-agent-rules' || @.name.value=='phux-agent-session' || @.name.value=='phux-client-core' || @.name.value=='phux-config' || @.name.value=='phux-config-core' || @.name.value=='phux-core' || @.name.value=='phux-dial' || @.name.value=='phux-git' || @.name.value=='phux-perf' || @.name.value=='phux-plugin' || @.name.value=='phux-protocol' || @.name.value=='phux-resource' || @.name.value=='phux-server' || @.name.value=='phux-terminal-api' || @.name.value=='phux-tree' || @.name.value=='phux-work' || @.name.value=='quictun'))].version"
        },
        {
          "type": "toml",
          "path": "scripts/plugin-index/Cargo.lock",
          "jsonpath": "$.package[?(!@.source && (@.name.value=='phux-config' || @.name.value=='phux-config-core' || @.name.value=='phux-protocol'))].version"
        }
      ]
    },
    "integrations/pi": {
      "release-type": "node",
      "component": "pi-extension",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    },
    "integrations/opencode-v2": {
      "release-type": "node",
      "component": "opencode-plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    },
    "integrations/omp": {
      "release-type": "node",
      "component": "omp-extension",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0"
    },
    "integrations/grok": {
      "release-type": "node",
      "component": "grok-plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md",
      "initial-version": "0.1.0",
      "extra-files": [
        {
          "type": "json",
          "path": ".grok-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/.grok-plugin/marketplace.json",
          "jsonpath": "$.plugins[?(@.name=='phux')].version"
        }
      ]
    },
    "integrations/claude": {
      "release-type": "node",
      "component": "claude-plugin",
      "include-component-in-tag": true,
      "include-v-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/.claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[?(@.name=='phux')].version"
        }
      ]
    }
  }
}
