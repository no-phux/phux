# Incidental install-time audits are off: the advisory endpoints have
# returned 503s mid-lane (2026-09-04, three times in an hour) and an install
# must not fail because a registry service is having a bad day. The EXPLICIT
# `npm audit` gates in the integration packages stay on — they run through
# scripts/npm-audit-gate.mjs, which retries endpoint outages and still fails
# on real advisories.
#
# LIMITATION (why the justfile/release workflow also export npm_config_*):
# npm stops project-config discovery at the nearest package.json, so this
# root .npmrc is never read from inside integrations/* — which is exactly
# where the gates run. The authoritative switch is the environment variable;
# this file only covers ad-hoc npm usage at the repo root.
audit=false
fund=false
