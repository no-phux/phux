# Pick the environment direnv loads. See docs/SETUP.md#choosing-an-environment.
#
# Nix is the default because it is the only environment that provisions every
# gate, client and observability tool. The Mise path is a first-class
# alternative for contributors who want managed compilers over their own system
# packages, and this file must not force a Nix build on someone who chose it:
# `use flake` was unconditional here, so a Mise contributor with direnv paid for
# a dev shell they had already opted out of on every `cd` into the repository.
#
# To choose Mise, create an untracked .envrc.local (already gitignored) with:
#   export PHUX_ENV=mise
#
# Whichever you pick, the two are held to the same tool versions by
# `just toolchain-check` (static, and a `just ci` gate) and `just
# toolchain-parity` (resolves both environments and compares them).
source_env_if_exists .envrc.local

case "${PHUX_ENV:-nix}" in
    nix) use flake ;;
    mise)
        # This is what mise's own `use mise` helper expands to, inlined so
        # that choosing the Mise path costs only the one line in .envrc.local
        # above rather than also requiring `mise direnv activate` first.
        #
        # `eval "$(mise env -s bash)"` also resolves the right tools, but it
        # patches the PATH direnv hands it instead of taking the environment
        # mise constructs. direnv_load is what mise supports, so it is what
        # stays correct when either tool changes its layering.
        watch_file mise.toml
        direnv_load mise exec -- direnv dump
        ;;
    *)
        log_error "phux: unknown PHUX_ENV='${PHUX_ENV}' (expected 'nix' or 'mise'); falling back to nix"
        use flake
        ;;
esac
